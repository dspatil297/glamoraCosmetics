/*
 * New Launches collection template
 * Uses the standard collection layout (shop header + toolbar + product grid)
 */
{
  "sections": {
    "shop_header": {
      "type": "shop-header",
      "settings": {
        "show_background_image": false
      }
    },
    "collection_toolbar": {
      "type": "collection-toolbar",
      "settings": {}
    },
    "collection_product_grid": {
      "type": "collection-product-grid",
      "settings": {
        "products_per_page": 24
      }
    }
  },
  "order": [
    "shop_header",
    "collection_toolbar",
    "collection_product_grid"
  ]
}

