{%- comment -%}
  How to use section (Minimalist)
  Uses blocks for fully editable steps (metafield mapping later).
{%- endcomment -%}

<section class="pdp-how" id="pdp-how-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="pdp-how__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="pdp-how__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <div class="pdp-how__subtitle rte">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    <ol class="pdp-how__steps">
      {%- for block in section.blocks -%}
        <li class="pdp-how__step" {{ block.shopify_attributes }}>
          <div class="pdp-how__step-num">{{ forloop.index }}</div>
          <div class="pdp-how__step-body">
            <div class="pdp-how__step-title">{{ block.settings.title }}</div>
            <div class="pdp-how__step-text">{{ block.settings.text }}</div>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .pdp-how {
    width: 100%;
    max-width: 100%;
    padding: 44px var(--container-padding, 20px);
    background: rgba(0,0,0,0.015);
    box-sizing: border-box;
  }
  .pdp-how__inner { max-width: 1200px; margin: 0 auto; }
  .pdp-how__title { margin: 0 0 10px; font-size: 22px; letter-spacing: -0.01em; }
  .pdp-how__subtitle { margin: 0 0 18px; color: rgba(0,0,0,0.65); font-size: 13px; line-height: 1.6; }

  .pdp-how__steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .pdp-how__step {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 16px;
    padding: 14px;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 12px;
  }
  .pdp-how__step-num {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: rgba(0,0,0,0.06);
    display: grid;
    place-items: center;
    font-weight: 900;
  }
  .pdp-how__step-title { font-weight: 900; margin: 2px 0 6px; }
  .pdp-how__step-text { color: rgba(0,0,0,0.72); font-size: 13px; line-height: 1.45; }

  @media (max-width: 900px) {
    .pdp-how__steps { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP How to use",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "How to use" },
    { "type": "richtext", "id": "subtitle", "label": "Subheading", "default": "<p>Step-by-step placement guide. You can connect metafields later.</p>" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cleanse" },
        { "type": "text", "id": "text", "label": "Text", "default": "Apply on clean, dry skin." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP How to use",
      "blocks": [
        { "type": "step", "settings": { "title": "Cleanse", "text": "Start with a gentle cleanser." } },
        { "type": "step", "settings": { "title": "Treat", "text": "Apply the product evenly as directed." } },
        { "type": "step", "settings": { "title": "Moisturize", "text": "Seal with moisturizer + SPF (AM)." } }
      ]
    }
  ]
}
{% endschema %}

