<script type="application/json" id="bundle-data-{{ section.id }}">
  {
    "items": [
      {%- if v1 -%}{ "id": {{ v1.id }}, "quantity": 1 }{%- endif -%}
      {%- if v2 -%}{%- if v1 -%},{%- endif -%}{ "id": {{ v2.id }}, "quantity": 1 }{%- endif -%}
      {%- if v3 -%}{%- if v1 or v2 -%},{%- endif -%}{ "id": {{ v3.id }}, "quantity": 1 }{%- endif -%}
    ]
  }
</script>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var dataEl = document.getElementById('bundle-data-{{ section.id }}');
    var msgEl = document.getElementById('bundle-msg-{{ section.id }}');
    var useGokwikCheckout = {{ bundle_gokwik_checkout | json }};
    var parsed = { items: [] };
    try {
      parsed = JSON.parse(dataEl.textContent);
    } catch (e) {}

    function setMessage(text, isError) {
      if (!msgEl) return;
      msgEl.textContent = text || '';
      msgEl.classList.toggle('is-error', !!isError);
    }

    function getCheckoutClickFn() {
      if (typeof window.onCheckoutClick === 'function') return window.onCheckoutClick;
      if (typeof onCheckoutClick === 'function') return onCheckoutClick;
      return null;
    }

    function openGokwikAfterCartAdd(triggerBtn) {
      var fn = getCheckoutClickFn();
      if (fn) {
        try {
          fn.call(window, triggerBtn);
          return;
        } catch (e) {}
      }
      var attempts = 0;
      var maxAttempts = 50;
      var t = setInterval(function () {
        fn = getCheckoutClickFn();
        if (fn) {
          clearInterval(t);
          try {
            fn.call(window, triggerBtn);
          } catch (e) {
            window.location.href = '/checkout';
          }
        } else if (++attempts >= maxAttempts) {
          clearInterval(t);
          window.location.href = '/checkout';
        }
      }, 100);
    }

    root.querySelectorAll('.js-bundle-add[data-bundle-action="buy"]').forEach(function (btn) {
      if (btn.dataset.bundleGokwik === '1' && !btn.dataset.bundleBuynowHtml) {
        btn.dataset.bundleBuynowHtml = btn.innerHTML;
      }
    });

    function resetButtons(buttons) {
      buttons.forEach(function (btn) {
        btn.disabled = false;
        btn.classList.remove('is-loading');
        if (btn.dataset.bundleAction === 'buy') {
          if (btn.dataset.bundleBuynowHtml) {
            btn.innerHTML = btn.dataset.bundleBuynowHtml;
          } else {
            btn.textContent = {{ section.settings.buy_now_label | json }};
          }
        } else {
          btn.innerHTML = {{ section.settings.add_to_cart_label | json }} + '<span class="btn-arrow" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>';
        }
      });
    }

    function addBundle(action, triggerBtn) {
      var items = (parsed.items || []).filter(function (i) { return i && i.id; });
      if (!items.length) {
        setMessage('Select three products with available variants in the theme editor.', true);
        return;
      }
      var buttons = root.querySelectorAll('.js-bundle-add');
      buttons.forEach(function (b) { b.disabled = true; });
      if (triggerBtn) {
        if (action === 'buy') {
          if (triggerBtn.dataset.bundleGokwik === '1') {
            triggerBtn.classList.add('is-loading');
          } else {
            triggerBtn.textContent = 'Processing…';
          }
        } else {
          triggerBtn.textContent = 'Adding…';
        }
      }

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
        .then(function (result) {
          if (!result.ok) {
            var desc = (result.body && (result.body.description || result.body.message)) || 'Could not add bundle.';
            throw new Error(desc);
          }
          if (action === 'buy') {
            if (useGokwikCheckout) {
              openGokwikAfterCartAdd(triggerBtn);
            } else {
              window.location.href = '/checkout';
            }
            return;
          }
          setMessage('All products added to your cart.', false);
          if (triggerBtn) triggerBtn.textContent = 'Added ✓';
          setTimeout(function () {
            resetButtons(Array.prototype.slice.call(buttons));
            setMessage('', false);
          }, 2800);
        })
        .catch(function (err) {
          resetButtons(Array.prototype.slice.call(buttons));
          setMessage(err.message || 'Something went wrong.', true);
        });
    }

    root.querySelectorAll('.js-bundle-add').forEach(function (btn) {
      btn.addEventListener('click', function () {
        addBundle(btn.getAttribute('data-bundle-action'), btn);
      });
    });

    var obs = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );
    root.querySelectorAll('.reveal').forEach(function (el) {
      obs.observe(el);
    });
  })();
</script>

