{% comment %}
  Full bundle landing layout matching glamora-website/bundle-page.html (hero, what's inside, why, timeline, bottom CTA).
  Three products via pickers. Add to cart uses /cart/add.js. Buy now (when theme Gokwik "Enable Checkout Button" is on)
  adds the same items then calls onCheckoutClick (same flow as gokwik-checkout snippet); otherwise redirects to /checkout.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&display=swap" media="all">

{%- liquid
  assign p1 = section.settings.product_1
  assign p2 = section.settings.product_2
  assign p3 = section.settings.product_3
  assign v1 = nil
  assign v2 = nil
  assign v3 = nil
  if p1 != blank
    assign v1 = p1.selected_or_first_available_variant
  endif
  if p2 != blank
    assign v2 = p2.selected_or_first_available_variant
  endif
  if p3 != blank
    assign v3 = p3.selected_or_first_available_variant
  endif

  assign sum_price = 0
  assign sum_compare = 0
  if p1 != blank and v1
    assign sum_price = sum_price | plus: v1.price
    if v1.compare_at_price and v1.compare_at_price > v1.price
      assign sum_compare = sum_compare | plus: v1.compare_at_price
    else
      assign sum_compare = sum_compare | plus: v1.price
    endif
  endif
  if p2 != blank and v2
    assign sum_price = sum_price | plus: v2.price
    if v2.compare_at_price and v2.compare_at_price > v2.price
      assign sum_compare = sum_compare | plus: v2.compare_at_price
    else
      assign sum_compare = sum_compare | plus: v2.price
    endif
  endif
  if p3 != blank and v3
    assign sum_price = sum_price | plus: v3.price
    if v3.compare_at_price and v3.compare_at_price > v3.price
      assign sum_compare = sum_compare | plus: v3.compare_at_price
    else
      assign sum_compare = sum_compare | plus: v3.price
    endif
  endif

  assign savings_cents = sum_compare | minus: sum_price
  if savings_cents < 0
    assign savings_cents = 0
  endif

  assign bundle_display_price_text = section.settings.bundle_display_price | strip
  assign bundle_display_mrp_text = section.settings.bundle_display_mrp | strip
  assign bundle_display_save_text = section.settings.bundle_display_save | strip
  assign bundle_show_mrp = false
  if bundle_display_mrp_text != blank
    assign bundle_show_mrp = true
  elsif sum_compare > sum_price
    assign bundle_show_mrp = true
  endif

  assign bundle_gokwik_checkout = false
  if settings.goEnable
    assign bundle_gokwik_checkout = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --bp-bg: #FAFAF7;
    --bp-bg-alt: #F3F1ED;
    --bp-bg-dark: #141413;
    --bp-text: #141413;
    --bp-text-2: #5C5B57;
    --bp-text-3: #8A8985;
    --bp-teal: #0D8B7D;
    --bp-teal-muted: #1A9E8F;
    --bp-teal-bg: #EBF5F3;
    --bp-teal-dark: #0A6E63;
    /* Theme primary from :root when set; else bundle teal */
    --bundle-accent: var(--primary-cta, var(--bp-teal));
    --bp-gold: #C5A44E;
    --bp-gold-muted: #D4B96A;
    --bp-border: #E8E6E1;
    --bp-border-light: #F0EDE8;
    --bp-font-body: 'Outfit', -apple-system, sans-serif;
    --bp-font-display: 'Fraunces', Georgia, serif;
    --bp-ease: cubic-bezier(0.32, 0.72, 0, 1);
    --bp-container: 1360px;
  }

  #shopify-section-{{ section.id }} .bundle-page-wrap {
    font-family: var(--bp-font-body);
    color: var(--bp-text);
    background: var(--bp-bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .bundle-page-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: 0.028;
  }

  #shopify-section-{{ section.id }} .bundle-page-wrap > * { position: relative; z-index: 2; }

  #shopify-section-{{ section.id }} img { max-width: 100%; height: auto; display: block; }
  #shopify-section-{{ section.id }} button { font-family: inherit; cursor: pointer; border: none; background: none; }

  #shopify-section-{{ section.id }} .bp-container {
    max-width: var(--bp-container);
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }

  /* === BUNDLE HERO === */
  #shopify-section-{{ section.id }} .bundle-hero {
    padding: clamp(60px, 8vw, 120px) 0 clamp(80px, 10vw, 140px);
  }
  #shopify-section-{{ section.id }} .bundle-hero-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  #shopify-section-{{ section.id }} .bundle-hero-images {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(14px, 2.2vw, 28px);
    padding: clamp(32px, 5vw, 56px) clamp(16px, 3vw, 28px) clamp(28px, 4vw, 48px);
    min-height: clamp(220px, 32vw, 340px);
  }
  #shopify-section-{{ section.id }} .bundle-hero-bg {
    position: absolute;
    width: 90%;
    height: 90%;
    background: linear-gradient(160deg, rgba(13,139,125,0.07), rgba(13,139,125,0.02));
    border: 1px solid rgba(13,139,125,0.05);
    border-radius: 2.5rem;
    transform: rotate(2deg);
    top: 5%;
    left: 5%;
  }
  #shopify-section-{{ section.id }} .bundle-prod {
    position: relative;
    z-index: 2;
    width: auto;
    height: clamp(168px, 24vw, 280px);
    max-width: clamp(130px, 17vw, 200px);
    border-radius: 12px;
    filter: drop-shadow(0 20px 40px rgba(13,139,125,0.1));
    transition: transform 0.6s var(--bp-ease);
    object-fit: contain;
    object-position: center bottom;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .bundle-prod:nth-child(3) {
    height: clamp(200px, 30vw, 340px);
    max-width: clamp(150px, 20vw, 240px);
    animation: bp-bundleFloat 5s ease-in-out infinite;
  }
  #shopify-section-{{ section.id }} .bundle-prod:hover { transform: translateY(-8px); }
  @keyframes bp-bundleFloat {
    0%, 100% { transform: translateY(-12px); }
    50% { transform: translateY(-24px); }
  }

  #shopify-section-{{ section.id }} .bundle-hero-content { max-width: 560px; }
  #shopify-section-{{ section.id }} .eyebrow {
    display: inline-block;
    padding: 7px 18px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(197, 164, 78, 0.1);
    color: var(--bp-gold);
  }
  #shopify-section-{{ section.id }} .bundle-hero-content h1 {
    font-family: var(--bp-font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--bp-text);
    margin-bottom: 20px;
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .bundle-hero-content .tagline {
    font-family: var(--bp-font-display);
    font-style: italic;
    font-size: clamp(18px, 2vw, 22px);
    color: var(--bp-text-2);
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .bundle-hero-content .desc {
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.75;
    color: var(--bp-text-2);
    font-weight: 300;
    margin-bottom: 32px;
    max-width: 50ch;
  }

  #shopify-section-{{ section.id }} .bundle-pricing {
    padding: 28px 32px;
    background: var(--bp-bg-alt);
    border: 1px solid var(--bp-border-light);
    border-radius: 1.25rem;
    margin-bottom: 28px;
  }
  #shopify-section-{{ section.id }} .bundle-pricing-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 6px;
    justify-content: flex-start;
  }
  #shopify-section-{{ section.id }} .bundle-price {
    font-family: var(--bp-font-display);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 700;
    color: var(--bp-text);
    letter-spacing: -0.03em;
  }
  #shopify-section-{{ section.id }} .bundle-mrp {
    font-size: 18px;
    color: var(--bp-text-3);
    text-decoration: line-through;
    font-weight: 300;
  }
  #shopify-section-{{ section.id }} .bundle-discount {
    font-size: 13px;
    font-weight: 600;
    color: var(--bp-teal);
    background: var(--bp-teal-bg);
    padding: 4px 14px;
    border-radius: 100px;
  }
  #shopify-section-{{ section.id }} .bundle-save {
    font-size: 14px;
    color: var(--bp-text-2);
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 36px;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: all 0.5s var(--bp-ease);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .btn:active { transform: scale(0.97); }
  #shopify-section-{{ section.id }} .btn--primary {
    background: transparent;
    color: var(--bundle-accent);
    border: 2px solid var(--bundle-accent);
    box-shadow: none;
  }
  #shopify-section-{{ section.id }} .btn--primary:hover:not(:disabled) {
    background: var(--bp-teal-bg);
    color: var(--bundle-accent);
    border-color: var(--bundle-accent);
  }
  #shopify-section-{{ section.id }} .btn--primary:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }
  #shopify-section-{{ section.id }} .btn--primary .btn-arrow {
    width: 30px;
    height: 30px;
    background: transparent;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: inherit;
    transition: transform 0.4s var(--bp-ease), background 0.4s var(--bp-ease), border-color 0.4s var(--bp-ease);
  }
  #shopify-section-{{ section.id }} .btn--primary:hover:not(:disabled) .btn-arrow {
    transform: translateX(3px);
    background: rgba(13, 139, 125, 0.08);
  }

  #shopify-section-{{ section.id }} .btn--ghost {
    background: transparent;
    color: var(--bundle-accent);
    border: 2px solid var(--bundle-accent);
  }
  #shopify-section-{{ section.id }} .btn--ghost:hover:not(:disabled) {
    background: var(--bp-teal-bg);
  }
  #shopify-section-{{ section.id }} .btn--ghost:disabled { opacity: 0.65; cursor: not-allowed; }

  #shopify-section-{{ section.id }} .bundle-hero-buttons {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .bundle-hero-buttons .btn { width: 100%; }
  #shopify-section-{{ section.id }} .bundle-hero-buttons .bundle-gokwik-buynow { width: 100%; }

  /* Buy now: solid theme accent (not Gokwik black); layout still matches Gokwik button structure */
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow {
    width: 100%;
    max-width: 100%;
    border: 2px solid var(--bundle-accent);
    border-radius: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    position: relative;
    cursor: pointer;
    padding: 15px 20px;
    min-height: 52px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    transition: background 0.25s var(--bp-ease), border-color 0.25s var(--bp-ease), opacity 0.2s ease, transform 0.2s ease;
    background: var(--bundle-accent);
    color: #fff;
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow:hover:not(:disabled) {
    opacity: 1;
    filter: brightness(0.94);
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow .btn-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow .btn-text > span:first-child {
    font-size: 15px;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow .bundle-gokwik-buynow__sub {
    padding-top: 2px;
    font-size: 10px;
    line-height: 12px;
    font-weight: 500;
    text-transform: none;
    color: rgba(255, 255, 255, 0.88);
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow .pay-opt-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow .pay-opt-icon img:first-child {
    margin: 0 10px;
    height: 18px;
    width: auto;
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow .pay-opt-icon img:last-child {
    height: 15px;
    width: auto;
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow .bundle-gokwik-loader {
    display: none;
    position: absolute;
    inset: 0;
    justify-content: center;
    align-items: center;
    border-radius: 100px;
    background: var(--bundle-accent);
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow.is-loading .bundle-gokwik-loader {
    display: flex;
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow--cta {
    padding: 20px 44px;
    font-size: 16px;
    min-height: 56px;
  }
  #shopify-section-{{ section.id }} .bundle-gokwik-buynow--cta .btn-text > span:first-child {
    font-size: 16px;
  }

  /* === WHAT'S INSIDE === */
  #shopify-section-{{ section.id }} .inside-section {
    padding: clamp(80px, 10vw, 140px) 0;
    background: var(--bp-bg-alt);
  }
  #shopify-section-{{ section.id }} .inside-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto clamp(48px, 6vw, 80px);
  }
  #shopify-section-{{ section.id }} .inside-header h2 {
    font-family: var(--bp-font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--bp-text);
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .inside-header p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--bp-text-2);
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .inside-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .inside-shell {
    background: rgba(0,0,0,0.015);
    border: 1px solid var(--bp-border-light);
    padding: 6px;
    border-radius: 1.75rem;
    transition: border-color 0.5s var(--bp-ease);
  }
  #shopify-section-{{ section.id }} .inside-shell:hover { border-color: var(--bp-border); }
  #shopify-section-{{ section.id }} .inside-core {
    background: var(--bp-bg);
    border-radius: calc(1.75rem - 6px);
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
  }
  #shopify-section-{{ section.id }} .inside-img {
    aspect-ratio: 3 / 4;
    background: var(--bp-bg-alt);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .inside-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--bp-ease);
  }
  #shopify-section-{{ section.id }} .inside-shell:hover .inside-img img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .inside-body { padding: 20px 20px 24px; }
  #shopify-section-{{ section.id }} .inside-step-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bp-teal);
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .inside-step-num {
    width: 20px;
    height: 20px;
    background: var(--bp-teal);
    color: #fff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 10px;
  }
  #shopify-section-{{ section.id }} .inside-name {
    font-family: var(--bp-font-display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--bp-text);
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .inside-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--bp-text-2);
    font-weight: 300;
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .inside-price {
    font-size: 16px;
    font-weight: 600;
    color: var(--bp-text-3);
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .inside-connector {
    text-align: center;
    padding: 40px 0 0;
  }
  #shopify-section-{{ section.id }} .inside-connector p {
    font-family: var(--bp-font-display);
    font-style: italic;
    font-size: clamp(18px, 2.2vw, 24px);
    color: var(--bp-text-2);
  }

  /* === WHY === */
  #shopify-section-{{ section.id }} .why-section {
    padding: clamp(80px, 10vw, 140px) 0;
    background: var(--bp-bg);
  }
  #shopify-section-{{ section.id }} .why-header {
    max-width: 560px;
    margin-bottom: clamp(48px, 6vw, 72px);
  }
  #shopify-section-{{ section.id }} .why-header h2 {
    font-family: var(--bp-font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--bp-text);
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .why-header p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--bp-text-2);
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .why-card {
    padding: clamp(28px, 3.5vw, 40px);
    border-radius: 1.25rem;
    border: 1px solid var(--bp-border-light);
    background: var(--bp-bg);
    transition: border-color 0.4s var(--bp-ease), box-shadow 0.4s var(--bp-ease);
  }
  #shopify-section-{{ section.id }} .why-card:hover {
    border-color: var(--bp-border);
    box-shadow: 0 8px 32px -8px rgba(0,0,0,0.06);
  }
  #shopify-section-{{ section.id }} .why-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--bp-teal-bg);
    color: var(--bp-teal);
    display: grid;
    place-items: center;
    margin-bottom: 20px;
  }
  #shopify-section-{{ section.id }} .why-card h4 {
    font-size: 17px;
    font-weight: 600;
    color: var(--bp-text);
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .why-card p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--bp-text-2);
    font-weight: 300;
  }

  /* === TIMELINE === */
  #shopify-section-{{ section.id }} .timeline-section {
    padding: clamp(80px, 10vw, 140px) 0;
    background: var(--bp-bg-dark);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .timeline-section::before {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(13,139,125,0.1) 0%, transparent 70%);
    top: -150px;
    left: -100px;
    border-radius: 50%;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .timeline-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto clamp(48px, 6vw, 80px);
  }
  #shopify-section-{{ section.id }} .timeline-header h2 {
    font-family: var(--bp-font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: 16px;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .timeline-header p {
    font-size: 17px;
    line-height: 1.7;
    color: rgba(255,255,255,0.5);
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .timeline { max-width: 640px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .timeline-step {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 24px;
    padding-bottom: 40px;
    position: relative;
  }
  #shopify-section-{{ section.id }} .timeline-step:last-child { padding-bottom: 0; }
  #shopify-section-{{ section.id }} .timeline-step::before {
    content: '';
    position: absolute;
    left: 40px;
    top: 56px;
    bottom: 0;
    width: 1px;
    background: rgba(255,255,255,0.08);
  }
  #shopify-section-{{ section.id }} .timeline-step:last-child::before { display: none; }
  #shopify-section-{{ section.id }} .timeline-time {
    font-size: 14px;
    font-weight: 600;
    color: var(--bp-gold);
    padding-top: 14px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .timeline-content {
    padding: 24px 28px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 1rem;
  }
  #shopify-section-{{ section.id }} .timeline-content h4 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .timeline-content p {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255,255,255,0.5);
    font-weight: 300;
  }

  /* === BOTTOM CTA === */
  #shopify-section-{{ section.id }} .bottom-cta {
    padding: clamp(80px, 10vw, 140px) 0;
    text-align: center;
    background: var(--bp-bg);
  }
  #shopify-section-{{ section.id }} .bottom-cta-inner { max-width: 600px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .bottom-cta h2 {
    font-family: var(--bp-font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--bp-text);
    margin-bottom: 20px;
  }
  #shopify-section-{{ section.id }} .bottom-cta-sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--bp-text-2);
    font-weight: 300;
  }
  #shopify-section-{{ section.id }} .price-block { margin: 24px 0 32px; }
  #shopify-section-{{ section.id }} .big-price {
    font-family: var(--bp-font-display);
    font-size: clamp(40px, 5vw, 60px);
    font-weight: 700;
    color: var(--bp-text);
    letter-spacing: -0.03em;
  }
  #shopify-section-{{ section.id }} .big-mrp {
    font-size: 20px;
    color: var(--bp-text-3);
    text-decoration: line-through;
    font-weight: 300;
    margin-left: 12px;
  }

  #shopify-section-{{ section.id }} .bottom-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .bottom-cta-buttons .bundle-gokwik-buynow {
    flex: 1 1 220px;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .bottom-note {
    margin-top: 16px;
    font-size: 13px;
    color: var(--bp-text-3);
  }

  /* === REVEAL === */
  #shopify-section-{{ section.id }} .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.9s var(--bp-ease), transform 0.9s var(--bp-ease);
  }
  #shopify-section-{{ section.id }} .reveal.visible { opacity: 1; transform: translateY(0); }
  #shopify-section-{{ section.id }} .reveal-d1 { transition-delay: 0.1s; }
  #shopify-section-{{ section.id }} .reveal-d2 { transition-delay: 0.2s; }
  #shopify-section-{{ section.id }} .reveal-d3 { transition-delay: 0.3s; }

  #shopify-section-{{ section.id }} .bundle-page-message {
    margin-top: 14px;
    font-size: 14px;
    color: var(--bp-text-2);
    min-height: 1.25em;
  }
  #shopify-section-{{ section.id }} .bundle-page-message.is-error { color: #D64545; }

  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .bundle-hero-buttons {
      flex-direction: row;
      flex-wrap: wrap;
    }
    #shopify-section-{{ section.id }} .bundle-hero-buttons .btn {
      flex: 1;
      min-width: 200px;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-hero-grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .bundle-hero-images {
      order: -1;
      padding: 24px 12px 32px;
      min-height: clamp(200px, 55vw, 280px);
    }
    #shopify-section-{{ section.id }} .bundle-prod {
      height: clamp(150px, 42vw, 240px);
      max-width: clamp(100px, 28vw, 160px);
    }
    #shopify-section-{{ section.id }} .bundle-prod:nth-child(3) {
      height: clamp(175px, 48vw, 280px);
      max-width: clamp(115px, 32vw, 190px);
    }
    #shopify-section-{{ section.id }} .bundle-hero-content { max-width: 100%; text-align: center; }
    #shopify-section-{{ section.id }} .bundle-hero-content .desc {
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }
    #shopify-section-{{ section.id }} .bundle-pricing { text-align: center; }
    #shopify-section-{{ section.id }} .bundle-pricing-row { justify-content: center; }
    #shopify-section-{{ section.id }} .inside-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .why-grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .timeline-step { grid-template-columns: 60px 1fr; gap: 16px; }
    #shopify-section-{{ section.id }} .timeline-step::before { left: 30px; }
  }
</style>

<div class="bundle-page-wrap">
  <section class="bundle-hero">
    <div class="bp-container">
      <div class="bundle-hero-grid">
        <div class="bundle-hero-images reveal">
          <div class="bundle-hero-bg" aria-hidden="true"></div>
          {% if p1 != blank and p1.featured_image %}
            <img
              src="{{ p1.featured_image | image_url: width: 700 }}"
              alt="{{ p1.featured_image.alt | default: p1.title | escape }}"
              class="bundle-prod"
              width="600"
              height="800"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            >
          {% endif %}
          {% if p2 != blank and p2.featured_image %}
            <img
              src="{{ p2.featured_image | image_url: width: 840 }}"
              alt="{{ p2.featured_image.alt | default: p2.title | escape }}"
              class="bundle-prod"
              width="600"
              height="800"
              loading="lazy"
              decoding="async"
            >
          {% endif %}
          {% if p3 != blank and p3.featured_image %}
            <img
              src="{{ p3.featured_image | image_url: width: 700 }}"
              alt="{{ p3.featured_image.alt | default: p3.title | escape }}"
              class="bundle-prod"
              width="600"
              height="800"
              loading="lazy"
              decoding="async"
            >
          {% endif %}
        </div>
        <div class="bundle-hero-content reveal" style="transition-delay:0.15s">
          {% if section.settings.hero_eyebrow != blank %}
            <span class="eyebrow">{{ section.settings.hero_eyebrow }}</span>
          {% endif %}
          <h1>{{ section.settings.hero_title | default: 'The Pollution Defense Kit' }}</h1>
          {% if section.settings.hero_tagline != blank %}
            <p class="tagline">{{ section.settings.hero_tagline }}</p>
          {% endif %}
          {% if section.settings.hero_description != blank %}
            <p class="desc">{{ section.settings.hero_description }}</p>
          {% endif %}

          <div class="bundle-pricing">
            <div class="bundle-pricing-row">
              <span class="bundle-price">
                {%- if bundle_display_price_text != blank -%}
                  {{- bundle_display_price_text -}}
                {%- else -%}
                  {{- sum_price | money -}}
                {%- endif -%}
              </span>
              {% if bundle_show_mrp %}
                <span class="bundle-mrp">
                  {%- if bundle_display_mrp_text != blank -%}
                    {{- bundle_display_mrp_text -}}
                  {%- else -%}
                    {{- sum_compare | money -}}
                  {%- endif -%}
                </span>
              {% endif %}
              {% if bundle_display_save_text != blank %}
                <span class="bundle-discount">{{ bundle_display_save_text }}</span>
              {% elsif savings_cents > 0 %}
                <span class="bundle-discount">Save {{ savings_cents | money }}</span>
              {% elsif section.settings.discount_badge_override != blank %}
                <span class="bundle-discount">{{ section.settings.discount_badge_override }}</span>
              {% endif %}
            </div>
            {% if section.settings.pricing_note != blank %}
              <p class="bundle-save">{{ section.settings.pricing_note }}</p>
            {% endif %}
          </div>

          <div class="bundle-hero-buttons">
            <button type="button" class="btn btn--primary js-bundle-add" data-bundle-action="add" {% unless v1 and v2 and v3 %}disabled{% endunless %}>
              {{ section.settings.add_to_cart_label }}
              <span class="btn-arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </button>
            {% if bundle_gokwik_checkout %}
              <button
                type="button"
                class="bundle-gokwik-buynow js-bundle-add"
                data-bundle-action="buy"
                data-bundle-gokwik="1"
                {% unless v1 and v2 and v3 %}disabled{% endunless %}
              >
                <span class="btn-text">
                  <span>{{ section.settings.buy_now_label }}</span>
                  {% if settings.sub-titile != blank %}
                    <span class="bundle-gokwik-buynow__sub">{{ settings.sub-titile }}</span>
                  {% endif %}
                </span>
                {% if settings.enableLogo %}
                  <span class="pay-opt-icon">
                    <img src="https://cdn.gokwik.co/v4/images/upi-icons.svg" alt="" width="72" height="18" loading="lazy">
                    <img src="https://cdn.gokwik.co/v4/images/right-arrow.svg" alt="" width="15" height="15" loading="lazy">
                  </span>
                {% endif %}
                <div class="addloadr bundle-gokwik-loader" aria-hidden="true">
                  <div class="cir-loader">Loading..</div>
                </div>
              </button>
            {% else %}
              <button type="button" class="btn btn--ghost js-bundle-add" data-bundle-action="buy" {% unless v1 and v2 and v3 %}disabled{% endunless %}>
                {{ section.settings.buy_now_label }}
