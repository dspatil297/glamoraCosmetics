{%- comment -%}
  Image tiles grid (used for "Shop by Category" and "Shop by Concerns")
{%- endcomment -%}

<section class="tiles-grid" id="tiles-grid-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <div class="tiles-grid__header">
      <h2 class="tiles-grid__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

  <div class="tiles-grid__wrap tiles-grid__wrap--{{ section.settings.layout }}">
    {%- if section.settings.layout == 'carousel' -%}
    <div class="tiles-grid__carousel-outer">
      <button type="button" class="tiles-grid__arrow tiles-grid__arrow--prev" aria-label="Previous" data-tiles-prev>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <div class="tiles-grid__carousel" data-tiles-scroll tabindex="0">
        <div class="tiles-grid__track">
    {%- endif -%}
    <div class="tiles-grid__grid" style="--tiles-cols: {{ section.settings.columns }};">
      {%- if section.settings.source == 'category_auto' or section.settings.source == 'concern_auto' -%}
        {%- comment -%}
          Auto mode:
          - "category_auto": use all collections whose title starts with "Category:"
          - "concern_auto":  use all collections whose title starts with "Concern:"
          The label is the collection title with the prefix removed.
        {%- endcomment -%}
        {%- assign auto_tiles_count = 0 -%}
        {%- for collection in collections -%}
          {%- if collection.products_count == 0 or collection.products_count == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign raw_title = collection.title | default: '' -%}
          {%- assign title_down = raw_title | downcase -%}
          {%- assign label = '' -%}

          {%- if section.settings.source == 'category_auto' and title_down contains 'category:' -%}
            {%- assign label = raw_title | split: ':' | last | strip -%}
          {%- elsif section.settings.source == 'concern_auto' and title_down contains 'concern:' -%}
            {%- assign label = raw_title | split: ':' | last | strip -%}
          {%- else -%}
            {%- continue -%}
          {%- endif -%}

          {%- assign auto_tiles_count = auto_tiles_count | plus: 1 -%}

          <div class="tiles-grid__item">
            <a class="tiles-grid__link" href="{{ collection.url }}">
              {%- if collection.image != blank -%}
                <div class="tiles-grid__media">
                  <img
                    src="{{ collection.image | image_url: width: 600 }}"
                    srcset="
                      {{ collection.image | image_url: width: 300 }} 300w,
                      {{ collection.image | image_url: width: 450 }} 450w,
                      {{ collection.image | image_url: width: 600 }} 600w
                    "
                    sizes="(min-width: 990px) 220px, (min-width: 750px) 180px, 44vw"
                    alt="{{ label | escape }}"
                    width="450"
                    height="450"
                    decoding="async"
                    loading="lazy"
                    class="tiles-grid__img"
                  >
                </div>
              {%- else -%}
                <div class="tiles-grid__media tiles-grid__media--placeholder">
                  {% render 'unsplash-placeholder', type: 'tile', width: 600, class: 'tiles-grid__img', loading: 'lazy', alt: label | default: 'Collection' %}
                </div>
              {%- endif -%}
              <div class="tiles-grid__label">{{ label }}</div>
            </a>
          </div>
        {%- endfor -%}

        {%- if section.settings.layout == 'carousel' and auto_tiles_count < 3 -%}
          <div class="tiles-grid__item tiles-grid__item--placeholder">
            <div class="tiles-grid__media tiles-grid__media--placeholder">
              <div class="tiles-grid__more-text">More coming soon</div>
              <div class="tiles-grid__more-sub">New drops are on the way</div>
            </div>
          </div>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Manual mode: use tiles defined as blocks {%- endcomment -%}
        {%- assign manual_tiles = section.blocks | where: 'type', 'tile' -%}
        {%- for block in manual_tiles -%}
          {%- assign href = block.settings.href -%}
          <div class="tiles-grid__item" {{ block.shopify_attributes }}>
            {%- if href != blank -%}<a class="tiles-grid__link" href="{{ href }}">{%- endif -%}
              {%- if block.settings.image != blank -%}
                <div class="tiles-grid__media">
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 300 }} 300w,
                      {{ block.settings.image | image_url: width: 450 }} 450w,
                      {{ block.settings.image | image_url: width: 600 }} 600w
                    "
                    sizes="(min-width: 990px) 220px, (min-width: 750px) 180px, 44vw"
                    alt="{{ block.settings.label | escape }}"
                    width="450"
                    height="450"
                    decoding="async"
                    loading="lazy"
                    class="tiles-grid__img"
                  >
                </div>
              {%- else -%}
                <div class="tiles-grid__media tiles-grid__media--placeholder">
                  {% render 'unsplash-placeholder', type: 'tile', width: 600, class: 'tiles-grid__img', loading: 'lazy', alt: block.settings.label | default: 'Category' %}
                </div>
              {%- endif -%}
              <div class="tiles-grid__label">{{ block.settings.label }}</div>
            {%- if href != blank -%}</a>{%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.settings.layout == 'carousel' and manual_tiles.size < 3 -%}
          <div class="tiles-grid__item tiles-grid__item--placeholder">
            <div class="tiles-grid__media tiles-grid__media--placeholder">
              <div class="tiles-grid__more-text">More coming soon</div>
              <div class="tiles-grid__more-sub">New drops are on the way</div>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if section.settings.layout == 'carousel' -%}
        </div>
      </div>
      <button type="button" class="tiles-grid__arrow tiles-grid__arrow--next" aria-label="Next" data-tiles-next>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.layout == 'carousel' -%}
<script>
  (function() {
    var wrap = document.getElementById('tiles-grid-{{ section.id }}');
    if (!wrap) return;
    var scrollEl = wrap.querySelector('[data-tiles-scroll]');
    var track = wrap.querySelector('.tiles-grid__track');
    var prevBtn = wrap.querySelector('[data-tiles-prev]');
    var nextBtn = wrap.querySelector('[data-tiles-next]');
    if (!scrollEl || !track || !prevBtn || !nextBtn) return;
    var step = function(direction) {
      var amount = scrollEl.clientWidth * 0.8;
      scrollEl.scrollBy({ left: direction * amount, behavior: 'smooth' });
    };
    prevBtn.addEventListener('click', function() { step(-1); });
    nextBtn.addEventListener('click', function() { step(1); });
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .tiles-grid {
    max-width: 1400px;
    margin: 0 auto;
    padding: 64px var(--container-padding);
    box-sizing: border-box;
  }

  .tiles-grid__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .tiles-grid__title {
    margin: 0;
    font-size: 26px;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .tiles-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--tiles-cols, 5), minmax(0, 1fr));
    gap: 18px;
  }

  /* Carousel layout */
  .tiles-grid__wrap--carousel .tiles-grid__grid {
    display: flex;
    grid-template-columns: unset;
    gap: 18px;
    flex-wrap: nowrap;
  }

  /* Exactly 5 tiles visible in the carousel viewport (gap 18px between) */
  .tiles-grid__wrap--carousel .tiles-grid__item {
    flex: 0 0 auto;
    width: calc((100cqw - 72px) / 5);
    min-width: calc((100cqw - 72px) / 5);
  }

  @container tiles-carousel (max-width: 600px) {
    .tiles-grid__wrap--carousel .tiles-grid__item {
      width: calc((100cqw - 18px) / 2);
      min-width: calc((100cqw - 18px) / 2);
    }
  }

  .tiles-grid__carousel-outer {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tiles-grid__carousel {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 0;
    container-type: inline-size;
    container-name: tiles-carousel;
  }

  .tiles-grid__carousel::-webkit-scrollbar {
    display: none;
  }

  .tiles-grid__track {
    display: flex;
    gap: 18px;
    padding: 0 8px;
    min-width: min-content;
  }

  .tiles-grid__wrap--carousel .tiles-grid__track .tiles-grid__grid {
    display: contents;
  }

  .tiles-grid__wrap--carousel .tiles-grid__item {
    scroll-snap-align: start;
  }

  .tiles-grid__arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(0,0,0,0.06);
    color: var(--text, #1a1a1a);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
  }

  .tiles-grid__arrow:hover {
    background: rgba(0,0,0,0.12);
  }

  .tiles-grid__arrow:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .tiles-grid__arrow svg {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 768px) {
    .tiles-grid__arrow {
      width: 38px;
      height: 38px;
    }
    .tiles-grid__arrow svg {
      width: 20px;
      height: 20px;
    }
  }

  .tiles-grid__item {
    text-align: center;
  }

  .tiles-grid__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .tiles-grid__media {
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(0,0,0,0.03);
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
  }

  .tiles-grid__media--placeholder {
    background: rgba(0,0,0,0.04);
  }

  .tiles-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 260ms ease;
  }

  .tiles-grid__link:hover .tiles-grid__img {
    transform: scale(1.03);
  }

  .tiles-grid__label {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .tiles-grid__item--placeholder .tiles-grid__media {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: radial-gradient(circle at top left, rgba(74, 124, 44, 0.16), transparent 55%),
                radial-gradient(circle at bottom right, rgba(235, 191, 120, 0.22), transparent 55%),
                rgba(0, 0, 0, 0.02);
    border: 1px dashed rgba(0, 0, 0, 0.08);
  }

  .tiles-grid__more-text {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted, #6b7280);
  }

  .tiles-grid__more-sub {
    font-size: 14px;
    color: rgba(55, 65, 81, 0.9);
    opacity: 0.85;
  }

  @media (max-width: 990px) {
    .tiles-grid {
      padding: 48px var(--container-padding);
    }
    .tiles-grid__wrap--grid .tiles-grid__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
  }

  @media (max-width: 520px) {
    .tiles-grid__wrap--grid .tiles-grid__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tiles grid",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by Category" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Tile source",
      "options": [
        { "value": "manual", "label": "Manual tiles (use blocks below)" },
        { "value": "category_auto", "label": "Collections starting with \"Category:\"" },
        { "value": "concern_auto", "label": "Collections starting with \"Concern:\"" }
      ],
      "default": "manual"
    },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 6, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Skin" },
        { "type": "url", "id": "href", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tiles grid"
    }
  ]
}
{% endschema %}

