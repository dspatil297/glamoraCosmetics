{% comment %}
  Product FAQ Accordion Section
  Displays global questions with product-specific answers
{% endcomment %}

{% liquid
  assign questions_meta = shop.metafields.custom.product_faq_question
  assign answers_meta = product.metafields.custom.product_faq

  assign question_lines = blank
  assign answer_lines = blank
  assign questions_text = ''
  assign answers_text = ''

  if questions_meta != blank
    if questions_meta.type contains 'list.'
      assign question_lines = questions_meta.value
    else
      assign questions_text = questions_meta | metafield_text | strip
      if questions_text != blank
        assign question_lines = questions_text | newline_to_br | split: '<br />'
      endif
    endif
  endif

  if answers_meta != blank
    if answers_meta.type contains 'list.'
      assign answer_lines = answers_meta.value
    else
      assign answers_text = answers_meta | metafield_text | default: answers_meta | strip
      if answers_text != blank
        assign answer_lines_raw = answers_text | newline_to_br | split: '<br />'
        assign answer_lines_string = ''
        for raw_line in answer_lines_raw
          assign cleaned_line = raw_line | strip
          if cleaned_line == blank
            continue
          endif
          if answer_lines_string != ''
            assign answer_lines_string = answer_lines_string | append: '###A###'
          endif
          assign answer_lines_string = answer_lines_string | append: cleaned_line
        endfor
        if answer_lines_string != ''
          assign answer_lines = answer_lines_string | split: '###A###'
        endif
      endif
    endif
  endif
%}

{% if question_lines != blank and answer_lines != blank %}

  <div class="product-faq-accordion" style="margin: 2rem 0;">
    <h2>{{ section.settings.heading }}</h2>
    
    {% for raw_q in question_lines %}
      {% assign question = raw_q | strip %}
      {% assign answer_raw = answer_lines[forloop.index0] | default: '' %}
      {% assign answer = answer_raw | strip %}
      {% if question != blank and answer != blank %}
        <details class="faq-item" style="border-bottom: 1px solid #DEDEDE; padding: 1rem 0;">
          <summary style="cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            {{ question }}
            <span class="faq-icon" style="transition: transform 0.3s;">▼</span>
          </summary>
          <div class="faq-answer" style="padding-top: 1rem; color: #3e3e3e;">
            {{ answer | newline_to_br }}
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </div>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var wrap = root.querySelector('.product-faq-accordion');
      if (!wrap) return;
      if (wrap.dataset.oneOpenInit === '1') return;
      wrap.dataset.oneOpenInit = '1';

      wrap.addEventListener('toggle', function (e) {
        var details = e.target;
        if (!details || details.tagName !== 'DETAILS') return;
        if (!details.classList.contains('faq-item')) return;
        if (!details.open) return;

        var all = wrap.querySelectorAll('details.faq-item[open]');
        for (var i = 0; i < all.length; i++) {
          if (all[i] !== details) all[i].open = false;
        }
      }, true);
    })();
  </script>

  <style>
    .faq-item[open] .faq-icon {
      transform: rotate(180deg);
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Product FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "Product FAQ Accordion"
    }
  ]
}
{% endschema %}

