{% comment %}
  Product FAQ Accordion Section
  Displays global questions with product-specific answers
{% endcomment %}

{% liquid
  assign questions_meta = shop.metafields.custom.product_faq_question
  assign answers_meta = product.metafields.custom.product_faq

  assign questions_text = ''
  assign answers_text = ''

  if questions_meta != blank
    assign questions_text = questions_meta | metafield_text | strip
  endif

  if answers_meta != blank
    assign answers_text = answers_meta | metafield_text | default: answers_meta | strip
  endif
%}

{% if questions_text != blank and answers_text != blank %}
  {% assign question_lines = questions_text | newline_to_br | split: '<br />' %}
  {%- liquid
    assign answers_value = answers_meta.value
    assign answer_lines = blank
    if answers_value != blank and answers_meta.type contains 'list.'
      assign answer_lines = answers_value
    else
      assign answers_html = answers_text | newline_to_br | strip
      if answers_html contains 'a.' and answers_html contains 'b.' or answers_html contains 'a.' and answers_html contains 'B.'
        assign answers_norm = answers_html
        assign answers_norm = answers_norm | replace: '<br />', '\n'
        assign answers_norm = answers_norm | replace: '<br/>', '\n'
        assign answers_norm = answers_norm | replace: '<br>', '\n'

        assign answers_marked = answers_norm
        assign answers_marked = answers_marked | replace: '\nb.', '###A###b.'
        assign answers_marked = answers_marked | replace: '\nc.', '###A###c.'
        assign answers_marked = answers_marked | replace: '\nd.', '###A###d.'
        assign answers_marked = answers_marked | replace: '\nB.', '###A###B.'
        assign answers_marked = answers_marked | replace: '\nC.', '###A###C.'
        assign answers_marked = answers_marked | replace: '\nD.', '###A###D.'
        assign answers_marked = answers_marked | replace: ' b.', '###A###b.'
        assign answers_marked = answers_marked | replace: ' c.', '###A###c.'
        assign answers_marked = answers_marked | replace: ' d.', '###A###d.'
        assign answers_marked = answers_marked | replace: ' B.', '###A###B.'
        assign answers_marked = answers_marked | replace: ' C.', '###A###C.'
        assign answers_marked = answers_marked | replace: ' D.', '###A###D.'
        assign answer_lines = answers_marked | split: '###A###'
      else
        assign answer_lines_raw = answers_html | split: '<br />'
        assign answer_lines_string = ''
        for raw_line in answer_lines_raw
          assign cleaned_line = raw_line | strip
          if cleaned_line == blank
            continue
          endif
          if answer_lines_string != ''
            assign answer_lines_string = answer_lines_string | append: '###A###'
          endif
          assign answer_lines_string = answer_lines_string | append: cleaned_line
        endfor
        if answer_lines_string != ''
          assign answer_lines = answer_lines_string | split: '###A###'
        endif
      endif
    endif
  -%}

  <div class="product-faq-accordion" style="margin: 2rem 0;">
    <h2>{{ section.settings.heading }}</h2>
    
    {% for raw_q in question_lines %}
      {% assign question = raw_q | strip %}
      {% assign answer_raw = answer_lines[forloop.index0] %}
      {% assign answer = answer_raw | strip %}
      {% if answer != blank %}
        {% assign answer = answer
          | remove_first: 'a.' | remove_first: 'A.'
          | remove_first: 'b.' | remove_first: 'B.'
          | remove_first: 'c.' | remove_first: 'C.'
          | remove_first: 'd.' | remove_first: 'D.'
          | strip
        %}
      {% endif %}
      {% if question != blank and answer != blank %}
        <details class="faq-item" style="border-bottom: 1px solid #e0e0e0; padding: 1rem 0;">
          <summary style="cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            {{ question }}
            <span class="faq-icon" style="transition: transform 0.3s;">▼</span>
          </summary>
          <div class="faq-answer" style="padding-top: 1rem; color: #666;">
            {{ answer | newline_to_br }}
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </div>

  <style>
    .faq-item[open] .faq-icon {
      transform: rotate(180deg);
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Product FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "Product FAQ Accordion"
    }
  ]
}
{% endschema %}

