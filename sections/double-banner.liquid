{%- comment -%} Two-up clickable banners (AI split banner style) {%- endcomment -%}

<section class="double-banner" id="double-banner-{{ section.id }}">
  <div class="double-banner__grid">
    {%- for i in (1..2) -%}
      {%- assign img_key = 'image_' | append: i -%}
      {%- assign m_key = 'mobile_image_' | append: i -%}
      {%- assign href_key = 'href_' | append: i -%}
      {%- assign alt_key = 'alt_' | append: i -%}
      {%- assign img = section.settings[img_key] -%}
      {%- assign href = section.settings[href_key] -%}
      <div class="double-banner__item">
        {%- if href != blank -%}<a class="double-banner__link" href="{{ href }}">{%- endif -%}
          {%- if img != blank -%}
            {%- assign mobile_img = section.settings[m_key] | default: img -%}
            <picture class="double-banner__picture">
              <source
                media="(max-width: 768px)"
                srcset="
                  {{ mobile_img | image_url: width: 480 }} 480w,
                  {{ mobile_img | image_url: width: 768 }} 768w,
                  {{ mobile_img | image_url: width: 1024 }} 1024w
                "
                sizes="100vw"
              >
              <img
                class="double-banner__img"
                src="{{ img | image_url: width: 1400 }}"
                srcset="
                  {{ img | image_url: width: 800 }} 800w,
                  {{ img | image_url: width: 1100 }} 1100w,
                  {{ img | image_url: width: 1400 }} 1400w
                "
                sizes="(min-width: 900px) 50vw, 100vw"
                alt="{{ section.settings[alt_key] | escape }}"
                loading="lazy"
              >
            </picture>
          {%- else -%}
            <div class="double-banner__placeholder">
              <p>Add an image for this banner in Theme Customizer.</p>
            </div>
          {%- endif -%}
        {%- if href != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .double-banner__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--container-padding);
    box-sizing: border-box;
  }
  .double-banner__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .double-banner__picture,
  .double-banner__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
  }
  .double-banner__placeholder {
    width: 100%;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 1px dashed rgba(76, 85, 100, 0.35);
    background: rgba(0, 0, 0, 0.02);
    color: rgba(76, 85, 100, 0.75);
    font-size: 13px;
    text-align: center;
    padding: 16px;
    box-sizing: border-box;
  }
  @media (max-width: 900px) {
    .double-banner__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Double banner (2 images)",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Left image (desktop)" },
    { "type": "image_picker", "id": "mobile_image_1", "label": "Left image (mobile, optional)" },
    { "type": "url", "id": "href_1", "label": "Left link (optional)" },
    { "type": "text", "id": "alt_1", "label": "Left alt text", "default": "Banner" },

    { "type": "image_picker", "id": "image_2", "label": "Right image (desktop)" },
    { "type": "image_picker", "id": "mobile_image_2", "label": "Right image (mobile, optional)" },
    { "type": "url", "id": "href_2", "label": "Right link (optional)" },
    { "type": "text", "id": "alt_2", "label": "Right alt text", "default": "Banner" }
  ],
  "presets": [
    { "name": "Double banner (2 images)" }
  ]
}
{% endschema %}

