{%- assign instagram_url = section.settings.instagram_url | default: 'https://instagram.com/glamoracosmetics.official' -%}
{%- assign email_url = section.settings.email | default: 'support@glamoracosmetics.in' -%}

<footer class="g-footer">
  <div class="g-footer__container">
    <div class="g-footer__grid">
      <div class="g-footer__brand">
        <a href="{{ routes.root_url }}" class="g-footer__logo">{{ shop.name }}</a>
        <p>{{ section.settings.brand_description }}</p>
      </div>

      <div>
        <h4>{{ section.settings.shop_heading }}</h4>
        <ul class="g-footer__links">
          {% if section.settings.shop_menu != blank %}
            {% for link in linklists[section.settings.shop_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <div>
        <h4>{{ section.settings.company_heading }}</h4>
        <ul class="g-footer__links">
          {% if section.settings.company_menu != blank %}
            {% for link in linklists[section.settings.company_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <div>
        <h4>{{ section.settings.policies_heading }}</h4>
        <ul class="g-footer__links">
          {% if section.settings.policies_menu != blank %}
            {% for link in linklists[section.settings.policies_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="g-footer__bottom">
      <p>{{ section.settings.copyright_text }}</p>
      <div class="g-footer__social">
        <a href="{{ instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="mailto:{{ email_url }}" aria-label="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .g-footer {
    background: #141413;
    color: rgba(255, 255, 255, 0.5);
    padding: 80px 0 40px;
    position: relative;
    overflow: hidden;
  }
  .g-footer::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(13, 139, 125, 0.06) 0%, transparent 70%);
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .g-footer__container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
    position: relative;
  }
  .g-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: clamp(32px, 4vw, 64px);
    margin-bottom: 64px;
  }
  .g-footer__logo {
    color: rgba(255, 255, 255, 0.85);
    font-family: 'Fraunces', Georgia, serif;
    font-size: 24px;
    font-weight: 600;
    text-decoration: none;
  }
  .g-footer__brand p {
    font-size: 16px;
    line-height: 1.75;
    margin-top: 20px;
    font-weight: 300;
    max-width: 320px;
  }
  .g-footer h4 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
    margin: 0 0 20px;
  }
  .g-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .g-footer__links li {
    margin-bottom: 12px;
  }
  .g-footer__links a {
    font-size: 16px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .g-footer__links a:hover {
    color: #fff;
  }
  .g-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .g-footer__bottom p {
    margin: 0;
    font-size: 15px;
    font-weight: 300;
  }
  .g-footer__social {
    display: flex;
    gap: 16px;
  }
  .g-footer__social a {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.65);
    transition: all 0.3s ease;
  }
  .g-footer__social a:hover {
    border-color: #0D8B7D;
    color: #0D8B7D;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px -4px rgba(13, 139, 125, 0.3);
  }
  .g-footer__social svg {
    width: 16px;
    height: 16px;
  }
  @media (max-width: 768px) {
    .g-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .g-footer__brand {
      grid-column: span 2;
    }
    .g-footer__bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
  @media (max-width: 480px) {
    .g-footer__grid {
      grid-template-columns: 1fr;
    }
    .g-footer__brand {
      grid-column: span 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Advanced anti-pollution skincare for the modern Indian. We combine clinically-tested actives with skin-loving botanicals to cleanse, shield, and repair pollution damage. Every day."
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Shop heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },
    {
      "type": "text",
      "id": "company_heading",
      "label": "Company heading",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu"
    },
    {
      "type": "text",
      "id": "policies_heading",
      "label": "Policies heading",
      "default": "Policies"
    },
    {
      "type": "link_list",
      "id": "policies_menu",
      "label": "Policies menu"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://instagram.com/glamoracosmetics.official"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "support@glamoracosmetics.in"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "2026 Glamora Cosmetics. All rights reserved."
    }
  ]
}
{% endschema %}
