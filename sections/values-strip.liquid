{%- comment -%} Trust factor section: heading, subheading, 4 blocks (icon + title + description). Matches minimalist trust layout. {%- endcomment -%}

<section class="values-strip" id="values-strip-{{ section.id }}">
  <div class="values-strip__inner">
    <header class="values-strip__intro">
      {%- if section.settings.title != blank -%}
        <h2 class="values-strip__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="values-strip__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <div class="values-strip__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'value' -%}
          <div class="values-strip__item" {{ block.shopify_attributes }}>
            <div class="values-strip__icon-wrap" aria-hidden="true">
              {%- if block.settings.icon_key != blank -%}
                {%- render 'trust-factor-icon', name: block.settings.icon_key -%}
              {%- elsif block.settings.icon != blank -%}
                <span class="values-strip__icon values-strip__icon--emoji">{{ block.settings.icon }}</span>
              {%- elsif block.settings.icon_image != blank -%}
                <img src="{{ block.settings.icon_image | image_url: width: 96 }}" alt="" class="values-strip__icon-img" width="48" height="48" loading="lazy">
              {%- else -%}
                {%- render 'trust-factor-icon', name: 'transparency' -%}
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="values-strip__name">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="values-strip__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .values-strip {
    width: 100%;
    background: var(--white);
    padding: 72px var(--container-padding);
    box-sizing: border-box;
  }

  .values-strip__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .values-strip__intro {
    text-align: center;
    margin-bottom: 48px;
  }

  .values-strip__title {
    margin: 0 0 16px 0;
    font-family: var(--font-heading);
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.2;
  }

  .values-strip__subtitle {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(26, 26, 26, 0.78);
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .values-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px 24px;
  }

  .values-strip__item {
    text-align: center;
    padding: 0 8px;
  }

  .values-strip__icon-wrap {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px auto;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
  }

  .values-strip__icon-wrap .trust-factor-icon {
    width: 48px;
    height: 48px;
  }

  .values-strip__icon--emoji {
    font-size: 32px;
    line-height: 1;
  }

  .values-strip__icon-img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .values-strip__name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--text);
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .values-strip__desc {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(26, 26, 26, 0.75);
    margin: 0;
  }

  @media (max-width: 990px) {
    .values-strip {
      padding: 56px var(--container-padding);
    }
    .values-strip__intro {
      margin-bottom: 40px;
    }
    .values-strip__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 20px;
    }
  }

  @media (max-width: 520px) {
    .values-strip {
      padding: 40px var(--container-padding);
    }
    .values-strip__intro {
      margin-bottom: 32px;
    }
    .values-strip__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .values-strip__item {
      padding: 0 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust factors",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "The future of personal care is here" },
    { "type": "textarea", "id": "subtitle", "label": "Subheading", "default": "Embrace Glamora, where each element is chosen for its scientific merit, offering you authentic, effective skincare solutions." }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Trust factor",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon_key", "label": "Icon (line art)", "default": "", "options": [
          { "value": "", "label": "None" },
          { "value": "transparency", "label": "Transparency (circles)" },
          { "value": "efficacy", "label": "Efficacy (flask)" },
          { "value": "affordable", "label": "Affordable (bottle)" },
          { "value": "globe", "label": "Only the best (globe)" }
        ]},
        { "type": "text", "id": "icon", "label": "Icon (emoji, if no line art)" },
        { "type": "image_picker", "id": "icon_image", "label": "Icon (image, optional)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust factors",
      "blocks": [
        { "type": "value", "settings": { "icon_key": "transparency", "title": "Transparency", "description": "Full disclosure of ingredients used & their concentration." } },
        { "type": "value", "settings": { "icon_key": "efficacy", "title": "Efficacy", "description": "Formulations developed with science-backed, effective ingredients." } },
        { "type": "value", "settings": { "icon_key": "affordable", "title": "Affordable", "description": "Skincare, accessible to all." } },
        { "type": "value", "settings": { "icon_key": "globe", "title": "Only the best", "description": "Ingredients sourced from across the world." } }
      ]
    }
  ]
}
{% endschema %}
