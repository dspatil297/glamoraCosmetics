  .pdp-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9997;
    background: rgba(255,255,255,0.98);
    border-top: 1px solid rgba(222, 222, 222, 0.8);
    padding: 10px var(--container-padding, 16px);
    display: none;
  }
  .pdp-sticky__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .pdp-sticky__price { font-weight: 900; font-size: 16px; }
  .pdp-sticky__btn {
    border: 0;
    background: #15736d;
    color: #ffffff;
    font-weight: 900;
    padding: 12px 16px;
    border-radius: 12px;
    cursor: pointer;
    min-width: 160px;
  }
  .pdp-sticky__btn:disabled { opacity: 0.55; cursor: not-allowed; }

  @media (max-width: 900px) {
    .pdp__grid { grid-template-columns: 1fr; }
    .pdp .css-slider-viewport,
    .pdp .product-gallery-item {
      max-height: min(48vh, var(--pdp-gallery-max-px, 520px));
    }
    .pdp .lazy-image--background > .img,
    .pdp .product-gallery .lazy-image--background img.img {
      max-height: min(48vh, var(--pdp-gallery-max-px, 520px)) !important;
    }
    .pdp-sticky { display: block; }
    /* Reserve space for the sticky bar on the PDP only (avoid global body padding). */
    .pdp { padding-bottom: calc(var(--pdp-padding-bottom, 40px) + 72px); }

    /* Mobile typography + layout tightening */
    .pdp__title { font-size: clamp(22px, 6vw, 34px); line-height: 1.15; }
    .pdp__rating { font-size: 13px; }
    .pdp__stars { font-size: 15px; }
    .pdp__rating-text { font-size: 13px; }
    .pdp .product-gallery__thumbnails-holder {
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .pdp .product-gallery__thumbnails .thumbnail {
      scroll-snap-align: start;
      width: 72px;
      border-radius: 10px;
    }

    .pdp__media,
    .pdp .css-slider-viewport {
      max-width: 100%;
      overflow: hidden;
      box-sizing: border-box;
    }
    .pdp [data-pdp-slider-track],
    .pdp .product-gallery-item {
      max-width: none;
      box-sizing: border-box;
    }
  }

  @media (max-width: 480px) {
    /* Prevent qty + ATC row from overflowing on small phones */
    .pdp__cta-row { flex-direction: column; align-items: stretch; }
    .pdp__qty { width: 100%; }
    .pdp__qty-control { width: 100%; min-width: 0; max-width: none; }
    .pdp__btn { width: 100%; }

    /* Sticky bar: avoid forcing a wide button */
    .pdp-sticky__btn { min-width: 0; width: auto; padding-left: 14px; padding-right: 14px; }

    /* Smaller thumbs for small phones */
    .pdp .product-gallery__thumbnails-holder { gap: 8px; }
    .pdp .product-gallery__thumbnails .thumbnail { width: 60px; border-radius: 10px; }
  }
{% endstylesheet %}

