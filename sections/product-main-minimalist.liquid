  }
  .pdp__price-mrp {
    font-size: var(--pdp-compare-size, 14px);
    font-weight: 600;
    color: #000000;
  }
  .pdp__price { font-size: var(--pdp-price-size, 22px); font-weight: 800; color: #000000; }
  .pdp__compare { font-size: var(--pdp-compare-size, 14px); color: #707070; text-decoration: line-through; }
  .pdp__compare { font-size: var(--pdp-compare-size, 14px); color: #707070; text-decoration: line-through; }
  .pdp__compare--hidden { display: none !important; }
  .pdp__price-badge {
    font-size: var(--pdp-badge-size, 12px);
    padding: 4px 8px;
    border-radius: 4px;
