{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_image | default: product.featured_image
  assign product_subtitle = product.metafields.descriptors.subtitle.value | default: product.metafields.custom.card_subtitle.value | strip
  assign form_id = 'pdp-form-' | append: section.id
  assign compare = current_variant.compare_at_price
  assign price = current_variant.price
  assign has_discount = false
  assign discount_pct = 0
  if compare != blank and compare > price
    assign has_discount = true
    assign discount_pct = compare | minus: price | times: 100 | divided_by: compare | round
  endif

  assign faq_items = '' | split: ''
  assign ingredient_items_from_metafield = '' | split: ''
  assign faq_meta = product.metafields.custom.product_page_faq
  assign ingredients_meta = product.metafields.custom.key_ingredients
  assign how_to_use_meta = product.metafields.custom.how_to_use
  assign howto_steps_default_string = 'Wet your face|||Splash lukewarm water to open pores and prepare skin for deep cleansing.|||0:00###STEP###Apply and massage|||Coin-sized amount. Massage in circular motions for 45-60 seconds. Focus on T-zone.|||0:15###STEP###Rinse clean|||Wash off with cool water to close pores. Pat dry with a clean towel - never rub.|||1:00###STEP###Continue routine|||While skin is still damp, apply the Moisturizing Spray (Step 2) for maximum absorption.|||1:30'
  assign howto_steps = howto_steps_default_string | split: '###STEP###'
  assign parsed_steps_string = ''
  assign parsed_count = 0
  if how_to_use_meta.value != blank
    for raw_line in how_to_use_meta.value
      assign cleaned_line = raw_line | strip
      if cleaned_line == ''
        continue
      endif
      assign line_parts = cleaned_line | split: '|'
      if line_parts.size >= 3
        assign parsed_title = line_parts[0] | strip
        assign parsed_text = line_parts[1] | strip
        assign parsed_time = line_parts[2] | strip
        if parsed_title != '' and parsed_text != '' and parsed_time != ''
          if parsed_steps_string != ''
            assign parsed_steps_string = parsed_steps_string | append: '###STEP###'
          endif
          assign parsed_steps_string = parsed_steps_string | append: parsed_title | append: '|||' | append: parsed_text | append: '|||' | append: parsed_time
          assign parsed_count = parsed_count | plus: 1
        endif
      endif
      if parsed_count == 4
        break
      endif
    endfor
  endif
  if parsed_count < 4
    assign how_to_use_content = how_to_use_meta | metafield_text | default: how_to_use_meta.value | default: how_to_use_meta | strip
    assign how_to_use_content = how_to_use_content | newline_to_br | replace: '<br>', '<br />' | replace: '<br/>', '<br />'
    assign raw_howto_lines = how_to_use_content | split: '<br />'
    for raw_line in raw_howto_lines
      assign cleaned_line = raw_line | strip
      if cleaned_line == ''
        continue
      endif
      assign line_parts = cleaned_line | split: '|'
      if line_parts.size >= 3
        assign parsed_title = line_parts[0] | strip
        assign parsed_text = line_parts[1] | strip
        assign parsed_time = line_parts[2] | strip
        if parsed_title != '' and parsed_text != '' and parsed_time != ''
          if parsed_steps_string != ''
            assign parsed_steps_string = parsed_steps_string | append: '###STEP###'
          endif
          assign parsed_steps_string = parsed_steps_string | append: parsed_title | append: '|||' | append: parsed_text | append: '|||' | append: parsed_time
          assign parsed_count = parsed_count | plus: 1
        endif
      endif
      if parsed_count == 4
        break
      endif
    endfor
  endif
  if parsed_count == 4
    assign howto_steps = parsed_steps_string | split: '###STEP###'
  endif
  if faq_meta != blank
    assign faq_text = faq_meta | metafield_text | default: faq_meta | strip
    if faq_text != blank
      assign faq_text = faq_text | replace: 'Q :', 'Q:'
      assign faq_text = faq_text | replace: 'q:', 'Q:'
      assign faq_text = faq_text | replace: 'q :', 'Q:'
      assign faq_text = faq_text | replace: 'A :', 'A:'
      assign faq_text = faq_text | replace: 'a:', 'A:'
      assign faq_text = faq_text | replace: 'a :', 'A:'
      assign raw_chunks = faq_text | split: 'Q:'
      assign faq_items_string = ''
      for chunk in raw_chunks
        assign cleaned = chunk | strip
        if cleaned == ''
          continue
        endif
        assign parts = cleaned | split: 'A:'
        assign question = parts[0] | strip
        assign answer = ''
        if parts.size > 1
          assign answer = parts[1]
          if parts.size > 2
            for extra in parts offset:2
              assign answer = answer | append: 'A:' | append: extra
            endfor
          endif
          assign answer = answer | strip
        endif
        if question != '' and answer != ''
          assign qa_pair = question | append: '|||' | append: answer
          if faq_items_string != ''
            assign faq_items_string = faq_items_string | append: '###FAQ###'
          endif
          assign faq_items_string = faq_items_string | append: qa_pair
        endif
      endfor
      if faq_items_string != ''
        assign faq_items = faq_items_string | split: '###FAQ###'
      endif
    endif
  endif

  if ingredients_meta != blank
    assign ingredients_text = ingredients_meta | metafield_text | default: ingredients_meta.value | default: ingredients_meta | strip
    if ingredients_text != blank
      assign normalized_ingredients_text = ingredients_text
      assign normalized_ingredients_text = normalized_ingredients_text | replace: 'Ing :', 'Ing:' | replace: 'ing:', 'Ing:' | replace: 'ing :', 'Ing:'
      assign normalized_ingredients_text = normalized_ingredients_text | replace: 'Des :', 'Des:' | replace: 'des:', 'Des:' | replace: 'des :', 'Des:'
      assign raw_ingredient_chunks = normalized_ingredients_text | split: 'Ing:'
      assign ingredient_items_string = ''
      for chunk in raw_ingredient_chunks
        assign cleaned_chunk = chunk | strip
        if cleaned_chunk == ''
          continue
        endif
        assign chunk_parts = cleaned_chunk | split: 'Des:'
        assign ingredient_title = chunk_parts[0] | strip
        assign ingredient_description = ''
        if chunk_parts.size > 1
          assign ingredient_description = chunk_parts[1]
          if chunk_parts.size > 2
            for extra_part in chunk_parts offset:2
              assign ingredient_description = ingredient_description | append: 'Des:' | append: extra_part
            endfor
          endif
          assign ingredient_description = ingredient_description | strip
        endif
        if ingredient_title != '' and ingredient_description != ''
          assign ingredient_pair = ingredient_title | append: '|||' | append: ingredient_description
          if ingredient_items_string != ''
            assign ingredient_items_string = ingredient_items_string | append: '###INGREDIENT###'
          endif
          assign ingredient_items_string = ingredient_items_string | append: ingredient_pair
        endif
      endfor
      if ingredient_items_string != ''
        assign ingredient_items_from_metafield = ingredient_items_string | split: '###INGREDIENT###'
      endif
    endif
  endif
-%}

<section class="pdpx" id="pdpx-{{ section.id }}">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep">/</span>
      <span style="color:var(--text)">{{ product.title }}</span>
    </div>
  </div>

  <div class="container">
    <div class="product-layout">
      <div class="gallery reveal">
        <div class="gallery-main-shell">
          <div class="gallery-main-core">
            <span class="gallery-badge">Bestseller</span>
            {%- if featured -%}
              <img src="{{ featured | image_url: width: 1400 }}" alt="{{ product.title | escape }}" id="mainImg-{{ section.id }}">
            {%- endif -%}
          </div>
        </div>
        {%- if product.images.size > 1 -%}
          <div class="gallery-thumbs">
            {%- for image in product.images -%}
              <button type="button" class="gallery-thumb{% if image.id == featured.id %} active{% elsif featured == blank and forloop.first %} active{% endif %}" data-thumb-src="{{ image | image_url: width: 1400 }}" aria-label="Image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 260 }}" alt="" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-info reveal" style="transition-delay:0.15s">
        <div class="routine-badge"><span class="routine-badge-num">1</span>Step 1 of the 3-Step Routine</div>
        <h1 class="pdpx-product-title">{{ product.title }}</h1>
        {%- if product_subtitle != blank -%}<p class="product-subtitle">{{ product_subtitle }}</p>{%- endif -%}

        <div class="product-ratings">
          <div class="stars">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <span class="rating-score">{{ section.settings.rating_text }}</span>
          <a href="#reviews-{{ section.id }}" class="rating-count">{{ section.settings.review_count_text }}</a>
        </div>

        <div class="pricing">
          <div class="pricing-row">
            <span class="price-current" data-pdp-price>{{ price | money }}</span>
            <span class="price-original{% unless has_discount %} is-hidden{% endunless %}" data-pdp-compare>{% if has_discount %}{{ compare | money }}{% endif %}</span>
            <span class="price-discount{% unless has_discount %} is-hidden{% endunless %}" data-pdp-discount>{% if has_discount %}{{ discount_pct }}% Off{% endif %}</span>
          </div>
          <div class="price-meta"><span class="price-tax">{{ section.settings.tax_text }}</span></div>
        </div>

        <div class="love-it">
          <div class="love-it-title">{{ section.settings.love_it_title }}</div>
          <ul class="love-it-list">
            {%- assign love_points = section.blocks | where: 'type', 'love_point' -%}
            {%- for block in love_points -%}
              <li {{ block.shopify_attributes }}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>{{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="stock-indicator"><div class="stock-dot"></div>{{ section.settings.stock_text }}</div>

        {%- form 'product', product, id: form_id, class: 'pdp-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>
          {%- if product.variants.size > 1 -%}
            <select name="id" class="variant-select" data-variant-select>
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>
              {%- endfor -%}
            </select>
          {%- endif -%}
          <div class="cart-actions" id="cartActions-{{ section.id }}">
            <div class="quantity-row">
              <div class="qty-selector">
                <button type="button" class="qty-btn" data-qty="minus">-</button>
                <input class="qty-val" type="number" name="quantity" value="1" min="1">
                <button type="button" class="qty-btn" data-qty="plus">+</button>
              </div>
              {%- assign add_to_cart_blocks = section.blocks | where: 'type', 'add_to_cart_button' -%}
              {%- if add_to_cart_blocks.size > 0 -%}
                {%- assign add_to_cart_block = add_to_cart_blocks.first -%}
                <button
                  type="submit"
                  name="add"
                  class="btn-add-cart {% if add_to_cart_block.settings.style == 'outline' %}btn-add-cart-outline{% endif %}"
                  {{ add_to_cart_block.shopify_attributes }}
                >
                  {{ add_to_cart_block.settings.label }}
                </button>
              {%- endif -%}
            </div>
            {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
            {%- if app_blocks.size > 0 -%}
              <div class="gokwik-app-wrap">
                {%- for block in app_blocks -%}
                  <div class="product-extra-app" {{ block.shopify_attributes }}>{% render block %}</div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          {%- assign has_below_cart_content = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'below_cart_button' or block.type == 'below_cart_text' -%}
              {%- assign has_below_cart_content = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if has_below_cart_content -%}
            <div class="below-cart-blocks">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'below_cart_button' -%}
                    <a
                      class="product-extra-button {% if block.settings.style == 'outline' %}product-extra-button-outline{% endif %}"
                      href="{{ block.settings.link | default: '#' }}"
                      {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.label }}
                    </a>
                  {%- when 'below_cart_text' -%}
                    <div class="product-extra-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endform -%}

        <div class="product-trust">
          {%- assign trust_items = section.blocks | where: 'type', 'trust_item' -%}
          {%- for block in trust_items -%}
            <div class="product-trust-item" {{ block.shopify_attributes }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>{{ block.settings.text }}
            </div>
          {%- endfor -%}
        </div>

        {%- assign has_lower_extra_blocks = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'custom_text' or block.type == 'custom_liquid' -%}
            {%- assign has_lower_extra_blocks = true -%}
            {%- break -%}
          {%- elsif block.type == 'custom_button' and block.settings.placement != 'below_cart' -%}
            {%- assign has_lower_extra_blocks = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if has_lower_extra_blocks -%}
          <div class="product-extra-blocks">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'custom_text' -%}
                  <div class="product-extra-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
                {%- when 'custom_button' -%}
                  {%- if block.settings.placement != 'below_cart' -%}
                    <a
                      class="product-extra-button {% if block.settings.style == 'outline' %}product-extra-button-outline{% endif %}"
                      href="{{ block.settings.link | default: '#' }}"
                      {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.label }}
                    </a>
                  {%- endif -%}
                {%- when 'custom_liquid' -%}
                  <div class="product-extra-liquid" {{ block.shopify_attributes }}>{{ block.settings.liquid }}</div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <section class="efficacy-section">
    <div class="container">
      <div class="efficacy-header reveal">
        <h2>{{ section.settings.efficacy_heading }}</h2>
        <p>{{ section.settings.efficacy_subheading }}</p>
      </div>
      <div class="efficacy-grid">
        {%- assign efficacy_items = section.blocks | where: 'type', 'efficacy_item' -%}
        {%- for block in efficacy_items -%}
          <div class="efficacy-card reveal{% if forloop.index > 1 %} reveal-d{{ forloop.index0 }}{% endif %}" {{ block.shopify_attributes }}><div class="efficacy-number">{{ block.settings.value }}</div><div class="efficacy-label">{{ block.settings.label }}</div></div>
        {%- endfor -%}
      </div>
      <p class="efficacy-source reveal">{{ section.settings.efficacy_source }}</p>
    </div>
  </section>
  <section class="ingredients-section">
    <div class="container">
      <div class="ingredients-header reveal">
        <h2>{{ section.settings.ingredients_heading }}</h2>
        <p>{{ section.settings.ingredients_subheading }}</p>
      </div>
      <div class="ingredients-grid">
        {%- if ingredient_items_from_metafield.size > 0 -%}
          {%- for item in ingredient_items_from_metafield -%}
            {%- assign ingredient_parts = item | split: '|||' -%}
            {%- assign ingredient_title = ingredient_parts | first | strip -%}
            {%- assign ingredient_description = ingredient_parts[1] | strip -%}
            {%- assign title_words = ingredient_title | replace: '(', ' ' | replace: ')', ' ' | replace: ',', ' ' | replace: '-', ' ' | split: ' ' -%}
            {%- assign first_word = '' -%}
            {%- assign second_word = '' -%}
            {%- for word in title_words -%}
              {%- assign clean_word = word | strip -%}
              {%- if clean_word != '' -%}
                {%- if first_word == '' -%}
                  {%- assign first_word = clean_word -%}
                {%- elsif second_word == '' -%}
                  {%- assign second_word = clean_word -%}
                  {%- break -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign second_initial = '' -%}
            {%- if second_word != '' -%}
              {%- assign second_initial = second_word | slice: 0, 1 -%}
            {%- endif -%}
            {%- assign ingredient_symbol = first_word | slice: 0, 1 | append: second_initial -%}
            {%- if ingredient_symbol == '' -%}
              {%- assign ingredient_symbol = ingredient_title | slice: 0, 2 -%}
            {%- endif -%}
            {%- if ingredient_symbol == '' -%}
              {%- assign ingredient_symbol = 'IN' -%}
            {%- endif -%}
            <div class="ingredient-card reveal{% if forloop.index > 1 %} reveal-d{{ forloop.index0 }}{% endif %}"><div class="ingredient-symbol">{{ ingredient_symbol | upcase }}</div><h4>{{ ingredient_title }}</h4><p>{{ ingredient_description }}</p></div>
          {%- endfor -%}
        {%- else -%}
          {%- assign ingredient_items = section.blocks | where: 'type', 'ingredient_item' -%}
          {%- for block in ingredient_items -%}
            <div class="ingredient-card reveal{% if forloop.index > 1 %} reveal-d{{ forloop.index0 }}{% endif %}" {{ block.shopify_attributes }}><div class="ingredient-symbol">{{ block.settings.symbol }}</div><h4>{{ block.settings.title }}</h4><p>{{ block.settings.description }}</p></div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
  <section class="idealfor-section">
    <div class="container">
      <div class="idealfor-inner">
        <div class="idealfor-content reveal">
          <h2>{{ section.settings.idealfor_heading }}</h2>
          <p>{{ section.settings.idealfor_subheading }}</p>
          <ul class="concern-list">
            {%- assign concern_items = section.blocks | where: 'type', 'concern_item' -%}
            {%- for block in concern_items -%}
              <li class="concern-item" {{ block.shopify_attributes }}><h4>{{ block.settings.text }}</h4></li>
            {%- endfor -%}
          </ul>
        </div>
        <div class="reveal reveal-d1" style="text-align:center;">
          <p style="font-family:var(--font-display);font-size:18px;font-weight:600;color:var(--text);margin-bottom:20px;">{{ section.settings.skin_types_heading }}</p>
          <div class="skin-types">
            {%- assign skin_type_items = section.blocks | where: 'type', 'skin_type_item' -%}
            {%- for block in skin_type_items -%}
              <span class="skin-type-tag active" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="howto-section">
    <div class="container">
      <div class="howto-header reveal">
        <h2>How to use</h2>
        <p>A 90-second ritual that makes a real difference. Use twice daily - morning and night.</p>
      </div>
      <div class="howto-grid">
        {%- for step in howto_steps limit: 4 -%}
          {%- assign step_parts = step | split: '|||' -%}
          {%- assign step_title = step_parts[0] | strip -%}
          {%- assign step_text = step_parts[1] | strip -%}
          {%- assign step_time = step_parts[2] | strip -%}
          <div class="howto-step reveal{% if forloop.index > 1 %} reveal-d{{ forloop.index0 }}{% endif %}">
            <div class="howto-num">{{ forloop.index }}</div>
            <h4>{{ step_title }}</h4>
            <p>{{ step_text }}</p>
            <span class="howto-timing">{{ step_time }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  <section class="routine-section">
    <div class="container">
      <div class="section-header reveal">
        <h2>Complete the 3-step defense</h2>
        <p>One product can't fight pollution from every angle. Complete the routine for multi-layer protection.</p>
      </div>
      <div class="routine-crosssell">
        <article class="crosssell-shell current-product reveal">
          <div class="crosssell-core">
            <div class="crosssell-img">
              {%- if featured -%}<img src="{{ featured | image_url: width: 900 }}" alt="{{ product.title | escape }}">{%- endif -%}
              <span class="current-tag">Viewing Now</span>
            </div>
            <div class="crosssell-body"><h3 class="crosssell-name">{{ product.title }}</h3><span class="crosssell-price">{{ price | money }}</span></div>
          </div>
        </article>
        <article class="crosssell-shell reveal reveal-d1"><div class="crosssell-core"><div class="crosssell-img"></div><div class="crosssell-body"><h3 class="crosssell-name">Pollution Control Moisturizing Spray</h3><span class="crosssell-price">Rs. 649</span></div></div></article>
        <article class="crosssell-shell reveal reveal-d2"><div class="crosssell-core"><div class="crosssell-img"></div><div class="crosssell-body"><h3 class="crosssell-name">Pollution Control Hybrid Sunscreen SPF 50</h3><span class="crosssell-price">Rs. 669</span></div></div></article>
      </div>
    </div>
  </section>
  <section class="study-section">
    <div class="container">
      <div class="study-header reveal"><h2>{{ section.settings.study_heading }}</h2></div>
      <div class="study-bars reveal">
        {%- assign study_items = section.blocks | where: 'type', 'study_item' -%}
        {%- for block in study_items -%}
          <div class="study-bar" {{ block.shopify_attributes }}><div class="study-percent">{{ block.settings.percent }}</div><div class="study-bar-info"><h4>{{ block.settings.label }}</h4><div class="study-bar-track"><div class="study-bar-fill" style="--fill:{{ block.settings.fill }}"></div></div></div></div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  <section class="reviews-section" id="reviews-{{ section.id }}">
    <div class="container">
      <div class="reviews-header reveal"><h2>{{ section.settings.reviews_heading }}</h2></div>
      <div class="reviews-summary reveal">
        <div class="reviews-score"><div class="big-number">{{ section.settings.rating_text }}</div><div class="total">Based on {{ section.settings.review_count_text }}</div></div>
        <div class="star-breakdown">
          <div class="star-row"><span>5</span><div class="star-row-track"><div class="star-row-fill" style="width:58%"></div></div><span>58%</span></div>
          <div class="star-row"><span>4</span><div class="star-row-track"><div class="star-row-fill" style="width:26%"></div></div><span>26%</span></div>
          <div class="star-row"><span>3</span><div class="star-row-track"><div class="star-row-fill" style="width:10%"></div></div><span>10%</span></div>
          <div class="star-row"><span>2</span><div class="star-row-track"><div class="star-row-fill" style="width:4%"></div></div><span>4%</span></div>
          <div class="star-row"><span>1</span><div class="star-row-track"><div class="star-row-fill" style="width:2%"></div></div><span>2%</span></div>
        </div>
      </div>
      <div class="reviews-grid">
        {%- assign review_items = section.blocks | where: 'type', 'review_item' -%}
        {%- for block in review_items -%}
          <div class="review-card reveal{% if forloop.index > 1 %} reveal-d{{ forloop.index0 }}{% endif %}" {{ block.shopify_attributes }}><p class="review-text">{{ block.settings.quote }}</p><div class="review-author">{{ block.settings.author }}</div></div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  <section class="faq-section">
    <div class="container">
      <div class="faq-header reveal"><h2>{{ section.settings.faq_heading }}</h2></div>
      <div class="faq-list">
        {%- assign faq_blocks = section.blocks | where: 'type', 'faq_item' -%}
        {%- if faq_blocks.size > 0 -%}
          {%- for block in faq_blocks -%}
            <div class="faq-item" {{ block.shopify_attributes }}>
              <button type="button" class="faq-question">
                {{ block.settings.question }}
                <span class="faq-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                </span>
              </button>
              <div class="faq-answer"><p>{{ block.settings.answer }}</p></div>
            </div>
          {%- endfor -%}
        {%- elsif section.settings.enable_metafield_faq and faq_items.size > 0 -%}
          {%- for item in faq_items -%}
            {%- assign qa_parts = item | split: '|||' -%}
            {%- assign question = qa_parts[0] | strip | replace: '&amp;', '&' -%}
            {%- assign answer = qa_parts[1] | strip | replace: '&amp;', '&' -%}
            {%- if question != blank and answer != blank -%}
              <div class="faq-item">
                <button type="button" class="faq-question">
                  {{ question }}
                  <span class="faq-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                  </span>
                </button>
                <div class="faq-answer"><p>{{ answer | newline_to_br }}</p></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="faq-item"><button type="button" class="faq-question">How is this different from a regular face wash?<span class="faq-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span></button><div class="faq-answer"><p>Regular face washes clean surface-level dirt and oil. This one is formulated to specifically target PM2.5 particles and city grime while supporting brighter skin.</p></div></div>
          <div class="faq-item"><button type="button" class="faq-question">Can I use this twice a day?<span class="faq-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span></button><div class="faq-answer"><p>Yes. The formula is gentle enough for daily morning and evening use across skin types.</p></div></div>
          <div class="faq-item"><button type="button" class="faq-question">Will it dry out my skin?<span class="faq-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span></button><div class="faq-answer"><p>No. Hydrating ingredients help prevent post-wash tightness.</p></div></div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <div class="sticky-bar" id="stickyBar-{{ section.id }}"><div class="container"><div class="sticky-bar-inner"><div class="sticky-bar-info"><span class="sticky-bar-name">{{ product.title }}</span><span class="sticky-bar-price" data-sticky-price>{{ price | money }}</span></div><button class="sticky-bar-cta" type="submit" form="{{ form_id }}" name="add">Add to Cart</button></div></div></div>
</section>

<script>
  (function() {
    var root = document.getElementById('pdpx-{{ section.id }}');
    if (!root) return;
    var mainImg = root.querySelector('#mainImg-{{ section.id }}');
    var thumbs = root.querySelectorAll('.gallery-thumb[data-thumb-src]');
    for (var i = 0; i < thumbs.length; i++) { thumbs[i].addEventListener('click', function() { var src = this.getAttribute('data-thumb-src'); if (mainImg && src) mainImg.src = src; for (var j = 0; j < thumbs.length; j++) thumbs[j].classList.remove('active'); this.classList.add('active'); }); }
    var qtyBtns = root.querySelectorAll('[data-qty]');
    for (var k = 0; k < qtyBtns.length; k++) { qtyBtns[k].addEventListener('click', function() { var input = root.querySelector('.qty-val'); if (!input) return; var v = parseInt(input.value, 10) || 1; if (this.getAttribute('data-qty') === 'plus') v++; if (this.getAttribute('data-qty') === 'minus') v = Math.max(1, v - 1); input.value = v; }); }
    var select = root.querySelector('[data-variant-select]'); var hiddenId = root.querySelector('[data-variant-id-input]'); var priceEl = root.querySelector('[data-pdp-price]'); var compareEl = root.querySelector('[data-pdp-compare]'); var discountEl = root.querySelector('[data-pdp-discount]'); var stickyPriceEl = root.querySelector('[data-sticky-price]'); var buyNowPriceEl = root.querySelector('[data-buy-now-price]');
    function money(cents) { var n = parseInt(cents, 10); if (isNaN(n)) return ''; return 'Rs. ' + (n / 100).toFixed(2); }
    function updatePrice(opt) { if (!opt) return; var p = parseInt(opt.getAttribute('data-price') || '0', 10); var c = parseInt(opt.getAttribute('data-compare') || '0', 10); if (hiddenId) hiddenId.value = opt.value; if (priceEl) priceEl.textContent = money(p); if (stickyPriceEl) stickyPriceEl.textContent = money(p); if (buyNowPriceEl) buyNowPriceEl.textContent = money(p); if (c > p) { if (compareEl) { compareEl.textContent = money(c); compareEl.classList.remove('is-hidden'); } if (discountEl) { discountEl.textContent = Math.round(((c - p) / c) * 100) + '% Off'; discountEl.classList.remove('is-hidden'); } } else { if (compareEl) compareEl.classList.add('is-hidden'); if (discountEl) discountEl.classList.add('is-hidden'); } }
    if (select) { updatePrice(select.options[select.selectedIndex]); select.addEventListener('change', function() { updatePrice(this.options[this.selectedIndex]); }); }
    var faqBtns = root.querySelectorAll('.faq-question'); for (var f = 0; f < faqBtns.length; f++) { faqBtns[f].addEventListener('click', function() { var item = this.parentElement; var open = item.classList.contains('open'); var all = root.querySelectorAll('.faq-item'); for (var x = 0; x < all.length; x++) all[x].classList.remove('open'); if (!open) item.classList.add('open'); }); }
    var studyBars = root.querySelectorAll('.study-bar-fill'); for (var sb = 0; sb < studyBars.length; sb++) studyBars[sb].style.width = studyBars[sb].style.getPropertyValue('--fill');
    var cartActions = root.querySelector('#cartActions-{{ section.id }}'); var stickyBar = root.querySelector('#stickyBar-{{ section.id }}'); if (cartActions && stickyBar && 'IntersectionObserver' in window) { var stickyObs = new IntersectionObserver(function(entries) { entries.forEach(function(entry) { stickyBar.classList.toggle('visible', !entry.isIntersecting); }); }, { threshold: 0 }); stickyObs.observe(cartActions); }
    var reveal = root.querySelectorAll('.reveal'); if ('IntersectionObserver' in window) { var ro = new IntersectionObserver(function(entries){ entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('visible'); ro.unobserve(e.target);} }); }, {threshold:.08, rootMargin:'0px 0px -40px 0px'}); for(var r=0;r<reveal.length;r++) ro.observe(reveal[r]); }
  })();
</script>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&display=swap');
  :root { --bg:#FAFAF7; --bg-alt:#F3F1ED; --bg-dark:#141413; --text:#141413; --text-2:#5C5B57; --text-3:#8A8985; --teal:#0D8B7D; --teal-muted:#1A9E8F; --teal-bg:#EBF5F3; --gold:#C5A44E; --border:#E8E6E1; --border-light:#F0EDE8; --font-body:'Outfit',-apple-system,sans-serif; --font-display:'Fraunces',Georgia,serif; --ease:cubic-bezier(0.32,0.72,0,1); --container:1360px; }
  .pdpx { font-family: var(--font-body); color: var(--text); background: var(--bg); }
  .pdpx * { box-sizing: border-box; }
  .container { max-width: var(--container); margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
  .breadcrumb { padding: 20px 0; font-size: 14px; font-weight: 400; color: var(--text-3); } .breadcrumb .sep { margin: 0 8px; opacity: .4; } .breadcrumb a { color: inherit; text-decoration: none; }
  .product-layout { display:grid; grid-template-columns:1.1fr .9fr; gap:clamp(40px,6vw,80px); padding-bottom:clamp(60px,8vw,100px); align-items:start; }
  .gallery{position:sticky;top:100px;} .gallery-main-shell{background:rgba(0,0,0,.015);border:1px solid var(--border-light);padding:6px;border-radius:2rem;margin-bottom:16px;max-width:540px;margin-left:auto;margin-right:auto;}
  .gallery-main-core{border-radius:calc(2rem - 6px);overflow:hidden;aspect-ratio:1;background:var(--bg-alt);position:relative;cursor:zoom-in;}
  .gallery-main-core img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease),opacity .4s var(--ease);} .gallery-main-shell:hover .gallery-main-core img{transform:scale(1.06);}
  .gallery-badge{position:absolute;top:20px;left:20px;padding:6px 16px;background:var(--teal);color:#fff;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border-radius:100px;}
  .gallery-thumbs{display:flex;gap:10px;max-width:540px;margin:0 auto;} .gallery-thumb{flex:1;border-radius:.75rem;overflow:hidden;border:2px solid transparent;cursor:pointer;opacity:.55;background:var(--bg-alt);} .gallery-thumb.active{border-color:var(--teal);opacity:1;}
  .gallery-thumb img{width:100%;height:100%;aspect-ratio:1;object-fit:cover;}
  .product-info{padding-top:8px;} .routine-badge{display:inline-flex;align-items:center;gap:10px;padding:8px 18px;border-radius:100px;background:var(--teal-bg);font-size:13px;font-weight:600;letter-spacing:.06em;color:var(--teal);margin-bottom:16px;}
  .routine-badge-num{width:22px;height:22px;background:var(--teal);color:#fff;border-radius:50%;display:grid;place-items:center;font-size:12px;font-weight:700;}
  /* PDP title: beat global critical.css h1 / h1,h2… (Playfair, --h1-size, weight 900) via #id + class */
  #pdpx-{{ section.id }} h1.pdpx-product-title{font-family:var(--font-display,"Fraunces",Georgia,serif);font-size:clamp(28px,3.5vw,42px);font-weight:600;line-height:1.15;letter-spacing:-.02em;color:var(--text,#141413);margin:0 0 8px;}
  .product-subtitle{font-size:16px;font-weight:400;color:var(--text-2);margin-bottom:16px;} .product-ratings{display:flex;align-items:center;gap:12px;margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--border-light);}
  .stars{display:flex;gap:2px;color:#F5A623;} .rating-score{font-size:15px;font-weight:600;color:var(--text);} .rating-count{font-size:14px;font-weight:500;color:var(--teal);text-decoration:none;}
  .pricing{margin-bottom:24px;} .pricing-row{display:flex;align-items:baseline;gap:12px;margin-bottom:4px;} .price-current{font-family:var(--font-display);font-size:38px;font-weight:600;letter-spacing:-.025em;color:var(--text);}
  .price-original{font-size:18px;font-weight:400;color:var(--text-3);text-decoration:line-through;} .price-discount{font-size:12px;font-weight:700;color:#fff;background:var(--teal);padding:4px 12px;border-radius:100px;letter-spacing:.06em;text-transform:uppercase;}
  .price-meta{display:flex;align-items:center;gap:16px;margin-top:6px;} .price-tax{font-size:14px;font-weight:300;color:var(--text-3);} .price-per-ml{font-size:14px;font-weight:500;color:var(--text-2);}
  .love-it{padding:20px 24px;background:var(--teal-bg);border:1px solid rgba(13,139,125,.08);border-radius:1rem;margin-bottom:24px;}
  .love-it-title{font-size:14px;font-weight:700;color:var(--teal);letter-spacing:.04em;text-transform:uppercase;margin-bottom:12px;}
  .love-it-list{list-style:none;margin:0;padding:0;} .love-it-list li{display:flex;align-items:flex-start;gap:10px;font-size:15px;line-height:1.5;font-weight:400;color:var(--text);padding:5px 0;} .love-it-list li svg{flex-shrink:0;color:var(--teal);margin-top:3px;}
  .stock-indicator{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:500;color:var(--text-2);margin-bottom:20px;} .stock-dot{width:8px;height:8px;background:var(--teal);border-radius:50%;position:relative;}
  .stock-dot::after{content:'';position:absolute;inset:-4px;background:var(--teal);border-radius:50%;opacity:.4;animation:pulse 2s infinite ease-out;} @keyframes pulse{0%{transform:scale(1);opacity:.4;}100%{transform:scale(3);opacity:0;}}
  .variant-select{width:100%;margin-bottom:12px;border:1px solid var(--border);border-radius:10px;padding:12px;background:#fff;}
  .quantity-row{display:flex;gap:12px;margin-bottom:12px;} .qty-selector{display:flex;align-items:center;border:1px solid var(--border);border-radius:12px;overflow:hidden;flex:0 0 132px;}
  .qty-btn{width:42px;height:52px;border:0;background:var(--bg);font-size:18px;cursor:pointer;} .qty-val{width:48px;height:52px;border:0;text-align:center;font-size:15px;font-weight:600;-moz-appearance:textfield;appearance:textfield;}
  .qty-val::-webkit-outer-spin-button,.qty-val::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
  .btn-add-cart{flex:1 1 auto;min-height:52px;padding:16px 24px;background:var(--text);color:#fff;border-radius:12px;font-size:15px;font-weight:600;letter-spacing:.02em;border:0;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 2px 4px rgba(255,255,255,.1);transition:all .4s var(--ease);cursor:pointer;}
  .btn-add-cart:hover{background:var(--bg-dark);transform:translateY(-2px);box-shadow:0 8px 24px -8px rgba(0,0,0,.5),inset 0 2px 4px rgba(255,255,255,.1);}
  .btn-add-cart-outline{background:transparent;color:var(--text);border:1px solid var(--border);box-shadow:none;}
  .btn-add-cart-outline:hover{background:var(--bg-alt);}
  .btn-buy-now{width:100%;padding:16px;background:var(--teal);color:#fff;border-radius:12px;font-size:15px;font-weight:600;letter-spacing:.02em;transition:all .4s var(--ease);box-shadow:inset 0 2px 4px rgba(255,255,255,.2);border:0;cursor:pointer;}
  .btn-buy-now:hover{background:#0B7A6E;transform:translateY(-2px);box-shadow:0 8px 24px -8px rgba(13,139,125,.5),inset 0 2px 4px rgba(255,255,255,.2);}
  .product-trust{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:20px 0;border-top:1px solid var(--border-light);}
  .product-trust-item{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;color:var(--text-2);padding:10px 14px;background:var(--bg-alt);border-radius:10px;} .product-trust-item svg{color:var(--teal);flex-shrink:0;}
  .product-extra-blocks{display:flex;flex-direction:column;gap:10px;margin-top:10px;}
  .below-cart-blocks{display:flex;flex-direction:column;gap:10px;margin-top:12px;}
  .product-extra-text{font-size:14px;line-height:1.6;color:var(--text-2);}
  .product-extra-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 16px;border-radius:10px;background:var(--text);color:#fff;text-decoration:none;font-size:14px;font-weight:600;transition:all .3s var(--ease);}
  .product-extra-button:hover{background:var(--bg-dark);transform:translateY(-1px);}
  .product-extra-button-outline{background:transparent;color:var(--text);border:1px solid var(--border);}
  .product-extra-button-outline:hover{background:var(--bg-alt);}
  .efficacy-section{background:var(--bg-dark);padding:clamp(64px,8vw,100px) 0;color:#fff;} .ingredients-section,.idealfor-section,.howto-section,.study-section,.routine-section,.reviews-section,.faq-section{padding:clamp(80px,10vw,128px) 0;}
  .idealfor-section,.study-section,.reviews-section{background:var(--bg-alt);}
  .efficacy-header{text-align:center;margin-bottom:clamp(40px,5vw,64px);} .efficacy-header h2,.ingredients-header h2,.idealfor-content h2,.howto-header h2,.study-header h2,.section-header h2,.reviews-header h2,.faq-header h2{font-family:var(--font-display);font-size:clamp(28px,3.5vw,42px);font-weight:600;line-height:1.15;letter-spacing:-.025em;margin:0 0 12px;}
  .ingredients-header h2,.idealfor-content h2,.howto-header h2,.study-header h2,.section-header h2,.reviews-header h2,.faq-header h2{color:var(--text);}
  .efficacy-header p{font-size:17px;line-height:1.7;font-weight:300;color:rgba(255,255,255,.5);max-width:50ch;margin:0 auto;}
  .ingredients-header h2,.idealfor-content h2{margin-bottom:16px;} .howto-header h2{margin-bottom:16px;} .study-header h2{margin-bottom:16px;} .howto-header{text-align:center;max-width:560px;margin:0 auto clamp(40px,5vw,64px);} .study-header{text-align:center;max-width:560px;margin:0 auto clamp(40px,5vw,64px);} .study-header p{font-size:17px;line-height:1.7;font-weight:300;color:var(--text-2);margin:0;}
  .idealfor-content>p{font-size:17px;line-height:1.7;font-weight:300;color:var(--text-2);margin:0 0 32px;} .concern-item h4{font-size:15px;font-weight:600;color:var(--text);margin:0 0 2px;}
  .efficacy-grid,.ingredients-grid,.howto-grid,.reviews-grid{display:grid;gap:20px;} .efficacy-grid{grid-template-columns:repeat(4,1fr);} .ingredients-grid,.howto-grid{grid-template-columns:repeat(4,1fr);} .reviews-grid{grid-template-columns:repeat(3,1fr);}
  .efficacy-card,.ingredient-card,.howto-step,.review-card{padding:24px;border-radius:1.25rem;border:1px solid var(--border-light);} .ingredient-card,.howto-step,.review-card{background:var(--bg);} .efficacy-card{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.06);}
  .review-text{font-size:15px;line-height:1.7;font-weight:300;color:var(--text-2);margin:0 0 16px;} .review-author{font-size:14px;font-weight:600;color:var(--text);}
  .efficacy-number{font-family:var(--font-display);font-size:clamp(36px,4.5vw,56px);font-weight:700;line-height:1;letter-spacing:-.03em;color:var(--gold);margin-bottom:12px;} .efficacy-label{font-size:15px;line-height:1.5;font-weight:300;color:rgba(255,255,255,.55);}
  .efficacy-source{text-align:center;margin-top:32px;font-size:13px;color:rgba(255,255,255,.25);font-style:italic;}
  .ingredients-header{max-width:560px;margin-bottom:clamp(40px,5vw,64px);} .ingredients-header p,.howto-header p{font-size:17px;line-height:1.7;color:var(--text-2);font-weight:300;}
  .ingredient-symbol{width:52px;height:52px;border-radius:14px;background:var(--teal-bg);color:var(--teal);display:grid;place-items:center;font-size:16px;font-weight:700;letter-spacing:-.02em;margin-bottom:20px;position:relative;z-index:1;}
  .ingredient-card h4{font-size:17px;font-weight:600;color:var(--text);margin:0 0 8px;position:relative;z-index:1;} .ingredient-card p{font-size:15px;line-height:1.6;font-weight:300;color:var(--text-2);position:relative;z-index:1;}
  .howto-num{width:44px;height:44px;background:var(--teal);color:#fff;border-radius:50%;display:grid;place-items:center;font-family:var(--font-display);font-size:16px;font-weight:600;margin:0 auto 16px;box-shadow:0 0 0 6px var(--bg),0 0 0 8px var(--teal-bg);position:relative;z-index:1;}
  .howto-grid{position:relative;} .howto-grid::before{content:'';position:absolute;top:32px;left:10%;right:10%;border-top:2px dashed var(--border);z-index:0;} .howto-step{position:relative;z-index:1;text-align:center;}
  .howto-step h4{font-size:17px;font-weight:600;color:var(--text);margin:0 0 8px;} .howto-step p{font-size:15px;line-height:1.65;color:var(--text-2);font-weight:300;} .howto-timing{display:inline-block;margin-top:12px;padding:4px 12px;border-radius:100px;background:var(--teal-bg);color:var(--teal);font-size:12px;font-weight:600;letter-spacing:.04em;}
  .routine-section .section-header{margin-bottom:clamp(40px,5vw,64px);} .routine-section .section-header h2{margin-bottom:16px;} .routine-section .section-header p{font-size:17px;line-height:1.7;font-weight:300;color:var(--text-2);margin:0;}
  .idealfor-inner{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,6vw,80px);align-items:center;} .concern-list{list-style:none;padding:0;margin:0;} .concern-item{padding:14px 0;border-bottom:1px solid var(--border);}
  .skin-types{display:flex;flex-wrap:wrap;gap:10px;} .skin-type-tag{padding:10px 20px;border-radius:100px;border:1px solid var(--border);font-size:14px;font-weight:500;color:var(--text-2);background:var(--bg);} .skin-type-tag.active{border-color:var(--teal);background:var(--teal-bg);color:var(--teal);font-weight:600;}
  .study-bars{max-width:700px;margin:0 auto;display:flex;flex-direction:column;gap:20px;} .study-bar{display:grid;grid-template-columns:80px 1fr;gap:20px;align-items:center;} .study-percent{font-family:var(--font-display);font-size:32px;font-weight:700;letter-spacing:-.02em;color:var(--teal);text-align:right;} .study-bar-info h4{font-size:15px;font-weight:600;color:var(--text);margin:0 0 8px;}
  .study-bar-track{height:8px;background:var(--border);border-radius:8px;overflow:hidden;} .study-bar-fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--teal-muted));border-radius:8px;width:0;} .study-disclaimer{text-align:center;margin-top:32px;font-size:13px;font-style:italic;color:var(--text-3);}
  .routine-crosssell{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;} .crosssell-shell{background:rgba(0,0,0,.015);border:1px solid var(--border-light);padding:6px;border-radius:1.75rem;}
  .crosssell-core{background:var(--bg);border-radius:calc(1.75rem - 6px);overflow:hidden;display:flex;flex-direction:column;box-shadow:inset 0 1px 0 rgba(255,255,255,.8);} .crosssell-img{aspect-ratio:4/5;background:var(--bg-alt);position:relative;} .crosssell-img img{width:100%;height:100%;object-fit:cover;}
  .crosssell-body{padding:24px 20px;} .crosssell-name{font-family:var(--font-display);font-size:19px;font-weight:600;line-height:1.3;color:var(--text);margin:0 0 8px;} .crosssell-desc{font-size:15px;line-height:1.65;font-weight:300;color:var(--text-2);margin:0 0 16px;} .crosssell-price{font-size:18px;font-weight:600;color:var(--text);} .crosssell-mrp{font-size:15px;font-weight:300;color:var(--text-3);text-decoration:line-through;margin-left:8px;} .current-tag{position:absolute;top:20px;left:20px;padding:5px 12px;background:var(--teal);color:#fff;border-radius:100px;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;}
  #pdpx-{{ section.id }} .faq-header{text-align:center;max-width:560px;margin:0 auto clamp(40px,5vw,64px);}
  #pdpx-{{ section.id }} .faq-header h2{font-family:var(--font-display);font-size:clamp(28px,3.5vw,42px);font-weight:600;line-height:1.15;letter-spacing:-.025em;color:var(--text);}
  #pdpx-{{ section.id }} .faq-list{max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:10px;}
  #pdpx-{{ section.id }} .faq-item{
    border:1px solid var(--border) !important;
    border-radius:0 !important;
    margin:0 !important;
    padding:0 !important;
    background:transparent !important;
    box-shadow:none !important;
    transform:none !important;
    transition:border-color .2s ease !important;
  }
  #pdpx-{{ section.id }} .faq-item:hover{
    border-color:#000 !important;
    background:transparent !important;
    box-shadow:none !important;
    transform:none !important;
  }
  #pdpx-{{ section.id }} .faq-question{
    width:100%;
    display:flex;align-items:center;justify-content:space-between;
    padding:24px 20px;
    font-size:16px;font-weight:600;
    color:var(--text);
    text-align:left;
    transition:none;
    border:0;background:transparent !important;
    box-shadow:none !important;
    transform:none !important;
  }
  #pdpx-{{ section.id }} .faq-question:hover{color:var(--teal);}
  #pdpx-{{ section.id }} .faq-icon{
    width:28px;height:28px;
    border-radius:50%;
    border:1px solid var(--border);
    display:grid;place-items:center;
    flex-shrink:0;
    transition:all .4s var(--ease);
  }
  #pdpx-{{ section.id }} .faq-item.open .faq-icon{background:var(--teal);border-color:var(--teal);color:#fff;transform:rotate(45deg);}
  #pdpx-{{ section.id }} .faq-answer{max-height:0;overflow:hidden;transition:max-height .5s var(--ease),padding .5s var(--ease);padding:0 20px;}
  #pdpx-{{ section.id }} .faq-item.open .faq-answer{max-height:300px;padding:0 20px 24px;}
  #pdpx-{{ section.id }} .faq-answer p{font-size:15px;line-height:1.75;color:var(--text-2);font-weight:300;margin:0;}
  .reviews-header{text-align:center;margin-bottom:clamp(40px,5vw,64px);} .reviews-header h2{margin-bottom:16px;}
  .reviews-summary{display:flex;align-items:center;justify-content:center;gap:40px;margin-bottom:clamp(40px,5vw,64px);flex-wrap:wrap;} .reviews-score{text-align:center;} .reviews-score .stars-row{display:flex;justify-content:center;gap:3px;margin:8px 0;color:#F5A623;} .big-number{font-family:var(--font-display);font-size:64px;font-weight:700;line-height:1;letter-spacing:-.03em;color:var(--text);}
  .reviews-score .total{font-size:15px;font-weight:300;color:var(--text-3);}
  .star-breakdown{width:240px;} .star-row{display:grid;grid-template-columns:20px 1fr 36px;gap:10px;align-items:center;padding:3px 0;} .star-row span:first-child{font-size:13px;font-weight:600;color:var(--text-2);text-align:right;} .star-row span:last-child{font-size:13px;color:var(--text-3);} .star-row-track{height:6px;background:var(--border);border-radius:6px;overflow:hidden;} .star-row-fill{height:100%;background:#F5A623;border-radius:6px;}
  .sticky-bar{position:fixed;bottom:0;left:0;right:0;background:rgba(250,250,247,.95);backdrop-filter:blur(20px);border-top:1px solid var(--border);padding:12px 0;z-index:400;transform:translateY(100%);transition:transform .5s var(--ease);}
  .sticky-bar.visible{transform:translateY(0);} .sticky-bar-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;} .sticky-bar-name{font-family:var(--font-display);font-size:16px;font-weight:600;color:var(--text);} .sticky-bar-price{font-size:18px;font-weight:600;color:var(--text);} .sticky-bar-price .old{font-size:14px;font-weight:400;color:var(--text-3);text-decoration:line-through;margin-left:6px;}
  .sticky-bar-cta{padding:14px 32px;background:var(--teal);color:#fff;border-radius:100px;font-size:15px;font-weight:600;border:0;cursor:pointer;}
  .reveal{opacity:0;transform:translateY(32px);transition:opacity .9s var(--ease),transform .9s var(--ease);} .reveal.visible{opacity:1;transform:translateY(0);}
  .is-hidden{display:none !important;}
  @media (max-width:1024px){.product-layout{grid-template-columns:1fr;}.gallery{position:static;}.efficacy-grid,.ingredients-grid,.howto-grid{grid-template-columns:repeat(2,1fr);}.howto-grid::before{display:none;}.reviews-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:768px){.idealfor-inner{grid-template-columns:1fr;}.routine-crosssell{grid-template-columns:1fr;}.reviews-grid{grid-template-columns:1fr;}.product-trust{grid-template-columns:1fr;}.sticky-bar-name{display:none;}}
  @media (max-width:480px){.ingredients-grid,.howto-grid{grid-template-columns:1fr;}.quantity-row{flex-direction:column;}}
{% endstylesheet %}

