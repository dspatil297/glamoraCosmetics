{%- comment -%}
  Product Main (Minimalist-style PDP)
  - Breadcrumb
  - 2-column: gallery (left) + info (right)
  - Blocks on the right: title, concern, rating, price, variants, CTAs, trust badges, accordions, mobile sticky bar
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign first_collection = collection
  if first_collection == blank and product.collections.size > 0
    assign first_collection = product.collections.first
  endif

  assign form_id = 'pdp-form-' | append: section.id

  assign has_info_blocks = false
  for b in section.blocks
    if b.type != 'mobile_sticky_bar'
      assign has_info_blocks = true
      break
    endif
  endfor
-%}

<section 
  class="pdp" 
  id="pdp-{{ section.id }}" 
  style="
    --pdp-padding-top: {{ section.settings.padding_top | default: 40 }}px;
    --pdp-padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    --pdp-grid-gap: {{ section.settings.content_gap | default: 40 }}px;
    --pdp-title-size: {{ section.settings.title_font_size | default: 52 }}px;
    --pdp-body-size: {{ section.settings.body_font_size | default: 14 }}px;
    --pdp-price-size: {{ section.settings.price_font_size | default: 22 }}px;
    --pdp-compare-size: {{ section.settings.compare_font_size | default: 14 }}px;
    --pdp-badge-size: {{ section.settings.badge_font_size | default: 12 }}px;
    --pdp-button-font-size: {{ section.settings.button_font_size | default: 14 }}px;
    --base-headings-primary-size: 60;
  "
  {{ section.shopify_attributes }}
>
  {%- if section.settings.show_breadcrumb -%}
    <nav class="pdp__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="pdp__crumb">{{ section.settings.breadcrumb_home | default: 'Home' }}</a>
      <span class="pdp__crumb-sep" aria-hidden="true">›</span>
      {%- if first_collection != blank -%}
        <a href="{{ first_collection.url }}" class="pdp__crumb">{{ first_collection.title }}</a>
        <span class="pdp__crumb-sep" aria-hidden="true">›</span>
      {%- endif -%}
      <span class="pdp__crumb-current">{{ product.title }}</span>
    </nav>
  {%- endif -%}

  <div class="pdp__grid">
    <div class="pdp__media" data-pdp-media>
      {%- assign featured = current_variant.featured_image | default: product.featured_image -%}
      <div class="pdp__media-main">
        {%- if featured -%}
          <img
            class="pdp__main-img"
            src="{{ featured | image_url: width: 900 }}"
            srcset="
              {{ featured | image_url: width: 540 }} 540w,
              {{ featured | image_url: width: 720 }} 720w,
              {{ featured | image_url: width: 900 }} 900w
            "
            sizes="(max-width: 900px) 100vw, 50vw"
            alt="{{ featured.alt | default: product.title }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- else -%}
          <div class="pdp__media-empty">
            {% render 'unsplash-placeholder', type: 'product', width: 900, class: 'pdp__main-img', loading: 'eager', alt: product.title %}
          </div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="pdp__thumbs" role="tablist" aria-label="Product images">
          {%- for image in product.images -%}
            <button
              type="button"
              class="pdp__thumb{% if image == featured %} is-active{% endif %}"
              data-pdp-thumb
              data-image-src="{{ image | image_url: width: 900 }}"
              role="tab"
              aria-selected="{% if image == featured %}true{% else %}false{% endif %}"
              aria-label="Image {{ forloop.index }}"
            >
              <img 
                src="{{ image | image_url: width: 120, height: 144, crop: 'center' }}" 
                alt="" 
                width="120" 
                height="144" 
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp__info" data-pdp-info>
      {%- form 'product', product, id: form_id, class: 'pdp__form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-pdp-variant-id>

        {%- if has_info_blocks -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'product_title' -%}
                {%- assign title_size = block.settings.title_font_size | default: section.settings.title_font_size | default: 52 -%}
                {%- assign title_weight = block.settings.title_font_weight | default: section.settings.title_font_weight | default: 400 -%}
                <div class="pdp__block pdp__title-wrap" {{ block.shopify_attributes }} style="--pdp-title-size: {{ title_size }}px; --pdp-title-weight: {{ title_weight }};">
                  <h1 class="pdp__title">{{ product.title }}</h1>
                </div>

              {%- when 'concern' -%}
                <div class="pdp__block" {{ block.shopify_attributes }}>
                  {%- if block.settings.text != blank -%}
                    <div class="pdp__concern">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>

              {%- when 'rating' -%}
                <div class="pdp__block" {{ block.shopify_attributes }}>
                  <div class="pdp__rating">
                    <span class="pdp__stars">★★★★☆</span>
                    <span class="pdp__rating-text">
                      {{ block.settings.rating | default: 4.5 }} ({{ block.settings.count | default: 2341 }})
                    </span>
                  </div>
                </div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="pdp__block pdp__description-wrap" {{ block.shopify_attributes }}>
                    <div class="pdp__description rte">{{ product.description }}</div>
                  </div>
                {%- endif -%}

              {%- when 'price' -%}
                {%- liquid
                  assign compare = current_variant.compare_at_price
                  assign price = current_variant.price
                  assign has_discount = false
                  assign discount_pct = 0
                  if compare != blank and compare > price
                    assign has_discount = true
                    assign discount_pct = compare | minus: price | times: 100 | divided_by: compare | round
                  endif
                -%}
                <div class="pdp__block pdp__price-block" {{ block.shopify_attributes }}>
                  <span class="pdp__price-section-label">{{ block.settings.price_label | default: 'PRICE' }}</span>
                  <div class="pdp__price-card">
                    <div class="pdp__price-line1">
                      <span class="pdp__price-mrp">MRP</span>
                      <span class="pdp__compare{% unless has_discount %} pdp__compare--hidden{% endunless %}" data-pdp-compare>{% if has_discount %}{{ compare | money }}{% endif %}</span>
                      <span class="pdp__price" data-pdp-price>{{ price | money }}</span>
                      <span class="pdp__price-badge{% unless has_discount %} pdp__price-badge--hidden{% endunless %}" data-pdp-discount-badge>{% if has_discount %}{{ discount_pct }}% Off{% endif %}</span>
                      {%- if block.settings.show_price_info_icon -%}
                        <span class="pdp__price-info-icon" aria-label="Price information">ⓘ</span>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.tax_text != blank -%}
                      <div class="pdp__price-tax">{{ block.settings.tax_text }}</div>
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'variants' -%}
                <div class="pdp__block" {{ block.shopify_attributes }}>
                  {%- if product.variants.size > 1 -%}
                    <div class="pdp__variant">
                      <div class="pdp__variant-label">{{ block.settings.label | default: product.options.first }}</div>
                      <select class="pdp__variant-select pdp__variant-select--visible" name="id" data-pdp-variant-select aria-label="Variant selector">
                        {%- for variant in product.variants -%}
                          <option
                            value="{{ variant.id }}"
                            {% if variant == current_variant %}selected{% endif %}
                            {% unless variant.available %}disabled{% endunless %}
                            data-price="{{ variant.price }}"
                            data-compare="{{ variant.compare_at_price }}"
                          >
                            {{ variant.title }}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'ctas' -%}
                <div class="pdp__block" {{ block.shopify_attributes }}>
                  <div class="pdp__ctas">
                    <div class="pdp__cta-row">
                      <div class="pdp__qty">
                        <span class="pdp__qty-label">{{ section.settings.qty_label | default: 'Quantity' }}</span>
                        <div class="pdp__qty-control">
                          <button type="button" class="pdp__qty-btn" data-qty-action="minus" aria-label="Decrease quantity">−</button>
                          <input
                            type="number"
                            class="pdp__qty-input"
                            name="quantity"
                            min="1"
                            value="1"
                            inputmode="numeric"
                          >
                          <button type="button" class="pdp__qty-btn" data-qty-action="plus" aria-label="Increase quantity">+</button>
                        </div>
                      </div>
                      <button
                        type="submit"
                        name="add"
                        class="pdp__btn pdp__btn--primary"
                        data-pdp-atc
                        {% unless current_variant.available %}disabled{% endunless %}
                      >
                        {{ block.settings.atc_text | default: 'Add to Cart' }}
                      </button>
                    </div>
                    {%- if block.settings.show_buy_now -%}
                      <div class="pdp__buy-now">
                        {{ form | payment_button }}
                      </div>
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'trust_badges' -%}
                <div class="pdp__block" {{ block.shopify_attributes }}>
                  <ul class="pdp__trust" role="list">
                    {%- if block.settings.badge_1 != blank -%}<li>✓ {{ block.settings.badge_1 }}</li>{%- endif -%}
                    {%- if block.settings.badge_2 != blank -%}<li>✓ {{ block.settings.badge_2 }}</li>{%- endif -%}
                    {%- if block.settings.badge_3 != blank -%}<li>✓ {{ block.settings.badge_3 }}</li>{%- endif -%}
                    {%- if block.settings.badge_4 != blank -%}<li>✓ {{ block.settings.badge_4 }}</li>{%- endif -%}
                  </ul>
                </div>

              {%- when 'product_faq_accordion' -%}
                {%- liquid
                  assign faq_questions = shop.metafields.custom.product_faq_question.value

                  assign faq_answers_meta = product.metafields.custom.product_faq
                  assign faq_answers_value = blank
                  if faq_answers_meta != blank
                    assign faq_answers_value = faq_answers_meta.value
                  endif

                  assign faq_answer_lines = blank

                  if faq_answers_value != blank and faq_answers_meta.type contains 'list.'
                    assign faq_answer_lines = faq_answers_value
                  else
                    if faq_answers_meta != blank
                      assign faq_answers_text = faq_answers_meta | metafield_text | default: faq_answers_meta | strip
                      if faq_answers_text != blank
                        assign answers_html = faq_answers_text | newline_to_br | strip

                        if answers_html contains 'a.' and answers_html contains 'b.' or answers_html contains 'a.' and answers_html contains 'B.'
                          assign answers_norm = answers_html
                          assign answers_norm = answers_norm | replace: '<br />', '###BR###'
                          assign answers_norm = answers_norm | replace: '<br/>', '###BR###'
                          assign answers_norm = answers_norm | replace: '<br>', '###BR###'

                          assign answers_marked = answers_norm
                          assign answers_marked = answers_marked | replace: '###BR###b.', '###A###b.'
                          assign answers_marked = answers_marked | replace: '###BR###c.', '###A###c.'
                          assign answers_marked = answers_marked | replace: '###BR###d.', '###A###d.'
                          assign answers_marked = answers_marked | replace: '###BR###B.', '###A###B.'
                          assign answers_marked = answers_marked | replace: '###BR###C.', '###A###C.'
                          assign answers_marked = answers_marked | replace: '###BR###D.', '###A###D.'
                          assign answers_marked = answers_marked | replace: ' b.', '###A###b.'
                          assign answers_marked = answers_marked | replace: ' c.', '###A###c.'
                          assign answers_marked = answers_marked | replace: ' d.', '###A###d.'
                          assign answers_marked = answers_marked | replace: ' B.', '###A###B.'
                          assign answers_marked = answers_marked | replace: ' C.', '###A###C.'
                          assign answers_marked = answers_marked | replace: ' D.', '###A###D.'

                          assign faq_answer_lines = answers_marked | split: '###A###'
                        else
                          assign faq_answer_lines_raw = answers_html | split: '<br />'
                          assign faq_answer_lines_string = ''
                          for raw_line in faq_answer_lines_raw
                            assign cleaned_line = raw_line | strip
                            if cleaned_line == blank
                              continue
                            endif
                            if faq_answer_lines_string != ''
                              assign faq_answer_lines_string = faq_answer_lines_string | append: '###A###'
                            endif
                            assign faq_answer_lines_string = faq_answer_lines_string | append: cleaned_line
                          endfor
                          if faq_answer_lines_string != ''
                            assign faq_answer_lines = faq_answer_lines_string | split: '###A###'
                          endif
                        endif
                      endif
                    endif
                  endif
                -%}
                {%- if faq_questions != blank and faq_answer_lines != blank -%}
                  <div class="pdp__block pdp__faq-accordion-wrap" {{ block.shopify_attributes }}>
                    {%- for question in faq_questions -%}
                      {%- assign q_text = question | strip -%}
                      {%- assign a_raw = faq_answer_lines[forloop.index0] | default: '' -%}
                      {%- assign a_text = a_raw | strip -%}
                      {%- if a_text != blank -%}
                        {%- assign a_text = a_text
                          | remove_first: 'a.' | remove_first: 'A.'
                          | remove_first: 'b.' | remove_first: 'B.'
                          | remove_first: 'c.' | remove_first: 'C.'
                          | remove_first: 'd.' | remove_first: 'D.'
                          | replace: '###BR###', '<br />'
                          | strip
                        -%}
                      {%- endif -%}
                      {%- if q_text != blank -%}
                        <details class="pdp__acc">
                          <summary class="pdp__acc-sum">
                            <span>{{ q_text }}</span>
                            <span class="pdp__acc-ico" aria-hidden="true">+</span>
                          </summary>
                          <div class="pdp__acc-body rte">
                            {{ a_text | newline_to_br }}
                          </div>
                        </details>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

              {%- when 'accordion' -%}
                <div class="pdp__block" {{ block.shopify_attributes }}>
                  <details class="pdp__acc" {% if block.settings.open_by_default %}open{% endif %}>
                    <summary class="pdp__acc-sum">
                      <span>{{ block.settings.title | default: 'Accordion title' }}</span>
                      <span class="pdp__acc-ico" aria-hidden="true">+</span>
                    </summary>
                    <div class="pdp__acc-body rte">
                      {{ block.settings.content }}
                    </div>
                  </details>
                </div>

              {%- when 'mobile_sticky_bar' -%}
                {%- comment -%} Rendered below {%- endcomment -%}

            {%- endcase -%}
          {%- endfor -%}
        {%- else -%}
          {%- liquid
            assign compare = current_variant.compare_at_price
            assign price = current_variant.price
            assign has_discount = false
            assign discount_pct = 0
            if compare != blank and compare > price
              assign has_discount = true
              assign discount_pct = compare | minus: price | times: 100 | divided_by: compare | round
            endif
          -%}
          <div class="pdp__block">
            <h1 class="pdp__title">{{ product.title }}</h1>
            <div class="pdp__block pdp__price-block">
              <span class="pdp__price-section-label">PRICE</span>
              <div class="pdp__price-card">
                <div class="pdp__price-line1">
                  <span class="pdp__price-mrp">MRP</span>
                  <span class="pdp__compare{% unless has_discount %} pdp__compare--hidden{% endunless %}" data-pdp-compare>{% if has_discount %}{{ compare | money }}{% endif %}</span>
                  <span class="pdp__price" data-pdp-price>{{ price | money }}</span>
                  <span class="pdp__price-badge{% unless has_discount %} pdp__price-badge--hidden{% endunless %}" data-pdp-discount-badge>{% if has_discount %}{{ discount_pct }}% Off{% endif %}</span>
                  <span class="pdp__price-info-icon" aria-label="Price information">ⓘ</span>
                </div>
                <div class="pdp__price-tax">(incl. of all taxes)</div>
              </div>
            </div>
          </div>
          <div class="pdp__block">
            <div class="pdp__ctas">
              <button
                type="submit"
                name="add"
                class="pdp__btn pdp__btn--primary"
                data-pdp-atc
                {% unless current_variant.available %}disabled{% endunless %}
              >
                Add to Cart
              </button>
              <div class="pdp__buy-now">{{ form | payment_button }}</div>
            </div>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  {%- assign sticky_block = section.blocks | where: 'type', 'mobile_sticky_bar' | first -%}
  {%- if sticky_block -%}
    <div class="pdp-sticky" {{ sticky_block.shopify_attributes }}>
      <div class="pdp-sticky__inner">
        <div class="pdp-sticky__price" data-pdp-sticky-price>{{ current_variant.price | money }}</div>
        <button
          type="submit"
          form="{{ form_id }}"
          name="add"
          class="pdp-sticky__btn"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {{ sticky_block.settings.atc_text | default: 'Add to Cart' }}
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('pdp-{{ section.id }}');
    if (!root) return;
    if (root.dataset.inited === '1') return;
    root.dataset.inited = '1';

    var mainImg = root.querySelector('.pdp__main-img');
    var thumbs = root.querySelectorAll('[data-pdp-thumb]');
    var variantSelect = root.querySelector('[data-pdp-variant-select]');
    var priceEl = root.querySelector('[data-pdp-price]');
    var compareEl = root.querySelector('[data-pdp-compare]');
    var discountBadgeEl = root.querySelector('[data-pdp-discount-badge]');
    var stickyPriceEl = root.querySelector('[data-pdp-sticky-price]');

    function moneyFromCents(cents) {
      var n = parseInt(cents, 10);
      if (isNaN(n)) return '';
      return (n / 100).toFixed(2);
    }

    function setPriceFromOption(opt) {
      if (!opt) return;
      var price = opt.getAttribute('data-price');
      var compare = opt.getAttribute('data-compare');
      var priceNum = parseInt(price, 10);
      var compareNum = compare ? parseInt(compare, 10) : 0;
      var hasDiscount = compareNum > priceNum;
      if (priceEl) priceEl.textContent = moneyFromCents(price);
      if (stickyPriceEl) stickyPriceEl.textContent = moneyFromCents(price);
      if (compareEl) {
        if (hasDiscount) {
          compareEl.textContent = moneyFromCents(compare);
          compareEl.classList.remove('pdp__compare--hidden');
        } else {
          compareEl.classList.add('pdp__compare--hidden');
        }
      }
      if (discountBadgeEl) {
        if (hasDiscount) {
          var pct = Math.round((compareNum - priceNum) / compareNum * 100);
          discountBadgeEl.textContent = pct + '% Off';
          discountBadgeEl.classList.remove('pdp__price-badge--hidden');
        } else {
          discountBadgeEl.classList.add('pdp__price-badge--hidden');
        }
      }
    }

    if (variantSelect) {
      setPriceFromOption(variantSelect.options[variantSelect.selectedIndex]);
      variantSelect.addEventListener('change', function () {
        setPriceFromOption(this.options[this.selectedIndex]);
      });
    }

    // Quantity stepper above Add to Cart
    var qtyInput = root.querySelector('.pdp__qty-input');
    if (qtyInput) {
      var minQty = parseInt(qtyInput.getAttribute('min'), 10) || 1;
      var qtyButtons = root.querySelectorAll('.pdp__qty-btn');
      for (var i = 0; i < qtyButtons.length; i++) {
        (function(btn) {
          btn.addEventListener('click', function() {
            var action = btn.getAttribute('data-qty-action');
            var current = parseInt(qtyInput.value, 10) || minQty;
            if (action === 'minus' && current > minQty) {
              qtyInput.value = current - 1;
            } else if (action === 'plus') {
              qtyInput.value = current + 1;
            }
          });
        })(qtyButtons[i]);
      }
    }

    function setMainImage(btn) {
      if (!btn || !mainImg) return;
      var src = btn.getAttribute('data-image-src');
      mainImg.src = src;
      for (var i = 0; i < thumbs.length; i++) {
        thumbs[i].classList.toggle('is-active', thumbs[i] === btn);
        thumbs[i].setAttribute('aria-selected', thumbs[i] === btn ? 'true' : 'false');
      }
    }

    for (var t = 0; t < thumbs.length; t++) {
      thumbs[t].addEventListener('click', function () { setMainImage(this); });
    }
  })();
</script>

{% stylesheet %}
  .pdp {
    width: 100%;
    max-width: 100%;
    padding: var(--pdp-padding-top, 40px) var(--container-padding, 20px) var(--pdp-padding-bottom, 40px);
    background: #fff;
    box-sizing: border-box;
  }
  .pdp__breadcrumb {
    max-width: 1200px;
    margin: 0 auto 18px;
    font-size: 13px;
    color: rgba(0,0,0,0.6);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .pdp__crumb { color: inherit; text-decoration: none; }
  .pdp__crumb:hover { text-decoration: underline; }

  .pdp__grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--pdp-grid-gap, 40px);
    align-items: flex-start;
  }

  .pdp__media-main {
    border-radius: 16px;
    overflow: hidden;
    background: rgba(0,0,0,0.03);
  }
  .pdp__main-img {
    width: 100%;
    display: block;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .pdp__thumbs {
    margin-top: 12px;
    display: flex;
    gap: 10px;
    overflow: auto;
    padding-bottom: 6px;
  }
  .pdp__thumb {
    border: 1px solid rgba(0,0,0,0.14);
    border-radius: 12px;
    padding: 0;
    width: 120px;
    height: 144px;
    overflow: hidden;
    background: #fff;
    flex: 0 0 auto;
    cursor: pointer;
  }
  .pdp__thumb.is-active { border-color: rgba(0,0,0,0.7); }
  .pdp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pdp__title-wrap { display: block; }
  .pdp__title {
    margin: 0 0 6px;
    font-size: var(--pdp-title-size, 52px);
    line-height: 1.15;
    font-weight: var(--pdp-title-weight, 400);
    font-family: 'ProximaNovaRegular', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
  }
  .pdp__concern {
    font-size: var(--pdp-body-size, 14px);
    color: rgba(0,0,0,0.6);
    margin-bottom: 14px;
  }
  .pdp__rating {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 30px;
    color: rgba(0,0,0,0.75);
  }
  .pdp__stars { letter-spacing: 0.08em; }

  .pdp__description-wrap { margin-top: 4px; margin-bottom: 4px; }
  .pdp__description {
    font-size: var(--pdp-body-size, 14px);
    line-height: 1.6;
    color: rgba(0,0,0,0.75);
  }
  .pdp__description p { margin: 0 0 8px 0; }
  .pdp__description p:last-child { margin-bottom: 0; }

  /* Vertical spacing between info blocks */
  .pdp__block + .pdp__block {
    margin-top: 12px;
  }

  .pdp__price-section-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(0,0,0,0.5);
    margin-bottom: 6px;
    text-transform: uppercase;
  }
  .pdp__price-card {
    background: #fff;
    border-radius: 4px;
    border-top: 1px solid rgba(0,0,0,0.12);
    border-bottom: 1px solid rgba(0,0,0,0.12);
    padding: 14px 0;
  }
  .pdp__price-line1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 12px;
  }
  .pdp__price-mrp {
    font-size: var(--pdp-compare-size, 14px);
    font-weight: 600;
    color: #000;
  }
  .pdp__price { font-size: var(--pdp-price-size, 22px); font-weight: 800; color: #000; }
  .pdp__compare { font-size: var(--pdp-compare-size, 14px); color: rgba(0,0,0,0.55); text-decoration: line-through; }
  .pdp__compare--hidden { display: none !important; }
  .pdp__price-badge {
    font-size: var(--pdp-badge-size, 12px);
    padding: 4px 8px;
    border-radius: 4px;
    background: #000;
    color: #fff;
    font-weight: 600;
  }
  .pdp__price-badge--hidden { display: none !important; }
  .pdp__price-info-icon {
    font-size: 14px;
    color: rgba(0,0,0,0.5);
    cursor: help;
    line-height: 1;
  }
  .pdp__price-tax {
    font-size: 12px;
    color: rgba(0,0,0,0.5);
    margin-top: 6px;
  }
  .pdp__price-row {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin-top: 10px;
  }
  .pdp__badge {
    font-size: var(--pdp-badge-size, 12px);
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(0,0,0,0.06);
    color: rgba(0,0,0,0.8);
    font-weight: 700;
  }

  .pdp__variant { margin-top: 16px; }
  .pdp__variant-label { font-size: 12px; font-weight: 700; margin-bottom: 8px; color: rgba(0,0,0,0.75); }
  .pdp__variant-select--visible {
    display: block;
    width: 100%;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.18);
    background: #fff;
    font-size: 14px;
  }

  .pdp__ctas {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pdp__cta-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
  }
  .pdp__qty {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 0;
    flex: 0 0 auto;
  }
  .pdp__qty-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .pdp__qty-control {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(0,0,0,0.16);
    border-radius: 4px;
    overflow: hidden;
    height: 48px;
    width: 8.5rem;
    min-width: 7.5rem;
    max-width: 10rem;
  }
  .pdp__qty-btn {
    width: 32px;
    height: 100%;
    border: none;
    background: #f5f5f5;
    font-size: 18px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .pdp__qty-btn:hover {
    background: #e8e8e8;
  }
  .pdp__qty-input {
    width: 32px;
    height: 100%;
    border: none;
    border-left: 1px solid rgba(0,0,0,0.12);
    border-right: 1px solid rgba(0,0,0,0.12);
    text-align: center;
    font-size: var(--pdp-body-size, 14px);
  }
  .pdp__qty-input:focus {
    outline: none;
  }

  .pdp__btn {
    width: auto;
    flex: 1 1 auto;
    border-radius: 14px;
    padding: 14px 16px;
    min-height: 48px;
    font-size: var(--pdp-button-font-size, 14px);
    font-weight: 800;
    border: 1px solid rgba(0,0,0,0.14);
    cursor: pointer;
  }
  .pdp__btn--primary {
    background: #111;
    color: #fff;
    border-color: #111;
  }
  .pdp__btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .pdp__buy-now > * { width: 100%; }

  .pdp__trust {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    font-size: var(--pdp-body-size, 14px);
    color: rgba(0,0,0,0.72);
  }

  .pdp__acc {
    border-top: 1px solid rgba(0,0,0,0.12);
    padding: 12px 0;
  }
  .pdp__acc:last-child { border-bottom: 1px solid rgba(0,0,0,0.12); }
  .pdp__acc-sum {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-weight: 800;
    font-size: var(--pdp-body-size, 14px);
    color: rgba(0,0,0,0.85);
  }
  .pdp__acc-sum::-webkit-details-marker { display: none; }
  .pdp__acc-ico { font-weight: 900; }
  .pdp__acc-body { padding-top: 10px; color: rgba(0,0,0,0.72); font-size: var(--pdp-body-size, 14px); line-height: 1.5; }

  .pdp-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9997;
    background: rgba(255,255,255,0.98);
    border-top: 1px solid rgba(0,0,0,0.12);
    padding: 10px var(--container-padding, 16px);
    display: none;
  }
  .pdp-sticky__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .pdp-sticky__price { font-weight: 900; font-size: 16px; }
  .pdp-sticky__btn {
    border: 0;
    background: #111;
    color: #fff;
    font-weight: 900;
    padding: 12px 16px;
    border-radius: 12px;
    cursor: pointer;
    min-width: 160px;
  }
  .pdp-sticky__btn:disabled { opacity: 0.55; cursor: not-allowed; }

  @media (max-width: 900px) {
    .pdp__grid { grid-template-columns: 1fr; }
    .pdp__main-img { aspect-ratio: 9 / 16; }
    .pdp-sticky { display: block; }
    body { padding-bottom: 72px; }
  }
{% endstylesheet %}

