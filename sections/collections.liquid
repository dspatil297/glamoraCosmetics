{% comment %}
  All Collections page layout (`/collections`)
  - Matches beminimalist-style structure: page header + category grid
  - Uses Shopify `collections` object for data
{% endcomment %}

<section class="all-collections" id="all-collections">
  <div class="all-collections__inner">
    <header class="all-collections__header">
      <nav class="all-collections__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}" class="all-collections__breadcrumb-link">Home</a>
        <span class="all-collections__breadcrumb-separator">›</span>
        <span class="all-collections__breadcrumb-current">Collections</span>
      </nav>

      <h1 class="all-collections__title">
        {{ section.settings.heading | default: 'All Collections' }}
      </h1>

      {% if section.settings.subheading != blank %}
        <p class="all-collections__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    <div
      class="collections-grid {{ section.settings.grid_item_width }}"
      style="--grid-gap: {{ section.settings.grid_gap }}px"
    >
      {% for collection in collections %}
        <a class="collection-card" href="{{ collection.url }}">
          {% if collection.featured_image %}
            {% render 'image',
              class: 'collection-card__image',
              image: collection.featured_image,
              width: 600,
              height: 600,
              crop: 'center'
            %}
          {% endif %}

          <div class="collection-card__content">
            <p class="collection-card__title">{{ collection.title }}</p>

            {% if collection.description %}
              <p class="collection-card__description">
                {{ collection.description | strip_html | truncatewords: 15 }}
              </p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .all-collections {
    padding: 56px 0 80px 0;
  }
  .all-collections__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--container-padding);
    box-sizing: border-box;
  }
  .all-collections__header {
    margin-bottom: 28px;
  }
  .all-collections__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    font-size: 13px;
    color: rgba(76, 85, 100, 0.85);
  }
  .all-collections__breadcrumb-link {
    color: inherit;
    text-decoration: none;
  }
  .all-collections__breadcrumb-link:hover {
    text-decoration: underline;
  }
  .all-collections__title {
    margin: 0 0 6px 0;
    font-size: 28px;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .all-collections__subtitle {
    margin: 0;
    font-size: 15px;
    color: rgba(76, 85, 100, 0.9);
    max-width: 640px;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--collection-card-size), 100%), 1fr));
    gap: var(--grid-gap);
  }
  .collections-grid--compact {
    --collection-card-size: 160px;
  }
  .collections-grid--full {
    --collection-card-size: 260px;
  }

  .collection-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 6px 24px rgba(0,0,0,0.06);
    text-decoration: none;
    color: inherit;
  }
  .collection-card__image {
    width: 100%;
    display: block;
  }
  .collection-card__content {
    padding: 14px 14px 16px 14px;
  }
  .collection-card__title {
    margin: 0 0 4px 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }
  .collection-card__description {
    margin: 0;
    font-size: 13px;
    color: rgba(76, 85, 100, 0.9);
  }

  @media (max-width: 768px) {
    .all-collections {
      padding: 40px 0 56px 0;
    }
    .all-collections__title {
      font-size: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Collections"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse all Glamora categories in one place\u2014from everyday skincare essentials to new launches."
    },
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections-grid--compact", "label": "t:options.size.small" },
        { "value": "collections-grid--full", "label": "t:options.size.large" }
      ],
      "default": "collections-grid--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
