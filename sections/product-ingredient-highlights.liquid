{%- comment -%}
  Ingredient highlight section (Key Ingredients)
  Editable via blocks; can be connected to metafields later via dynamic sources.
{%- endcomment -%}

<section class="pdp-ingredients" id="pdp-ingredients-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="pdp-ingredients__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="pdp-ingredients__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <div class="pdp-ingredients__subtitle rte">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    <div class="pdp-ingredients__grid">
      {%- for block in section.blocks -%}
        <div class="pdp-ingredients__card" {{ block.shopify_attributes }}>
          <div class="pdp-ingredients__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 160 }}"
                srcset="{{ block.settings.image | image_url: width: 160 }} 160w, {{ block.settings.image | image_url: width: 240 }} 240w"
                sizes="80px"
                alt="{{ block.settings.image.alt | default: block.settings.name | escape }}"
                width="80"
                height="80"
                loading="lazy"
              >
            {%- else -%}
              <div class="pdp-ingredients__icon" aria-hidden="true">✦</div>
            {%- endif -%}
          </div>
          <div class="pdp-ingredients__meta">
            <div class="pdp-ingredients__name-row">
              <div class="pdp-ingredients__name">{{ block.settings.name }}</div>
              {%- if block.settings.percent != blank -%}
                <div class="pdp-ingredients__percent">{{ block.settings.percent }}</div>
              {%- endif -%}
            </div>
            {%- if block.settings.benefit != blank -%}
              <div class="pdp-ingredients__benefit">{{ block.settings.benefit }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-ingredients {
    width: 100%;
    max-width: 100%;
    padding: 44px var(--container-padding, 20px);
    background: var(--white, #fff);
    box-sizing: border-box;
  }
  .pdp-ingredients__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .pdp-ingredients__title {
    margin: 0 0 10px;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .pdp-ingredients__subtitle {
    margin: 0 0 18px;
    color: rgba(0,0,0,0.65);
    font-size: 13px;
    line-height: 1.6;
  }
  .pdp-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .pdp-ingredients__card {
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 16px;
    padding: 14px;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 12px;
    background: #fff;
  }
  .pdp-ingredients__media {
    width: 80px;
    height: 80px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(0,0,0,0.03);
    display: grid;
    place-items: center;
  }
  .pdp-ingredients__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pdp-ingredients__icon { font-weight: 900; color: rgba(0,0,0,0.35); }
  .pdp-ingredients__name-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: baseline;
  }
  .pdp-ingredients__name { font-weight: 900; font-size: 14px; }
  .pdp-ingredients__percent { font-weight: 900; font-size: 12px; color: rgba(0,0,0,0.55); }
  .pdp-ingredients__benefit { margin-top: 6px; font-size: 13px; color: rgba(0,0,0,0.7); line-height: 1.4; }

  @media (max-width: 900px) {
    .pdp-ingredients__grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Key Ingredients"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subheading",
      "default": "<p>Add a short line about the formulation. You can connect metafields later.</p>"
    }
  ],
  "blocks": [
    {
      "type": "pdp_ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon / image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Ingredient name" },
        { "type": "text", "id": "percent", "label": "Percent (optional)", "default": "2%" },
        { "type": "text", "id": "benefit", "label": "1-line benefit", "default": "Short benefit statement." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Ingredients",
      "blocks": [
        { "type": "pdp_ingredient" },
        { "type": "pdp_ingredient" },
        { "type": "pdp_ingredient" }
      ]
    }
  ]
}
{% endschema %}

