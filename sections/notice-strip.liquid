{%- comment -%} Informational notice strip (GST/price updates etc.) {%- endcomment -%}

{%- if section.settings.text != blank -%}
  <section class="notice-strip" id="notice-strip-{{ section.id }}">
    <div class="notice-strip__inner">
      <div class="notice-strip__text">{{ section.settings.text }}</div>
      {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
        <a class="notice-strip__link" href="{{ section.settings.link_url }}">{{ section.settings.link_text }}</a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .notice-strip {
    background: rgba(21, 115, 109, 0.10);
    border-top: 1px solid rgba(76, 85, 100, 0.16);
    border-bottom: 1px solid rgba(76, 85, 100, 0.16);
  }
  .notice-strip__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 14px var(--container-padding);
    box-sizing: border-box;
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    text-align: center;
  }
  .notice-strip__text {
    font-weight: 700;
    color: var(--text);
    font-size: 13px;
    line-height: 1.35;
  }
  .notice-strip__link {
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
    color: var(--forest-green);
    text-decoration: none;
  }
  .notice-strip__link:hover { text-decoration: underline; }
{% endstylesheet %}

{% schema %}
{
  "name": "Notice strip",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Notice text",
      "default": "<p><strong>Notice:</strong> Subscribe to Glamora updates for launches & offers.</p>"
    },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Know More" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [
    { "name": "Notice strip" }
  ]
}
{% endschema %}

