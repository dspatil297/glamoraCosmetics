{%- comment -%} Full-width image banner (desktop + mobile) {%- endcomment -%}

<section class="promo-banner" id="promo-banner-{{ section.id }}">
  {%- assign mobile_img = section.settings.mobile_image | default: section.settings.image -%}
  {%- assign href = section.settings.href -%}

  {%- if href != blank -%}
    <a class="promo-banner__link" href="{{ href }}">
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    <picture class="promo-banner__picture">
      <source
        media="(max-width: 768px)"
        srcset="
          {{ mobile_img | image_url: width: 480 }} 480w,
          {{ mobile_img | image_url: width: 768 }} 768w,
          {{ mobile_img | image_url: width: 1024 }} 1024w
        "
        sizes="100vw"
      >
      <img
        class="promo-banner__img"
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 1000 }} 1000w,
          {{ section.settings.image | image_url: width: 1400 }} 1400w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt="{{ section.settings.alt | escape }}"
        loading="lazy"
      >
    </picture>
  {%- else -%}
    <div class="promo-banner__placeholder">
      <p>{{ section.settings.placeholder_text | default: 'Add a banner image in Theme Customizer for this section.' }}</p>
    </div>
  {%- endif -%}

  {%- if href != blank -%}
    </a>
  {%- endif -%}
</section>

{% stylesheet %}
  .promo-banner {
    width: 100%;
    margin: 0;
  }
  .promo-banner__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .promo-banner__picture,
  .promo-banner__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .promo-banner__placeholder {
    width: 100%;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 1px dashed rgba(76, 85, 100, 0.35);
    background: rgba(0, 0, 0, 0.02);
    color: rgba(76, 85, 100, 0.75);
    font-size: 13px;
    text-align: center;
    padding: 16px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banner (image)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
    { "type": "url", "id": "href", "label": "Link (optional)" },
    { "type": "text", "id": "alt", "label": "Alt text", "default": "Promotion" },
    { "type": "text", "id": "placeholder_text", "label": "Placeholder (no image)", "default": "Add a banner image in Theme Customizer for this section." }
  ],
  "presets": [
    { "name": "Promo banner (image)" }
  ]
}
{% endschema %}

