{%- comment -%} Full-width image banner (desktop + mobile) {%- endcomment -%}

{%- assign desktop_image = section.settings.image -%}
{%- assign mobile_img = section.settings.mobile_image | default: section.settings.image -%}
{%- assign desktop_ratio = '1920 / 533' -%}
{%- if desktop_image != blank and desktop_image.width and desktop_image.height -%}
  {%- assign desktop_ratio = desktop_image.width | append: ' / ' | append: desktop_image.height -%}
{%- endif -%}
{%- assign mobile_ratio = desktop_ratio -%}
{%- if mobile_img != blank and mobile_img.width and mobile_img.height -%}
  {%- assign mobile_ratio = mobile_img.width | append: ' / ' | append: mobile_img.height -%}
{%- endif -%}

<section
  class="promo-banner"
  id="promo-banner-{{ section.id }}"
  style="--promo-banner-desktop-ratio: {{ desktop_ratio }}; --promo-banner-mobile-ratio: {{ mobile_ratio }}; --promo-banner-max-height: {{ section.settings.max_height_desktop }}px; --promo-banner-max-height-mobile: {{ section.settings.max_height_mobile }}px;"
>
  {%- assign href = section.settings.href -%}

  {%- if href != blank -%}
    <a class="promo-banner__link" href="{{ href }}">
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    <picture class="promo-banner__picture">
      <source
        media="(max-width: 768px)"
        srcset="
          {{ mobile_img | image_url: width: 480 }} 480w,
          {{ mobile_img | image_url: width: 768 }} 768w
        "
        sizes="100vw"
      >
      <img
        class="promo-banner__img"
        src="{{ section.settings.image | image_url: width: 1280 }}"
        srcset="
          {{ section.settings.image | image_url: width: 960 }} 960w,
          {{ section.settings.image | image_url: width: 1280 }} 1280w,
          {{ section.settings.image | image_url: width: 1440 }} 1440w
        "
        sizes="100vw"
        alt="{{ section.settings.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        decoding="async"
        loading="lazy"
      >
    </picture>
  {%- else -%}
    <div class="promo-banner__placeholder promo-banner__placeholder--img">
      {% render 'unsplash-placeholder', type: 'banner', width: 1280, class: 'promo-banner__img', loading: 'lazy', alt: 'Banner placeholder' %}
    </div>
  {%- endif -%}

  {%- if href != blank -%}
    </a>
  {%- endif -%}
</section>

{% stylesheet %}
  .promo-banner {
    width: 100vw;
    max-width: 100%;
    aspect-ratio: var(--promo-banner-desktop-ratio, 1920 / 533);
    max-height: var(--promo-banner-max-height, 420px);
    height: auto;
    margin: 0;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow: hidden;
    box-sizing: border-box;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .promo-banner__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .promo-banner__picture {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .promo-banner__img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .promo-banner__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 1px dashed rgba(76, 85, 100, 0.35);
    background: rgba(0, 0, 0, 0.02);
    color: rgba(76, 85, 100, 0.75);
    font-size: 13px;
    text-align: center;
    padding: 16px;
    box-sizing: border-box;
  }

  .promo-banner__placeholder--img {
    padding: 0;
    overflow: hidden;
    border-radius: 0;
  }

  .promo-banner__placeholder--img img {
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .promo-banner {
      aspect-ratio: var(--promo-banner-mobile-ratio, 1920 / 533);
      max-height: var(--promo-banner-max-height-mobile, 280px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banner (image)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
    { "type": "range", "id": "max_height_desktop", "label": "Desktop max height", "min": 120, "max": 900, "step": 10, "unit": "px", "default": 420 },
    { "type": "range", "id": "max_height_mobile", "label": "Mobile max height", "min": 80, "max": 500, "step": 10, "unit": "px", "default": 220 },
    { "type": "url", "id": "href", "label": "Link (optional)" },
    { "type": "text", "id": "alt", "label": "Alt text", "default": "Promotion" },
    { "type": "text", "id": "placeholder_text", "label": "Placeholder (no image)", "default": "Add a banner image in Theme Customizer for this section." }
  ],
  "presets": [
    { "name": "Promo banner (image)" }
  ]
}
{% endschema %}

