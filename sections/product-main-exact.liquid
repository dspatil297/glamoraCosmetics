{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_image | default: product.featured_image
  assign product_subtitle = product.metafields.custom.product_subtitle.value | default: product.metafields.descriptors.subtitle.value | default: product.metafields.custom.card_subtitle.value | strip
  assign form_id = 'gx-form-' | append: section.id
  assign compare = current_variant.compare_at_price
  assign price = current_variant.price
  assign has_discount = false
  assign discount_pct = 0
  if compare != blank and compare > price
    assign has_discount = true
    assign discount_pct = compare | minus: price | times: 100 | divided_by: compare | round
  endif

  assign gx_routine_step = 0
  case product.handle
    when 'glamora-pollution-control-face-wash', 'glamora-pollution-control-foaming-face-wash'
      assign gx_routine_step = 1
    when 'glamora-pollution-control-moisturizing-spray'
      assign gx_routine_step = 2
    when 'glamora-pollution-control-hybrid-sunscreen'
      assign gx_routine_step = 3
  endcase

  assign efficacy_raw = product.metafields.custom.product_efficacy_stats.value | default: product.metafields.custom.product_efficacy_stats | default: '' | strip
  assign efficacy_heading = 'Proven to protect your skin'
  assign efficacy_sub = ''
  assign efficacy_source = ''
  assign efficacy_card_1 = ''
  assign efficacy_card_2 = ''
  assign efficacy_card_3 = ''
  assign efficacy_card_4 = ''
  assign ideal_raw = product.metafields.custom.product_ideal_for_section.value | default: product.metafields.custom.product_ideal_for_section | default: '' | strip
  assign ideal_header = 'Is this right for your skin?'
  assign ideal_desc = 'Designed for anyone who lives, commutes, or works in a polluted city.'
  assign ideal_concern_1 = ''
  assign ideal_concern_2 = ''
  assign ideal_concern_3 = ''
  assign ideal_concern_4 = ''
  assign ideal_skin_tags = ''
  assign ideal_info_box_1 = ''
  assign ideal_info_box_2 = ''

  if efficacy_raw != blank
    assign efficacy_normalized = efficacy_raw | newline_to_br | replace: '<br>', '<br />' | replace: '<br/>', '<br />' | replace: '• Card', '<br />• Card'
    assign efficacy_lines = efficacy_normalized | split: '<br />'
    for line in efficacy_lines
      assign clean_line = line | strip
      if clean_line != blank
        if clean_line contains 'Header:'
          assign efficacy_heading = clean_line | remove_first: 'Header:' | strip
        elsif clean_line contains 'Sub:'
          assign efficacy_sub = clean_line | remove_first: 'Sub:' | strip
        elsif clean_line contains 'Sub title:'
          assign efficacy_sub = clean_line | remove_first: 'Sub title:' | strip
        elsif clean_line contains 'Source:'
          assign efficacy_source = clean_line | remove_first: 'Source:' | strip
        elsif clean_line contains 'Card 1:'
          assign efficacy_card_1 = clean_line | remove: '•' | remove_first: 'Card 1:' | strip
        elsif clean_line contains 'Card 2:'
          assign efficacy_card_2 = clean_line | remove: '•' | remove_first: 'Card 2:' | strip
        elsif clean_line contains 'Card 3:'
          assign efficacy_card_3 = clean_line | remove: '•' | remove_first: 'Card 3:' | strip
        elsif clean_line contains 'Card 4:'
          assign efficacy_card_4 = clean_line | remove: '•' | remove_first: 'Card 4:' | strip
        endif
      endif
    endfor
  endif

  if ideal_raw != blank
    assign ideal_normalized = ideal_raw | newline_to_br | replace: '<br>', '<br />' | replace: '<br/>', '<br />'
    assign ideal_lines = ideal_normalized | split: '<br />'
    assign current_ideal_field = ''
    for line in ideal_lines
      assign clean_line = line | strip
      if clean_line != blank
        if clean_line contains 'Header:'
          assign ideal_header = clean_line | remove_first: 'Header:' | strip
          assign current_ideal_field = 'header'
        elsif clean_line contains 'Desc:'
          assign ideal_desc = clean_line | remove_first: 'Desc:' | strip
          assign current_ideal_field = 'desc'
        elsif clean_line contains 'Concern 1:'
          assign ideal_concern_1 = clean_line | remove: '•' | remove_first: 'Concern 1:' | strip
          assign current_ideal_field = 'concern_1'
        elsif clean_line contains 'Concern 2:'
          assign ideal_concern_2 = clean_line | remove: '•' | remove_first: 'Concern 2:' | strip
          assign current_ideal_field = 'concern_2'
        elsif clean_line contains 'Concern 3:'
          assign ideal_concern_3 = clean_line | remove: '•' | remove_first: 'Concern 3:' | strip
          assign current_ideal_field = 'concern_3'
        elsif clean_line contains 'Concern 4:'
          assign ideal_concern_4 = clean_line | remove: '•' | remove_first: 'Concern 4:' | strip
          assign current_ideal_field = 'concern_4'
        elsif clean_line contains 'Skin tags:'
          assign ideal_skin_tags = clean_line | remove_first: 'Skin tags:' | strip
          assign current_ideal_field = 'skin_tags'
        elsif clean_line contains 'Info box 1:'
          assign ideal_info_box_1 = clean_line | remove_first: 'Info box 1:' | strip
          assign current_ideal_field = 'info_box_1'
        elsif clean_line contains 'Info box 2:'
          assign ideal_info_box_2 = clean_line | remove_first: 'Info box 2:' | strip
          assign current_ideal_field = 'info_box_2'
        elsif current_ideal_field == 'desc'
          assign ideal_desc = ideal_desc | append: ' ' | append: clean_line
        elsif current_ideal_field == 'concern_1'
          assign ideal_concern_1 = ideal_concern_1 | append: ' ' | append: clean_line
        elsif current_ideal_field == 'concern_2'
          assign ideal_concern_2 = ideal_concern_2 | append: ' ' | append: clean_line
        elsif current_ideal_field == 'concern_3'
          assign ideal_concern_3 = ideal_concern_3 | append: ' ' | append: clean_line
        elsif current_ideal_field == 'concern_4'
          assign ideal_concern_4 = ideal_concern_4 | append: ' ' | append: clean_line
        elsif current_ideal_field == 'skin_tags'
          assign ideal_skin_tags = ideal_skin_tags | append: ' ' | append: clean_line
        elsif current_ideal_field == 'info_box_1'
          assign ideal_info_box_1 = ideal_info_box_1 | append: ' ' | append: clean_line
        elsif current_ideal_field == 'info_box_2'
          assign ideal_info_box_2 = ideal_info_box_2 | append: ' ' | append: clean_line
        endif
      endif
    endfor
  endif
-%}

<section class="gx-pdp" id="gx-pdp-{{ section.id }}">
  <div class="gx-container">
    <div class="gx-breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="gx-sep">/</span>
      <span>{{ product.title }}</span>
    </div>

    <div class="gx-product-layout">
      <div class="gx-gallery">
        <div class="gx-gallery-main-shell">
          <div class="gx-gallery-main-core">
            {%- if featured -%}
              <img src="{{ featured | image_url: width: 1400 }}" alt="{{ product.title | escape }}" id="gxMainImg-{{ section.id }}" width="{{ featured.width }}" height="{{ featured.height }}" loading="eager" fetchpriority="high" decoding="async">
            {%- endif -%}
          </div>
        </div>
        {%- if product.images.size > 1 -%}
          <div class="gx-gallery-thumbs">
            {%- for image in product.images -%}
              <button type="button" class="gx-gallery-thumb{% if image.id == featured.id %} active{% elsif featured == blank and forloop.first %} active{% endif %}" data-gx-thumb data-src="{{ image | image_url: width: 1400 }}" aria-label="Image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 220 }}" alt="" width="110" height="110" loading="lazy" decoding="async">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="gx-product-info">
        {%- if gx_routine_step > 0 -%}
          <div class="gx-routine-badge"><span class="gx-routine-badge-num">{{ gx_routine_step }}</span>Step {{ gx_routine_step }} of the 3-Step Routine</div>
        {%- endif -%}
        <h1>{{ product.title }}</h1>
        {%- if product_subtitle != blank -%}<p class="gx-product-subtitle">{{ product_subtitle }}</p>{%- endif -%}

        <div class="gx-product-ratings">
          <div class="gx-stars">★★★★☆</div>
          <span class="gx-rating-score">{{ section.settings.rating_text }}</span>
          <a href="#gx-reviews-{{ section.id }}" class="gx-rating-count">{{ section.settings.review_count_text }}</a>
        </div>

        <div class="gx-pricing">
          <div class="gx-pricing-row">
            <span class="gx-price-current" data-gx-price>{{ price | money }}</span>
            <span class="gx-price-original{% unless has_discount %} gx-hidden{% endunless %}" data-gx-compare>{% if has_discount %}{{ compare | money }}{% endif %}</span>
            <span class="gx-price-discount{% unless has_discount %} gx-hidden{% endunless %}" data-gx-discount>{% if has_discount %}{{ discount_pct }}% Off{% endif %}</span>
          </div>
          <div class="gx-price-meta">
            <span class="gx-price-tax">{{ section.settings.tax_text }}</span>
          </div>
        </div>

        <div class="gx-love-it">
          <div class="gx-love-title">Why you'll love it</div>
          <ul>
            <li>Removes pollutant particles and deep grime</li>
            <li>Brightens and evens tone over consistent use</li>
            <li>Cleanses without post-wash tightness</li>
            <li>Safe for daily use across skin types</li>
          </ul>
        </div>

        <div class="gx-stock"><span class="gx-stock-dot"></span>In stock - ships within 24 hours</div>

        {%- form 'product', product, id: form_id, class: 'gx-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-gx-variant-id>
          {%- if product.variants.size > 1 -%}
            <select name="id" class="gx-variant-select" data-gx-variant-select>
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>
              {%- endfor -%}
            </select>
          {%- endif -%}

          <div class="gx-quantity-row" id="gxCartActions-{{ section.id }}">
            <div class="gx-qty-selector">
              <button type="button" class="gx-qty-btn" data-gx-qty="minus">-</button>
              <input class="gx-qty-val" type="number" name="quantity" value="1" min="1">
              <button type="button" class="gx-qty-btn" data-gx-qty="plus">+</button>
            </div>
            <button type="submit" name="add" class="gx-btn-add-cart">Add to Cart</button>
          </div>
          <div class="gx-buy-now">{{ form | payment_button }}</div>
        {%- endform -%}
      </div>
    </div>
  </div>

  <section class="gx-band">
    <div class="gx-container">
      <h2>{{ efficacy_heading }}</h2>
      {%- if efficacy_sub != blank -%}<p class="gx-efficacy-sub">{{ efficacy_sub }}</p>{%- endif -%}
      <div class="gx-stats">
        {%- assign card_1_parts = efficacy_card_1 | split: '—' -%}
        {%- assign card_1_value = card_1_parts.first | strip -%}
        {%- assign card_1_label = efficacy_card_1 | remove_first: card_1_parts.first | remove_first: '—' | strip -%}
        <div>
          <strong>{% if card_1_value != blank %}{{ card_1_value }}{% else %}99.9%{% endif %}</strong>
          <span>{% if card_1_label != blank %}{{ card_1_label }}{% else %}Pollution particles removed{% endif %}</span>
        </div>

        {%- assign card_2_parts = efficacy_card_2 | split: '—' -%}
        {%- assign card_2_value = card_2_parts.first | strip -%}
        {%- assign card_2_label = efficacy_card_2 | remove_first: card_2_parts.first | remove_first: '—' | strip -%}
        <div>
          <strong>{% if card_2_value != blank %}{{ card_2_value }}{% else %}88%{% endif %}</strong>
          <span>{% if card_2_label != blank %}{{ card_2_label }}{% else %}Brighter skin in 14 days{% endif %}</span>
        </div>

        {%- assign card_3_parts = efficacy_card_3 | split: '—' -%}
        {%- assign card_3_value = card_3_parts.first | strip -%}
        {%- assign card_3_label = efficacy_card_3 | remove_first: card_3_parts.first | remove_first: '—' | strip -%}
        <div>
          <strong>{% if card_3_value != blank %}{{ card_3_value }}{% else %}93%{% endif %}</strong>
          <span>{% if card_3_label != blank %}{{ card_3_label }}{% else %}No post-wash dryness{% endif %}</span>
        </div>

        {%- assign card_4_parts = efficacy_card_4 | split: '—' -%}
        {%- assign card_4_value = card_4_parts.first | strip -%}
        {%- assign card_4_label = efficacy_card_4 | remove_first: card_4_parts.first | remove_first: '—' | strip -%}
        <div>
          <strong>{% if card_4_value != blank %}{{ card_4_value }}{% else %}4.4{% endif %}</strong>
          <span>{% if card_4_label != blank %}{{ card_4_label }}{% else %}Average review rating{% endif %}</span>
        </div>
      </div>
      {%- if efficacy_source != blank -%}<p class="gx-efficacy-source">{{ efficacy_source }}</p>{%- endif -%}
    </div>
  </section>

  <section class="gx-section">
    <div class="gx-container">
      <h2>Clean science. Real results.</h2>
      <div class="gx-cards">
        <article><h4>Glutathione</h4><p>Neutralizes pollution-driven free radicals and supports brighter skin.</p></article>
        <article><h4>Kojic Acid</h4><p>Targets uneven tone and dark spots caused by environmental stress.</p></article>
        <article><h4>Vitamin C</h4><p>Helps fight oxidative damage from city exposure and dullness.</p></article>
        <article><h4>Hyaluronic Acid</h4><p>Maintains hydration while cleansing to avoid tightness.</p></article>
      </div>
    </div>
  </section>

  <section class="gx-section gx-alt">
    <div class="gx-container">
      <h2>How to use</h2>
      <div class="gx-steps">
        <article><span>1</span><h4>Wet your face</h4></article>
        <article><span>2</span><h4>Massage for 45-60s</h4></article>
        <article><span>3</span><h4>Rinse with water</h4></article>
        <article><span>4</span><h4>Continue routine</h4></article>
      </div>
    </div>
  </section>

  <section class="gx-ideal gx-alt">
    <div class="gx-container">
      <div class="gx-ideal-grid">
        <div class="gx-ideal-content">
          <h2>{{ ideal_header }}</h2>
          <p>{{ ideal_desc }}</p>

          <ul class="gx-concern-list">
            {%- assign concern_1_parts = ideal_concern_1 | split: '—' -%}
            {%- assign concern_1_title = concern_1_parts.first | strip -%}
            {%- assign concern_1_desc = ideal_concern_1 | remove_first: concern_1_parts.first | remove_first: '—' | strip -%}
            <li class="gx-concern-item">
              <div class="gx-concern-icon"></div>
              <div>
                <h4>{% if concern_1_title != blank %}{{ concern_1_title }}{% else %}Dull, tired-looking skin{% endif %}</h4>
                <p>{% if concern_1_desc != blank %}{{ concern_1_desc }}{% else %}Pollution deposits a layer of grime that makes skin look lifeless.{% endif %}</p>
              </div>
            </li>

            {%- assign concern_2_parts = ideal_concern_2 | split: '—' -%}
            {%- assign concern_2_title = concern_2_parts.first | strip -%}
            {%- assign concern_2_desc = ideal_concern_2 | remove_first: concern_2_parts.first | remove_first: '—' | strip -%}
            <li class="gx-concern-item">
              <div class="gx-concern-icon"></div>
              <div>
                <h4>{% if concern_2_title != blank %}{{ concern_2_title }}{% else %}Acne and clogged pores{% endif %}</h4>
                <p>{% if concern_2_desc != blank %}{{ concern_2_desc }}{% else %}Fine pollution particles can settle deep and trigger breakouts.{% endif %}</p>
              </div>
            </li>

            {%- assign concern_3_parts = ideal_concern_3 | split: '—' -%}
            {%- assign concern_3_title = concern_3_parts.first | strip -%}
            {%- assign concern_3_desc = ideal_concern_3 | remove_first: concern_3_parts.first | remove_first: '—' | strip -%}
            <li class="gx-concern-item">
              <div class="gx-concern-icon"></div>
              <div>
                <h4>{% if concern_3_title != blank %}{{ concern_3_title }}{% else %}Dark spots and uneven tone{% endif %}</h4>
                <p>{% if concern_3_desc != blank %}{{ concern_3_desc }}{% else %}Targeted actives help with pollution-linked pigmentation.{% endif %}</p>
              </div>
            </li>

            {%- assign concern_4_parts = ideal_concern_4 | split: '—' -%}
            {%- assign concern_4_title = concern_4_parts.first | strip -%}
            {%- assign concern_4_desc = ideal_concern_4 | remove_first: concern_4_parts.first | remove_first: '—' | strip -%}
            <li class="gx-concern-item">
              <div class="gx-concern-icon"></div>
              <div>
                <h4>{% if concern_4_title != blank %}{{ concern_4_title }}{% else %}Post-wash dryness{% endif %}</h4>
                <p>{% if concern_4_desc != blank %}{{ concern_4_desc }}{% else %}Hydrating support helps prevent stripped, tight skin.{% endif %}</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="gx-ideal-side">
          <p class="gx-ideal-side-title">Works for all skin types</p>
          <div class="gx-skin-types">
            {%- assign skin_tag_items = ideal_skin_tags | split: ',' -%}
            {%- for skin_tag in skin_tag_items -%}
              {%- assign skin_label = skin_tag | strip -%}
              {%- assign is_active = false -%}
              {%- if skin_label contains '(active)' -%}
                {%- assign is_active = true -%}
                {%- assign skin_label = skin_label | remove: '(active)' | strip -%}
              {%- endif -%}
              {%- if skin_label != blank -%}
                <span class="gx-skin-tag{% if is_active %} active{% endif %}">{{ skin_label }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- assign info_1_parts = ideal_info_box_1 | split: '—' -%}
          {%- assign info_1_title = info_1_parts.first | remove: '"' | strip -%}
          {%- assign info_1_desc = ideal_info_box_1 | remove_first: info_1_parts.first | remove_first: '—' | strip -%}
          <div class="gx-info-box">
            <p class="gx-info-box-title">{% if info_1_title != blank %}{{ info_1_title }}{% else %}pH 5.5 Balanced{% endif %}</p>
            <p class="gx-info-box-text">{% if info_1_desc != blank %}{{ info_1_desc }}{% else %}Matches your skin's natural acidity while cleansing gently.{% endif %}</p>
          </div>

          {%- assign info_2_parts = ideal_info_box_2 | split: '—' -%}
          {%- assign info_2_title = info_2_parts.first | remove: '"' | strip -%}
          {%- assign info_2_desc = ideal_info_box_2 | remove_first: info_2_parts.first | remove_first: '—' | strip -%}
          <div class="gx-info-box gx-info-box-tight">
            <p class="gx-info-box-title">{% if info_2_title != blank %}{{ info_2_title }}{% else %}Free From{% endif %}</p>
            <p class="gx-info-box-text">{% if info_2_desc != blank %}{{ info_2_desc }}{% else %}Parabens, Sulfates, Silicones, Mineral Oil, Artificial Fragrance, Phthalates{% endif %}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="gx-section" id="gx-reviews-{{ section.id }}">
    <div class="gx-container">
      <h2>Real people. Real city skin.</h2>
      <div class="gx-reviews">
        <article><p>"Visible brightness in 2 weeks. Skin feels cleaner every evening."</p><strong>Priya M.</strong></article>
        <article><p>"Removes deep grime without drying me out. Finally a cleanser that works."</p><strong>Anika T.</strong></article>
        <article><p>"Great daily face wash for commute-heavy city life."</p><strong>Sneha R.</strong></article>
      </div>
    </div>
  </section>

  <section class="gx-section gx-alt">
    <div class="gx-container gx-faq">
      <h2>Frequently asked questions</h2>
      <details><summary>Can I use this twice daily?</summary><p>Yes, this formula is designed for daily AM/PM cleansing.</p></details>
      <details><summary>Will it dry out my skin?</summary><p>Hydrating actives help prevent the stripped feeling after wash.</p></details>
      <details><summary>How long before results are visible?</summary><p>Most users notice cleaner feel immediately and visible brightness in 2-4 weeks.</p></details>
    </div>
  </section>

  <div class="gx-sticky" id="gxSticky-{{ section.id }}">
    <div class="gx-container gx-sticky-inner">
      <div class="gx-sticky-price" data-gx-sticky-price>{{ price | money }}</div>
      <button type="submit" form="{{ form_id }}" name="add" class="gx-sticky-btn">Add to Cart</button>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('gx-pdp-{{ section.id }}');
    if (!root) return;

    var mainImg = root.querySelector('#gxMainImg-{{ section.id }}');
    var thumbs = root.querySelectorAll('[data-gx-thumb]');
    for (var i = 0; i < thumbs.length; i++) {
      thumbs[i].addEventListener('click', function () {
        var src = this.getAttribute('data-src');
        if (mainImg && src) mainImg.src = src;
        for (var j = 0; j < thumbs.length; j++) thumbs[j].classList.remove('active');
        this.classList.add('active');
      });
    }

    var qtyBtns = root.querySelectorAll('[data-gx-qty]');
    for (var k = 0; k < qtyBtns.length; k++) {
      qtyBtns[k].addEventListener('click', function () {
        var input = root.querySelector('.gx-qty-val');
        if (!input) return;
        var v = parseInt(input.value, 10) || 1;
        if (this.getAttribute('data-gx-qty') === 'plus') v++;
        if (this.getAttribute('data-gx-qty') === 'minus') v = Math.max(1, v - 1);
        input.value = v;
      });
    }

    var select = root.querySelector('[data-gx-variant-select]');
    var hiddenId = root.querySelector('[data-gx-variant-id]');
    var priceEl = root.querySelector('[data-gx-price]');
    var compareEl = root.querySelector('[data-gx-compare]');
    var discountEl = root.querySelector('[data-gx-discount]');
    var stickyPriceEl = root.querySelector('[data-gx-sticky-price]');

    function formatMoney(cents) {
      var n = parseInt(cents, 10);
      if (isNaN(n)) return '';
      return 'Rs. ' + (n / 100).toFixed(2);
    }

    function updatePrice(option) {
      if (!option) return;
      var p = parseInt(option.getAttribute('data-price') || '0', 10);
      var c = parseInt(option.getAttribute('data-compare') || '0', 10);
      if (hiddenId) hiddenId.value = option.value;
      if (priceEl) priceEl.textContent = formatMoney(p);
      if (stickyPriceEl) stickyPriceEl.textContent = formatMoney(p);
      if (c > p) {
        if (compareEl) {
          compareEl.textContent = formatMoney(c);
          compareEl.classList.remove('gx-hidden');
        }
        if (discountEl) {
          discountEl.textContent = Math.round(((c - p) / c) * 100) + '% Off';
          discountEl.classList.remove('gx-hidden');
        }
      } else {
        if (compareEl) compareEl.classList.add('gx-hidden');
        if (discountEl) discountEl.classList.add('gx-hidden');
      }
    }

    if (select) {
      updatePrice(select.options[select.selectedIndex]);
      select.addEventListener('change', function () {
        updatePrice(this.options[this.selectedIndex]);
      });
    }

    var cartAnchor = root.querySelector('#gxCartActions-{{ section.id }}');
    var sticky = root.querySelector('#gxSticky-{{ section.id }}');
    if (cartAnchor && sticky && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          sticky.classList.toggle('visible', !entry.isIntersecting);
        });
      }, { threshold: 0 });
      io.observe(cartAnchor);
    }
  })();
</script>

{% stylesheet %}
  .gx-pdp { --font-body: 'Outfit', -apple-system, sans-serif; background: #fafaf7; color: #141413; }
  .gx-container { max-width: 1360px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
  .gx-breadcrumb { padding: 20px 0; font-size: 14px; color: #8a8985; }
  .gx-breadcrumb a { color: #8a8985; text-decoration: none; }
  .gx-sep { margin: 0 8px; }
  .gx-product-layout { display: grid; grid-template-columns: 1.1fr .9fr; gap: 14px; padding-bottom: clamp(60px, 8vw, 100px); align-items: start; }
  .gx-gallery { position: sticky; top: 100px; }
  .gx-gallery-main-shell { background: rgba(0,0,0,.015); border: 1px solid #f0ede8; padding: 6px; border-radius: 2rem; margin-bottom: 16px; max-width: 540px; margin-left: auto; margin-right: auto; }
  .gx-gallery-main-core { border-radius: calc(2rem - 6px); overflow: hidden; aspect-ratio: 1; background: #f3f1ed; }
  .gx-gallery-main-core img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gx-gallery-thumbs { display: flex; gap: 10px; max-width: 540px; margin: 0 auto; }
  .gx-gallery-thumb { flex: 1; border: 2px solid transparent; border-radius: .75rem; overflow: hidden; opacity: .55; background: #f3f1ed; cursor: pointer; }
  .gx-gallery-thumb img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
  .gx-gallery-thumb.active { border-color: #0d8b7d; opacity: 1; }
  .gx-product-info h1 { font-family: "Fraunces", Georgia, serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 600; line-height: 1.15; margin-bottom: 6px; }
  .gx-routine-badge { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; border-radius: 100px; background: #ebf5f3; color: #0d8b7d; margin-bottom: 16px; font-size: 13px; font-weight: 600; }
  .gx-routine-badge-num { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: #0d8b7d; color: #fff; font-size: 12px; font-weight: 700; }
  .gx-product-subtitle { font-family: var(--font-body); font-size: 16px; color: #5c5b57; margin-bottom: 6px; line-height: 1.4; }
  .gx-product-ratings { display: flex; align-items: center; gap: 12px; margin-top: 0; margin-bottom: 24px; padding-top: 0; padding-bottom: 24px; border-bottom: 1px solid #f0ede8; }
  .gx-stars { color: #f5a623; }
  .gx-rating-score { font-size: 15px; font-weight: 600; }
  .gx-rating-count { font-size: 14px; color: #0d8b7d; text-decoration: none; }
  .gx-pricing-row { display: flex; align-items: baseline; gap: 12px; }
  .gx-price-current { font-family: "Fraunces", Georgia, serif; font-size: 38px; font-weight: 600; }
  .gx-price-original { color: #8a8985; text-decoration: line-through; }
  .gx-price-discount { background: #0d8b7d; color: #fff; border-radius: 999px; padding: 4px 10px; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; }
  .gx-price-meta { margin: 6px 0 16px; color: #8a8985; font-size: 14px; }
  .gx-love-it { padding: 20px 24px; background: #ebf5f3; border: 1px solid rgba(13,139,125,.08); border-radius: 1rem; margin-bottom: 18px; }
  .gx-love-title { font-size: 13px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #0d8b7d; margin-bottom: 10px; }
  .gx-love-it ul { margin: 0; padding-left: 18px; }
  .gx-love-it li { margin: 6px 0; color: #141413; }
  .gx-stock { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; color: #5c5b57; font-size: 14px; }
  .gx-stock-dot { width: 8px; height: 8px; background: #0d8b7d; border-radius: 50%; }
  .gx-variant-select { width: 100%; margin: 0 0 12px; border: 1px solid #e8e6e1; border-radius: 10px; padding: 12px; background: #fff; }
  .gx-quantity-row { display: flex; gap: 12px; }
  .gx-qty-selector { display: flex; align-items: center; border: 1px solid #e8e6e1; border-radius: 12px; overflow: hidden; }
  .gx-qty-btn { width: 46px; height: 52px; border: 0; background: #fafaf7; font-size: 18px; cursor: pointer; }
  .gx-qty-val { width: 58px; height: 52px; border: 0; text-align: center; font-weight: 600; }
  .gx-btn-add-cart { flex: 1; border: 0; border-radius: 12px; background: #141413; color: #fff; font-size: 15px; font-weight: 600; padding: 14px 20px; cursor: pointer; }
  .gx-buy-now { margin-top: 10px; }
  .gx-buy-now > * { width: 100%; }
  .gx-band { background: #141413; color: #fff; padding: clamp(64px, 8vw, 100px) 0; }
  .gx-band h2, .gx-section h2 { font-family: "Fraunces", Georgia, serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 600; margin-bottom: 24px; }
  .gx-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .gx-stats div { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.06); border-radius: 1rem; padding: 24px; }
  .gx-stats strong { display: block; font-size: 38px; color: #c5a44e; font-family: "Fraunces", Georgia, serif; }
  .gx-stats span { color: rgba(255,255,255,.65); font-size: 14px; }
  .gx-efficacy-sub { color: rgba(255,255,255,.7); font-size: 17px; line-height: 1.65; max-width: 72ch; margin: -8px 0 22px; }
  .gx-efficacy-source { color: rgba(255,255,255,.5); font-size: 13px; margin-top: 18px; }
  .gx-section { padding: clamp(72px, 9vw, 120px) 0; }
  .gx-alt { background: #f3f1ed; }
  .gx-cards, .gx-steps, .gx-reviews { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .gx-cards article, .gx-steps article, .gx-reviews article { background: #fff; border: 1px solid #f0ede8; border-radius: 1rem; padding: 24px; }
  .gx-steps span { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: #0d8b7d; color: #fff; margin-bottom: 10px; }
  .gx-ideal { padding: clamp(64px, 8vw, 100px) 0; }
  .gx-ideal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 6vw, 80px); align-items: center; }
  .gx-ideal-content h2 { margin-bottom: 14px; }
  .gx-ideal-content > p { color: #5c5b57; margin: 0 0 24px; line-height: 1.7; }
  .gx-concern-list { list-style: none; margin: 0; padding: 0; }
  .gx-concern-item { display: flex; gap: 14px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid #e8e6e1; }
  .gx-concern-item:last-child { border-bottom: 0; }
  .gx-concern-icon { width: 38px; height: 38px; border-radius: 10px; background: #ebf5f3; flex-shrink: 0; margin-top: 2px; }
  .gx-concern-item h4 { margin: 0 0 3px; font-size: 15px; font-weight: 600; }
  .gx-concern-item p { margin: 0; color: #5c5b57; font-size: 14px; line-height: 1.55; }
  .gx-ideal-side-title { font-family: "Fraunces", Georgia, serif; font-size: 18px; font-weight: 600; margin: 0 0 18px; }
  .gx-skin-types { display: flex; flex-wrap: wrap; gap: 10px; }
  .gx-skin-tag { padding: 10px 18px; border-radius: 999px; border: 1px solid #e8e6e1; background: #fff; color: #5c5b57; font-size: 14px; font-weight: 500; }
  .gx-skin-tag.active { border-color: #0d8b7d; background: #ebf5f3; color: #0d8b7d; font-weight: 600; }
  .gx-info-box { margin-top: 24px; padding: 20px; background: #fff; border: 1px solid #f0ede8; border-radius: 1rem; }
  .gx-info-box-tight { margin-top: 12px; }
  .gx-info-box-title { margin: 0 0 4px; font-size: 14px; font-weight: 600; color: #141413; }
  .gx-info-box-text { margin: 0; font-size: 14px; line-height: 1.6; color: #5c5b57; }
  .gx-reviews { grid-template-columns: repeat(3, 1fr); }
  .gx-faq { max-width: 780px; }
  .gx-faq details { border-bottom: 1px solid #e8e6e1; padding: 16px 0; }
  .gx-faq summary { cursor: pointer; font-weight: 600; }
  .gx-faq p { margin: 10px 0 0; color: #5c5b57; }
  .gx-sticky { position: fixed; left: 0; right: 0; bottom: 0; background: rgba(250,250,247,.95); backdrop-filter: blur(10px); border-top: 1px solid #e8e6e1; transform: translateY(100%); transition: transform .35s ease; z-index: 80; }
  .gx-sticky.visible { transform: translateY(0); }
  .gx-sticky-inner { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding-top: 10px; padding-bottom: 10px; }
  .gx-sticky-price { font-size: 18px; font-weight: 700; }
  .gx-sticky-btn { border: 0; border-radius: 999px; background: #0d8b7d; color: #fff; padding: 12px 20px; font-weight: 600; cursor: pointer; }
  .gx-hidden { display: none !important; }
  @media (max-width: 1024px) {
    .gx-product-layout { grid-template-columns: 1fr; }
    .gx-gallery { position: static; }
    .gx-stats, .gx-cards, .gx-steps { grid-template-columns: repeat(2, 1fr); }
    .gx-ideal-grid { grid-template-columns: 1fr; }
    .gx-reviews { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .gx-quantity-row { flex-direction: column; }
    .gx-stats, .gx-cards, .gx-steps { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

