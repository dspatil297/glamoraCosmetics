{% comment %}
  Blog listing page (Knowledge)
  - Featured article + grid layout
  - Filter chips by tag (All / tags)
  - Matches beminimalist "Knowledge" structure
{% endcomment %}

<section class="blog-page" id="blog-page">
  <div class="blog-page__inner">
    <header class="blog-page__header">
      <nav class="blog-page__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}" class="blog-page__breadcrumb-link">Home</a>
        <span class="blog-page__breadcrumb-sep">/</span>
        <span class="blog-page__breadcrumb-current">{{ section.settings.heading | default: blog.title }}</span>
      </nav>
      <h1 class="blog-page__title">{{ section.settings.heading | default: blog.title }}</h1>
      {% if section.settings.subtitle != blank %}
        <p class="blog-page__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </header>

    {%- assign all_tags = blog.all_tags -%}
    {% if all_tags and all_tags.size > 0 %}
      <div class="blog-page__filters" aria-label="Article categories">
        <a href="{{ blog.url }}" class="blog-filter-chip{% if current_tags == blank %} blog-filter-chip--active{% endif %}">All</a>
        {% for tag in all_tags %}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="blog-filter-chip{% if current_tags contains tag %} blog-filter-chip--active{% endif %}">{{ tag }}</a>
        {% endfor %}
      </div>
    {% endif %}

    {% paginate blog.articles by section.settings.articles_per_page %}
      {% if blog.articles_count > 0 %}
        {% assign featured_article = blog.articles.first %}
        {% assign featured_word_count = featured_article.content | strip_html | split: ' ' | size %}
        {% assign featured_read_mins = featured_word_count | divided_by: 200 | at_least: 1 %}
        <article class="blog-featured" aria-label="Featured article">
          <a href="{{ featured_article.url }}" class="blog-featured__link">
            {% if featured_article.image %}
              <div class="blog-featured__media">
                <img
                  src="{{ featured_article.image | image_url: width: 1600 }}"
                  srcset="{{ featured_article.image | image_url: width: 800 }} 800w, {{ featured_article.image | image_url: width: 1200 }} 1200w, {{ featured_article.image | image_url: width: 1600 }} 1600w"
                  sizes="100vw"
                  alt="{{ featured_article.image.alt | default: featured_article.title }}"
                  class="blog-featured__image"
                  loading="eager"
                  fetchpriority="high"
                >
              </div>
            {% endif %}
            <div class="blog-featured__content">
              <div class="blog-featured__meta">
                {% if featured_article.tags.size > 0 %}<span class="blog-featured__tag">{{ featured_article.tags.first }}</span>{% endif %}
                <span class="blog-featured__date">{{ featured_article.published_at | date: "%b %-d, %Y" }}</span>
                <span class="blog-featured__read">{{ featured_read_mins }} min read</span>
              </div>
              <h2 class="blog-featured__title">{{ featured_article.title }}</h2>
              {% if featured_article.excerpt != blank %}
                <p class="blog-featured__excerpt">{{ featured_article.excerpt | strip_html | truncatewords: 35 }}</p>
              {% endif %}
              <span class="blog-featured__cta">Read article</span>
            </div>
          </a>
        </article>

        {% if blog.articles_count > 1 %}
          <div class="blog-grid" aria-label="More articles">
            {% for article in blog.articles offset: 1 %}
              {% assign card_word_count = article.content | strip_html | split: ' ' | size %}
              {% assign card_read_mins = card_word_count | divided_by: 200 | at_least: 1 %}
              <article class="blog-card">
                <a href="{{ article.url }}" class="blog-card__link">
                  {% if article.image %}
                    <div class="blog-card__media">
                      <img
                        src="{{ article.image | image_url: width: 800 }}"
                        srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 800 }} 800w"
                        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                        alt="{{ article.image.alt | default: article.title }}"
                        class="blog-card__image"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}
                  <div class="blog-card__body">
                    <div class="blog-card__meta">
                      {% if article.tags.size > 0 %}<span class="blog-card__tag">{{ article.tags.first }}</span>{% endif %}
                      <span>{{ article.published_at | date: "%b %-d, %Y" }}</span>
                      <span>{{ card_read_mins }} min read</span>
                    </div>
                    <h2 class="blog-card__title">{{ article.title }}</h2>
                    {% if article.excerpt != blank %}
                      <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncatewords: 22 }}</p>
                    {% endif %}
                    <span class="blog-card__cta">Read more</span>
                  </div>
                </a>
              </article>
            {% endfor %}
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav class="blog-page__pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
        {% endif %}
      {% else %}
        <div class="blog-empty">
          <p>No articles yet. Check back soon.</p>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% stylesheet %}
  .blog-page {
    padding: 48px 0 80px;
    background: #fafafa;
  }
  .blog-page__inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--container-padding);
    box-sizing: border-box;
  }
  .blog-page__header {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 20px;
  }
  .blog-page__breadcrumbs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 16px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(76, 85, 100, 0.7);
  }
  .blog-page__breadcrumb-link {
    color: inherit;
    text-decoration: none;
  }
  .blog-page__breadcrumb-link:hover { color: #15736d; }
  .blog-page__breadcrumb-sep { opacity: 0.5; }
  .blog-page__title {
    margin: 0 0 12px 0;
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 48px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text);
  }
  .blog-page__subtitle {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(76, 85, 100, 0.85);
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .blog-page__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 48px;
  }
  .blog-filter-chip {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid rgba(76, 85, 100, 0.15);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .blog-filter-chip:hover {
    border-color: rgba(21, 115, 109, 0.35);
    color: #15736d;
  }
  .blog-filter-chip--active {
    background: #15736d;
    border-color: #15736d;
    color: #fff;
  }

  /* Featured: full-width hero-style block */
  .blog-featured {
    margin-bottom: 56px;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .blog-featured__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .blog-featured__media {
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }
  .blog-featured__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-featured__link:hover .blog-featured__image {
    transform: scale(1.03);
  }
  .blog-featured__content {
    padding: 36px 40px 40px;
    max-width: 720px;
  }
  .blog-featured__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-bottom: 12px;
    font-size: 13px;
    color: rgba(76, 85, 100, 0.8);
  }
  .blog-featured__tag {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: #15736d;
  }
  .blog-featured__title {
    margin: 0 0 12px 0;
    font-family: var(--font-heading);
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--text);
  }
  .blog-featured__excerpt {
    margin: 0 0 16px 0;
    font-size: 17px;
    line-height: 1.65;
    color: rgba(76, 85, 100, 0.9);
  }
  .blog-featured__cta {
    font-size: 14px;
    font-weight: 600;
    color: #15736d;
    letter-spacing: 0.02em;
  }

  /* Cards grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .blog-card {
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .blog-card:hover {
    box-shadow: 0 12px 40px rgba(0,0,0,0.1);
    transform: translateY(-2px);
  }
  .blog-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .blog-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-card__link:hover .blog-card__image {
    transform: scale(1.05);
  }
  .blog-card__body {
    padding: 28px 24px 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-bottom: 10px;
    font-size: 12px;
    color: rgba(76, 85, 100, 0.75);
    letter-spacing: 0.02em;
  }
  .blog-card__tag {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: #15736d;
  }
  .blog-card__title {
    margin: 0 0 10px 0;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text);
  }
  .blog-card__excerpt {
    margin: 0 0 16px 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(76, 85, 100, 0.88);
    flex: 1;
  }
  .blog-card__cta {
    font-size: 14px;
    font-weight: 600;
    color: #15736d;
    letter-spacing: 0.02em;
  }

  .blog-page__pagination {
    margin-top: 56px;
    text-align: center;
  }
  .blog-empty {
    text-align: center;
    padding: 60px 20px;
    color: rgba(76, 85, 100, 0.8);
  }

  @media (max-width: 1024px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .blog-featured__content { padding: 28px 28px 32px; }
  }
  @media (max-width: 768px) {
    .blog-page { padding: 32px 0 56px; }
    .blog-page__header { margin-bottom: 32px; }
    .blog-page__filters { margin-bottom: 32px; }
    .blog-featured { margin-bottom: 40px; }
    .blog-featured__media { aspect-ratio: 16 / 10; }
    .blog-featured__content { padding: 24px 20px 28px; }
    .blog-grid { grid-template-columns: 1fr; gap: 24px; }
    .blog-card__body { padding: 22px 20px 24px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Knowledge"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Science-backed guides and routines to help you get the most out of Glamora skincare."
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 18,
      "step": 3,
      "default": 9
    }
  ]
}
{% endschema %}
