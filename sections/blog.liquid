{% comment %}
  Blog listing page (Knowledge)
  - Featured article + grid layout
  - Filter chips by tag (All / tags)
  - Matches beminimalist "Knowledge" structure
{% endcomment %}

<section class="blog-page" id="blog-page">
  <div class="blog-page__inner">
    <header class="blog-page__header">
      <nav class="blog-page__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}" class="blog-page__breadcrumb-link">Home</a>
        <span class="blog-page__breadcrumb-separator">›</span>
        <span class="blog-page__breadcrumb-current">{{ section.settings.heading | default: blog.title }}</span>
      </nav>

      <h1 class="blog-page__title">
        {{ section.settings.heading | default: blog.title }}
      </h1>

      {% if section.settings.subtitle != blank %}
        <p class="blog-page__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </header>

    {%- assign all_tags = blog.all_tags -%}
    {% if all_tags and all_tags.size > 0 %}
      <div class="blog-page__filters" aria-label="Article categories">
        <a
          href="{{ blog.url }}"
          class="blog-filter-chip{% if current_tags == blank %} blog-filter-chip--active{% endif %}"
        >
          All
        </a>
        {% for tag in all_tags %}
          <a
            href="{{ blog.url }}/tagged/{{ tag | handle }}"
            class="blog-filter-chip{% if current_tags contains tag %} blog-filter-chip--active{% endif %}"
          >
            {{ tag }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% paginate blog.articles by section.settings.articles_per_page %}
      {% if blog.articles_count > 0 %}
        {% assign featured_article = blog.articles.first %}
        <article class="blog-featured" aria-label="Featured article">
          {% if featured_article.image %}
            <a href="{{ featured_article.url }}" class="blog-featured__image-link">
              <img
                src="{{ featured_article.image | image_url: width: 1200 }}"
                srcset="
                  {{ featured_article.image | image_url: width: 480 }} 480w,
                  {{ featured_article.image | image_url: width: 768 }} 768w,
                  {{ featured_article.image | image_url: width: 1024 }} 1024w,
                  {{ featured_article.image | image_url: width: 1400 }} 1400w
                "
                sizes="(max-width: 768px) 100vw, 60vw"
                alt="{{ featured_article.image.alt | default: featured_article.title }}"
                class="blog-featured__image"
                loading="lazy"
              >
            </a>
          {% endif %}
          <div class="blog-featured__content">
            <div class="blog-featured__meta">
              {% assign date = featured_article.published_at | date: "%b %-d, %Y" %}
              <span class="blog-meta">{{ date }}</span>
              {% if featured_article.reading_time %}
                <span class="blog-meta-dot">•</span>
                <span class="blog-meta">{{ featured_article.reading_time }} min read</span>
              {% endif %}
            </div>
            <h2 class="blog-featured__title">
              <a href="{{ featured_article.url }}">{{ featured_article.title }}</a>
            </h2>
            {% if featured_article.excerpt != blank %}
              <p class="blog-featured__excerpt">
                {{ featured_article.excerpt | strip_html | truncatewords: 30 }}
              </p>
            {% endif %}
            <a href="{{ featured_article.url }}" class="blog-featured__read-more">
              Read more
            </a>
          </div>
        </article>

        {% if blog.articles_count > 1 %}
          <div class="blog-grid" aria-label="More articles">
            {% for article in blog.articles offset: 1 %}
              <article class="blog-card">
                {% if article.image %}
                  <a href="{{ article.url }}" class="blog-card__image-link">
                    <img
                      src="{{ article.image | image_url: width: 600 }}"
                      srcset="
                        {{ article.image | image_url: width: 360 }} 360w,
                        {{ article.image | image_url: width: 600 }} 600w,
                        {{ article.image | image_url: width: 800 }} 800w
                      "
                      sizes="(max-width: 768px) 100vw, 33vw"
                      alt="{{ article.image.alt | default: article.title }}"
                      class="blog-card__image"
                      loading="lazy"
                    >
                  </a>
                {% endif %}
                <div class="blog-card__body">
                  <div class="blog-card__meta">
                    {% assign date = article.published_at | date: "%b %-d, %Y" %}
                    <span class="blog-meta">{{ date }}</span>
                  </div>
                  <h2 class="blog-card__title">
                    <a href="{{ article.url }}">{{ article.title }}</a>
                  </h2>
                  {% if article.excerpt != blank %}
                    <p class="blog-card__excerpt">
                      {{ article.excerpt | strip_html | truncatewords: 20 }}
                    </p>
                  {% endif %}
                  <a href="{{ article.url }}" class="blog-card__read-link">
                    Read →
                  </a>
                </div>
              </article>
            {% endfor %}
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          <div class="blog-page__pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% else %}
        <div class="blog-empty">
          <p>No articles found.</p>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% stylesheet %}
  .blog-page {
    padding: 56px 0 80px 0;
  }
  .blog-page__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--container-padding);
    box-sizing: border-box;
  }
  .blog-page__header {
    margin-bottom: 28px;
  }
  .blog-page__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    font-size: 13px;
    color: rgba(76, 85, 100, 0.9);
  }
  .blog-page__breadcrumb-link {
    color: inherit;
    text-decoration: none;
  }
  .blog-page__breadcrumb-link:hover {
    text-decoration: underline;
  }
  .blog-page__title {
    margin: 0 0 8px 0;
    font-size: 30px;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .blog-page__subtitle {
    margin: 0;
    font-size: 15px;
    color: rgba(76, 85, 100, 0.95);
    max-width: 640px;
  }

  .blog-page__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0 28px 0;
  }
  .blog-filter-chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(76, 85, 100, 0.2);
    background: #fff;
    font-size: 12px;
    text-decoration: none;
    color: rgba(76, 85, 100, 0.95);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .blog-filter-chip--active {
    background: rgba(21, 115, 109, 0.12);
    border-color: rgba(21, 115, 109, 0.4);
    color: #15736d;
  }

  .blog-featured {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }
  .blog-featured__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 18px;
  }
  .blog-featured__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .blog-featured__meta {
    font-size: 13px;
    color: rgba(76, 85, 100, 0.9);
    margin-bottom: 6px;
  }
  .blog-featured__title {
    margin: 0 0 8px 0;
    font-size: 22px;
  }
  .blog-featured__title a {
    text-decoration: none;
    color: var(--text);
  }
  .blog-featured__excerpt {
    margin: 0 0 10px 0;
    font-size: 15px;
    color: rgba(76, 85, 100, 0.95);
    line-height: 1.7;
  }
  .blog-featured__read-more {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: #15736d;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  .blog-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
  }
  .blog-card__image {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .blog-card__body {
    padding: 14px 14px 16px 14px;
  }
  .blog-card__meta {
    font-size: 12px;
    color: rgba(76, 85, 100, 0.85);
    margin-bottom: 4px;
  }
  .blog-card__title {
    margin: 0 0 6px 0;
    font-size: 16px;
  }
  .blog-card__title a {
    text-decoration: none;
    color: var(--text);
  }
  .blog-card__excerpt {
    margin: 0 0 8px 0;
    font-size: 14px;
    color: rgba(76, 85, 100, 0.95);
  }
  .blog-card__read-link {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: #15736d;
  }

  .blog-page__pagination {
    margin-top: 32px;
    text-align: center;
  }

  @media (max-width: 990px) {
    .blog-featured {
      grid-template-columns: 1fr;
    }
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 768px) {
    .blog-page {
      padding: 40px 0 56px 0;
    }
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Knowledge"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Science-backed guides and routines to help you get the most out of Glamora skincare."
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 18,
      "step": 3,
      "default": 9
    }
  ]
}
{% endschema %}
