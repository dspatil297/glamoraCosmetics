  <div class="hpd-hero"><div class="hpd-wrap"><div class="hpd-hero-grid"><div><span class="hpd-eyebrow">{{ section.settings.hero_eyebrow }}</span><h1>{{ section.settings.hero_title }} <span>{{ section.settings.hero_title_highlight }}</span></h1><p class="hpd-sub">{{ section.settings.hero_subtext }}</p><div class="hpd-ctas"><a class="hpd-btn primary" href="{{ section.settings.hero_primary_link }}">{{ section.settings.hero_primary_text }}</a><a class="hpd-btn outline" href="{{ section.settings.hero_secondary_link }}">{{ section.settings.hero_secondary_text }}</a></div></div><div class="hpd-display"><div class="hpd-display-shape"></div><div class="hpd-products">{% if section.settings.hero_product_1 != blank %}<img width="520" height="640" src="{{ section.settings.hero_product_1 | image_url: width: 520 }}" alt="Hero product 1">{% endif %}{% if section.settings.hero_product_2 != blank %}<img width="520" height="640" src="{{ section.settings.hero_product_2 | image_url: width: 520 }}" alt="Hero product 2">{% endif %}{% if section.settings.hero_product_3 != blank %}<img width="520" height="640" src="{{ section.settings.hero_product_3 | image_url: width: 520 }}" alt="Hero product 3">{% endif %}</div></div></div></div></div>
  <div class="hpd-trust"><div class="hpd-wrap"><div class="hpd-trust-track">{% for block in section.blocks %}{% if block.type == 'trust_item' %}<span class="hpd-trust-item">{{ block.settings.text }}</span><span class="hpd-trust-dot"></span>{% endif %}{% endfor %}{% for block in section.blocks %}{% if block.type == 'trust_item' %}<span class="hpd-trust-item">{{ block.settings.text }}</span><span class="hpd-trust-dot"></span>{% endif %}{% endfor %}</div></div></div>
  <div class="hpd-section" id="routine"><div class="hpd-wrap"><div class="hpd-head"><span class="hpd-eyebrow">{{ section.settings.routine_eyebrow }}</span><h2>{{ section.settings.routine_title }}</h2><p>{{ section.settings.routine_subtitle }}</p></div><div class="hpd-routine">{% assign step_count = 0 %}{% for block in section.blocks %}{% if block.type == 'routine_step' %}{% assign step_count = step_count | plus: 1 %}<div class="hpd-row {% if block.settings.reverse %}reverse{% endif %}" {{ block.shopify_attributes }}><div class="img"><div class="hpd-img-shell"><div class="hpd-img-core">{% if block.settings.image != blank %}<img width="900" height="1125" src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}">{% endif %}</div></div></div><div class="txt"><div class="hpd-step">{{ step_count }}</div><p class="hpd-card-type">{{ block.settings.label }}</p><h3>{{ block.settings.title }}</h3><p class="hpd-tag">{{ block.settings.tagline }}</p><p class="hpd-desc">{{ block.settings.description }}</p><p class="hpd-price">{{ block.settings.price }}{% if block.settings.old_price != blank %}<span class="hpd-old">{{ block.settings.old_price }}</span>{% endif %}</p><a class="hpd-btn outline" href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a></div></div>{% endif %}{% endfor %}</div><div class="hpd-bundle"><h3>{{ section.settings.bundle_title }}</h3><p>{{ section.settings.bundle_subtitle }}</p><a class="hpd-btn primary" href="{{ section.settings.bundle_link }}">{{ section.settings.bundle_text }}</a></div></div></div>
  <div class="hpd-section hpd-stats" id="stats"><div class="hpd-wrap"><div class="hpd-head"><span class="hpd-eyebrow">{{ section.settings.stats_eyebrow }}</span><h2>{{ section.settings.stats_title }}</h2><p>{{ section.settings.stats_subtitle }}</p></div><div class="hpd-grid">{% for block in section.blocks %}{% if block.type == 'stat_card' %}<div class="hpd-stat {% if block.settings.featured %}big{% endif %}" {{ block.shopify_attributes }}><div class="num">{{ block.settings.number }}</div><p>{{ block.settings.description }}</p></div>{% endif %}{% endfor %}</div><div class="hpd-exp">{% for block in section.blocks %}{% if block.type == 'explainer_item' %}<div {{ block.shopify_attributes }}><h4>{{ block.settings.title }}</h4><p>{{ block.settings.description }}</p></div>{% endif %}{% endfor %}</div></div></div>
  <div class="hpd-section" id="sellers"><div class="hpd-wrap"><div class="hpd-head"><span class="hpd-eyebrow">{{ section.settings.products_eyebrow }}</span><h2>{{ section.settings.products_title }}</h2><p>{{ section.settings.products_subtitle }}</p></div><div class="hpd-sellers">{% for block in section.blocks %}{% if block.type == 'product_card' %}<article class="hpd-card" {{ block.shopify_attributes }}><div class="hpd-card-core"><div class="hpd-card-img">{% if block.settings.image != blank %}<img width="800" height="1067" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}">{% endif %}<a class="hpd-qa" href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a></div><div class="hpd-card-body"><p class="hpd-card-type">{{ block.settings.type }}</p><h3 class="hpd-card-title">{{ block.settings.title }}</h3><p class="hpd-price">{{ block.settings.price }}{% if block.settings.old_price != blank %}<span class="hpd-old">{{ block.settings.old_price }}</span>{% endif %}</p></div></div></article>{% endif %}{% endfor %}</div></div></div>
  <div class="hpd-section" id="ingredients"><div class="hpd-wrap"><div class="hpd-head"><span class="hpd-eyebrow">{{ section.settings.ingredients_eyebrow }}</span><h2>{{ section.settings.ingredients_title }}</h2><p>{{ section.settings.ingredients_subtitle }}</p></div><div class="hpd-ingredients">{% for block in section.blocks %}{% if block.type == 'ingredient' %}<div class="hpd-ing" {{ block.shopify_attributes }}><span class="hpd-ing-sym">{{ block.settings.symbol }}</span><div><h4>{{ block.settings.title }}</h4><p>{{ block.settings.description }}</p></div></div>{% endif %}{% endfor %}</div></div></div>
  <div class="hpd-section hpd-test"><div class="hpd-wrap"><div class="hpd-test-inner"><div class="hpd-test-quote" id="{{ section_id }}-quote"></div><div class="hpd-test-author" id="{{ section_id }}-author"></div><div class="hpd-test-loc" id="{{ section_id }}-loc"></div></div></div></div>
  <div class="hpd-news" id="newsletter"><div class="hpd-wrap"><div class="hpd-news-inner"><span class="hpd-eyebrow">{{ section.settings.news_eyebrow }}</span><h2>{{ section.settings.news_title }}</h2><p>{{ section.settings.news_subtitle }}</p>{%- form 'customer', class: 'hpd-news-form' -%}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="{{ section.settings.news_placeholder }}" required><button type="submit">{{ section.settings.news_button }}</button>{%- endform -%}</div></div></div>
  <script>(function(){const reviews=[{% for block in section.blocks %}{% if block.type=='testimonial' %}{text:{{ block.settings.quote|json }},author:{{ block.settings.author|json }},location:{{ block.settings.location|json }}},{% endif %}{% endfor %}].filter(Boolean);const quote=document.getElementById('{{ section_id }}-quote');const author=document.getElementById('{{ section_id }}-author');const loc=document.getElementById('{{ section_id }}-loc');if(!quote||reviews.length===0)return;let i=0;function paint(idx){quote.textContent=reviews[idx].text||'';author.textContent=reviews[idx].author||'';loc.textContent=reviews[idx].location||'';}paint(i);if(reviews.length>1){setInterval(function(){i=(i+1)%reviews.length;paint(i);},6000);}})();</script>
</section>
