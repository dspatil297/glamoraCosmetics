{%- liquid
  assign section_id = 'hpd-' | append: section.id
  assign hero_product_1 = section.settings.hero_product_1
  assign hero_product_2 = section.settings.hero_product_2
  assign hero_product_3 = section.settings.hero_product_3
  assign hero_img_1 = blank
  assign hero_img_2 = blank
  assign hero_img_3 = blank
  assign hero_alt_1 = 'Pollution Control Face Wash'
  assign hero_alt_2 = 'Pollution Control Moisturizing Spray'
  assign hero_alt_3 = 'Pollution Control Hybrid Sunscreen'
  assign hero_fallback_1 = 'https://cdn.shopify.com/s/files/1/0657/8651/1422/files/facewash1.webp?v=1775141692'
  assign hero_fallback_2 = 'https://cdn.shopify.com/s/files/1/0657/8651/1422/files/WhatsAppImage2026-03-14at12.28.49PM.webp?v=1775141371'
  assign hero_fallback_3 = 'https://cdn.shopify.com/s/files/1/0657/8651/1422/files/ofetmglqptowmhrk2agf.webp?v=1775141307'

  if hero_product_1 and hero_product_1.featured_image
    assign hero_img_1 = hero_product_1.featured_image
    assign hero_alt_1 = hero_product_1.title
  endif
  if hero_product_2 and hero_product_2.featured_image
    assign hero_img_2 = hero_product_2.featured_image
    assign hero_alt_2 = hero_product_2.title
  endif
  if hero_product_3 and hero_product_3.featured_image
    assign hero_img_3 = hero_product_3.featured_image
    assign hero_alt_3 = hero_product_3.title
  endif

  if hero_img_1 == blank or hero_img_2 == blank or hero_img_3 == blank
    assign routine_index = 0
    for block in section.blocks
      if block.type == 'routine_step'
        if block.settings.product and block.settings.product.featured_image
          assign routine_image = block.settings.product.featured_image
          assign routine_alt = block.settings.product.title
        else
          assign routine_image = blank
          assign routine_alt = block.settings.title
        endif
        if block.settings.image != blank
          assign routine_image = block.settings.image
          assign routine_alt = block.settings.title
        endif
        if routine_image != blank
          assign routine_index = routine_index | plus: 1
          if hero_img_1 == blank and routine_index == 1
            assign hero_img_1 = routine_image
            assign hero_alt_1 = routine_alt
          elsif hero_img_2 == blank and routine_index == 2
            assign hero_img_2 = routine_image
            assign hero_alt_2 = routine_alt
          elsif hero_img_3 == blank and routine_index == 3
            assign hero_img_3 = routine_image
            assign hero_alt_3 = routine_alt
          endif
        endif
      endif
    endfor
  endif
-%}

<section id="{{ section_id }}" class="hpd-home">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&display=swap');
    #{{ section_id }} {
      --bg: #FAFAF7;
      --bg-alt: #F3F1ED;
      --bg-dark: #141413;
      --text: #141413;
      --text-2: #5C5B57;
      --text-3: #8A8985;
      --teal: #0D8B7D;
      --teal-bg: #EBF5F3;
      --gold: #C5A44E;
      --border: #E8E6E1;
      --border-light: #F0EDE8;
      --font-body: 'Outfit', -apple-system, sans-serif;
      --font-display: 'Fraunces', Georgia, serif;
      --section-gap: clamp(80px, 10vw, 128px);
      --container: 1360px;
      font-family: var(--font-body);
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
    }
    #{{ section_id }} * { box-sizing: border-box; }
    #{{ section_id }} img { max-width: 100%; height: auto; display: block; }
    #{{ section_id }} a { color: inherit; text-decoration: none; }
    #{{ section_id }} .container { max-width: var(--container); margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
    #{{ section_id }} .section { padding: var(--section-gap) 0; }
    #{{ section_id }} .section-header { margin-bottom: clamp(40px, 5vw, 64px); max-width: 560px; }
    #{{ section_id }} .section-header h2 {
      font-family: var(--font-display);
      font-size: clamp(32px, 4vw, 52px);
      line-height: 1.1;
      letter-spacing: -0.025em;
      margin: 0 0 20px;
    }
    #{{ section_id }} .section-header p { font-size: clamp(17px, 1.8vw, 20px); line-height: 1.7; color: var(--text-2); margin: 0; font-weight: 300; }
    #{{ section_id }} .eyebrow {
      display: inline-block; padding: 7px 18px; border-radius: 100px; font-size: 12px; font-weight: 600; letter-spacing: 0.14em;
      text-transform: uppercase; margin-bottom: 20px; background: var(--teal-bg); color: var(--teal);
    }
    #{{ section_id }} .btn { display: inline-flex; align-items: center; gap: 10px; padding: 16px 32px; border-radius: 100px; font-size: 15px; font-weight: 600; letter-spacing: 0.02em; }
    #{{ section_id }} .btn-primary { background: var(--teal); color: #fff; }
    #{{ section_id }} .btn-outline { background: transparent; color: var(--text); border: 1.5px solid var(--border); }

    #{{ section_id }} .hero { padding: clamp(60px, 8vw, 120px) 0 clamp(80px, 10vw, 140px); }
    #{{ section_id }} .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(40px, 6vw, 80px); align-items: center; }
    #{{ section_id }} .hero h1 {
      font-family: var(--font-display); font-size: clamp(40px, 5.5vw, 72px); font-weight: 600; line-height: 1.05;
      letter-spacing: -0.03em; margin: 0 0 24px;
    }
    #{{ section_id }} .hero h1 span { color: var(--teal); }
    #{{ section_id }} .hero-sub {
      font-size: clamp(18px, 2vw, 21px); line-height: 1.7; color: var(--text-2); margin: 0 0 40px; font-weight: 300; max-width: 52ch;
    }
    #{{ section_id }} .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }
    #{{ section_id }} .hero-display { position: relative; display: flex; justify-content: center; align-items: center; padding: 48px 24px; min-height: 420px; }
    #{{ section_id }} .hero-display-shape {
      position: absolute; width: 88%; height: 92%; background: linear-gradient(160deg, rgba(13,139,125,0.07), rgba(13,139,125,0.03));
      border: 1px solid rgba(13,139,125,0.06); border-radius: 2.5rem; transform: rotate(-2deg);
    }
    #{{ section_id }} .hero-products { position: relative; z-index: 2; display: flex; align-items: flex-end; gap: clamp(12px, 2vw, 24px); }
    #{{ section_id }} .hero-products img { width: clamp(90px, 10vw, 130px); border-radius: 12px; filter: drop-shadow(0 24px 48px rgba(13,139,125,0.12)); }
    #{{ section_id }} .hero-products img:nth-child(2) { width: clamp(100px, 12vw, 150px); transform: translateY(-16px); }

    #{{ section_id }} .trust {
      padding: 20px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); overflow: hidden; position: relative;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
    }
    #{{ section_id }} .trust-track { display: flex; animation: hpd-marquee 28s linear infinite; width: max-content; }
    #{{ section_id }} .trust-track:hover { animation-play-state: paused; }
    #{{ section_id }} .trust-list { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; gap: 0; flex-shrink: 0; }
    #{{ section_id }} .trust-item {
      display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; color: var(--text-2); padding: 0 32px; white-space: nowrap;
    }
    #{{ section_id }} .trust-item svg { color: var(--teal); flex-shrink: 0; }
    #{{ section_id }} .trust-sep { width: 4px; height: 4px; border-radius: 50%; background: var(--border); flex-shrink: 0; }
    @keyframes hpd-marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    #{{ section_id }} .routine-rows { display: flex; flex-direction: column; gap: clamp(64px, 8vw, 100px); }
    #{{ section_id }} .routine-row { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(40px, 6vw, 80px); align-items: center; }
    #{{ section_id }} .routine-row.reverse { grid-template-columns: 0.85fr 1.15fr; }
    #{{ section_id }} .routine-row.reverse .img { order: 2; }
    #{{ section_id }} .routine-row.reverse .txt { order: 1; }
    #{{ section_id }} .routine-image-shell {
      background: rgba(13, 139, 125, 0.035); border: 1px solid rgba(13, 139, 125, 0.06); padding: 8px; border-radius: 2rem; max-width: 440px; margin: 0 auto;
    }
    #{{ section_id }} .routine-image-core { border-radius: calc(2rem - 8px); overflow: hidden; aspect-ratio: 4 / 5; background: var(--bg-alt); }
    #{{ section_id }} .routine-image-core img { width: 100%; height: 100%; object-fit: cover; }
    #{{ section_id }} .routine-step {
      width: 48px; height: 48px; border-radius: 50%; background: var(--teal); color: #fff; display: grid; place-items: center;
      font-family: var(--font-display); font-size: 18px; font-weight: 600; margin-bottom: 20px;
    }
    #{{ section_id }} .routine-label { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal); margin: 0 0 12px; }
    #{{ section_id }} .routine-row h3 { font-family: var(--font-display); font-size: clamp(24px, 3vw, 36px); line-height: 1.15; margin: 0 0 12px; }
    #{{ section_id }} .routine-tagline { font-family: var(--font-display); font-style: italic; font-size: 18px; color: var(--text-2); margin: 0 0 16px; }
    #{{ section_id }} .routine-desc { font-size: 17px; line-height: 1.75; color: var(--text-2); margin: 0 0 24px; font-weight: 300; }
    #{{ section_id }} .routine-price { font-size: 22px; font-weight: 600; margin: 0 0 20px; }
    #{{ section_id }} .routine-price .old { font-size: 15px; font-weight: 400; color: var(--text-3); text-decoration: line-through; margin-left: 8px; }
    #{{ section_id }} .routine-bundle {
      text-align: center; margin-top: clamp(48px, 6vw, 80px); padding: clamp(40px, 5vw, 64px); background: var(--teal-bg); border: 1px solid rgba(13,139,125,0.08); border-radius: 2rem;
    }
    #{{ section_id }} .routine-bundle .title { font-family: var(--font-display); font-size: clamp(20px, 2.5vw, 28px); font-weight: 600; margin: 0 0 12px; }
    #{{ section_id }} .routine-bundle .sub { font-size: 15px; color: var(--text-2); margin: 0 0 24px; }

    #{{ section_id }} .stats { background: #0A1A18; color: #fff; }
    #{{ section_id }} .stats .section-header h2 { color: #fff; }
    #{{ section_id }} .stats .section-header p { color: rgba(255,255,255,0.55); }
    #{{ section_id }} .stats-grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 24px; }
    #{{ section_id }} .stat-card { padding: clamp(32px, 4vw, 48px); border-radius: 1.5rem; background: rgba(255,255,255,0.035); border: 1px solid rgba(255,255,255,0.06); }
    #{{ section_id }} .stat-card.featured { grid-row: span 2; display: flex; flex-direction: column; justify-content: center; }
    #{{ section_id }} .stat-number { font-family: var(--font-display); font-size: clamp(48px, 6vw, 80px); line-height: 1; color: var(--gold); margin-bottom: 16px; }
    #{{ section_id }} .stat-label { font-size: 17px; line-height: 1.6; color: rgba(255,255,255,0.6); margin: 0; font-weight: 300; }
    #{{ section_id }} .stats-explainer { margin-top: clamp(48px, 6vw, 80px); display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; }
    #{{ section_id }} .stats-explainer h4 { margin: 0 0 10px; font-size: 17px; color: #fff; }
    #{{ section_id }} .stats-explainer p { margin: 0; font-size: 16px; line-height: 1.65; color: rgba(255,255,255,0.45); font-weight: 300; }

    #{{ section_id }} .sellers-grid { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 4px; }
    #{{ section_id }} .product-shell {
      flex: 0 0 auto; width: calc(100vw - 80px); max-width: 360px; scroll-snap-align: start; background: rgba(0,0,0,0.015);
      border: 1px solid var(--border-light); padding: 6px; border-radius: 1.75rem;
    }
    #{{ section_id }} .product-core { background: var(--bg); border-radius: calc(1.75rem - 6px); overflow: hidden; }
    #{{ section_id }} .product-image { aspect-ratio: 3 / 4; background: var(--bg-alt); position: relative; }
    #{{ section_id }} .product-image img { width: 100%; height: 100%; object-fit: cover; }
    #{{ section_id }} .product-quick-add {
      position: absolute; bottom: 16px; left: 16px; right: 16px; padding: 14px; background: var(--bg-dark); color: #fff;
      border-radius: 12px; font-size: 13px; font-weight: 600; text-align: center;
    }
    #{{ section_id }} .product-details { padding: 20px 20px 24px; }
    #{{ section_id }} .product-type { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); margin: 0 0 6px; }
    #{{ section_id }} .product-name { font-family: var(--font-display); font-size: 20px; font-weight: 600; line-height: 1.3; margin: 0 0 12px; }

    #{{ section_id }} .ingredients-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    #{{ section_id }} .ingredient-card { display: flex; align-items: flex-start; gap: 16px; padding: 24px; border-radius: 1rem; border: 1px solid var(--border-light); background: var(--bg); }
    #{{ section_id }} .ingredient-symbol {
      width: 44px; height: 44px; border-radius: 12px; background: var(--teal-bg); color: var(--teal); display: grid; place-items: center;
      font-size: 14px; font-weight: 700; letter-spacing: -0.02em; flex-shrink: 0;
    }
    #{{ section_id }} .ingredient-info h4 { font-size: 17px; font-weight: 600; margin: 0 0 6px; }
    #{{ section_id }} .ingredient-info p { font-size: 15px; line-height: 1.6; color: var(--text-2); font-weight: 300; margin: 0; }

    #{{ section_id }} .testimonial { background: var(--bg-alt); }
    #{{ section_id }} .testimonial-inner { max-width: 780px; margin: 0 auto; text-align: center; }
    #{{ section_id }} .testimonial-text {
      font-family: var(--font-display); font-size: clamp(24px, 3.2vw, 36px); font-weight: 400; line-height: 1.5; letter-spacing: -0.015em;
      margin: 0 0 20px; font-style: italic;
    }
    #{{ section_id }} .testimonial-author { font-size: 17px; font-weight: 600; margin: 0; }
    #{{ section_id }} .testimonial-location { font-size: 15px; color: var(--text-3); font-weight: 300; margin: 4px 0 0; }

    #{{ section_id }} .newsletter {
      background: var(--bg-alt); padding: clamp(80px, 10vw, 120px) 0; margin: clamp(40px, 8vw, 80px) 0;
    }
    #{{ section_id }} .newsletter-inner { max-width: 560px; margin: 0 auto; text-align: center; }
    #{{ section_id }} .newsletter-inner h2 {
      font-family: var(--font-display); font-size: clamp(28px, 3.5vw, 42px); font-weight: 600; line-height: 1.15; letter-spacing: -0.025em; margin: 0 0 12px;
    }
    #{{ section_id }} .newsletter-inner p { font-size: 16px; color: var(--text-2); font-weight: 300; line-height: 1.7; margin: 0; }
    #{{ section_id }} .newsletter-form {
      display: flex; gap: 8px; margin-top: 40px; background: rgba(255,255,255,0.6); border: 1px solid rgba(255,255,255,0.8);
      border-radius: 100px; padding: 8px;
    }
    #{{ section_id }} .newsletter-input {
      flex: 1; padding: 16px 24px 16px 32px; border: 0; background: transparent; font-family: var(--font-body); font-size: 15px; color: var(--text); outline: none;
    }
    #{{ section_id }} .newsletter-submit {
      padding: 16px 32px; background: var(--teal); color: #fff; border-radius: 100px; border: 0; font-size: 15px; font-weight: 600;
    }

    @media (max-width: 768px) {
      #{{ section_id }} .hero-grid,
      #{{ section_id }} .routine-row,
      #{{ section_id }} .routine-row.reverse,
      #{{ section_id }} .stats-grid,
      #{{ section_id }} .stats-explainer,
      #{{ section_id }} .ingredients-grid { grid-template-columns: 1fr; }
      #{{ section_id }} .stat-card.featured { grid-row: span 1; }
      #{{ section_id }} .routine-row.reverse .img { order: 2; }
      #{{ section_id }} .routine-row.reverse .txt { order: 1; }
      #{{ section_id }} .newsletter-form { flex-direction: column; border-radius: 1rem; }
      #{{ section_id }} .newsletter-submit { border-radius: 0.75rem; }
    }
  </style>

  <div class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">{{ section.settings.hero_eyebrow }}</span>
          <h1>{{ section.settings.hero_title }}<br><span>{{ section.settings.hero_title_highlight }}</span></h1>
          <p class="hero-sub">{{ section.settings.hero_subtext }}</p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="{{ section.settings.hero_primary_link }}">{{ section.settings.hero_primary_text }}</a>
            <a class="btn btn-outline" href="{{ section.settings.hero_secondary_link }}">{{ section.settings.hero_secondary_text }}</a>
          </div>
        </div>
        <div class="hero-display">
          <div class="hero-display-shape"></div>
          <div class="hero-products">
            {% if hero_img_1 != blank %}
              <img class="hero-prod" width="520" height="640" src="{{ hero_img_1 | image_url: width: 520 }}" alt="{{ hero_alt_1 | escape }}">
            {% else %}
              <img class="hero-prod" width="520" height="640" src="{{ hero_fallback_1 }}" alt="{{ hero_alt_1 | escape }}">
            {% endif %}
            {% if hero_img_2 != blank %}
              <img class="hero-prod" width="520" height="640" src="{{ hero_img_2 | image_url: width: 520 }}" alt="{{ hero_alt_2 | escape }}">
            {% else %}
              <img class="hero-prod" width="520" height="640" src="{{ hero_fallback_2 }}" alt="{{ hero_alt_2 | escape }}">
            {% endif %}
            {% if hero_img_3 != blank %}
              <img class="hero-prod" width="520" height="640" src="{{ hero_img_3 | image_url: width: 520 }}" alt="{{ hero_alt_3 | escape }}">
            {% else %}
              <img class="hero-prod" width="520" height="640" src="{{ hero_fallback_3 }}" alt="{{ hero_alt_3 | escape }}">
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="trust">
    <div class="container">
      <div class="trust-track">
        <ul class="trust-list">
          {% for block in section.blocks %}
            {% if block.type == 'trust_item' %}
              <li class="trust-item">
                {% assign trust_icon = forloop.index0 | modulo: 7 %}
                {% case trust_icon %}
                  {% when 0 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>
                  {% when 1 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {% when 2 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 000-7.78z"/></svg>
                  {% when 3 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                  {% when 4 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {% when 5 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {% else %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                {% endcase %}
                {{ block.settings.text }}
              </li>
              {% unless forloop.last %}<li class="trust-sep"></li>{% endunless %}
            {% endif %}
          {% endfor %}
        </ul>
        <ul class="trust-list" aria-hidden="true">
          {% for block in section.blocks %}
            {% if block.type == 'trust_item' %}
              <li class="trust-item">
                {% assign trust_icon = forloop.index0 | modulo: 7 %}
                {% case trust_icon %}
                  {% when 0 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>
                  {% when 1 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {% when 2 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 000-7.78z"/></svg>
                  {% when 3 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                  {% when 4 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {% when 5 %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {% else %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                {% endcase %}
                {{ block.settings.text }}
              </li>
              {% unless forloop.last %}<li class="trust-sep"></li>{% endunless %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>

  <div class="section" id="routine">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">{{ section.settings.routine_eyebrow }}</span>
        <h2>{{ section.settings.routine_title }}</h2>
        <p>{{ section.settings.routine_subtitle }}</p>
      </div>
      <div class="routine-rows">
        {% assign step_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'routine_step' %}
            {% assign step_count = step_count | plus: 1 %}
            {% if block.settings.product and block.settings.product.featured_image %}
              {% assign step_image = block.settings.product.featured_image %}
            {% else %}
              {% assign step_image = blank %}
            {% endif %}
            {% if block.settings.image != blank %}
              {% assign step_image = block.settings.image %}
            {% endif %}
            <div class="routine-row {% if block.settings.reverse %}reverse{% endif %}" {{ block.shopify_attributes }}>
              <div class="img">
                <div class="routine-image-shell"><div class="routine-image-core">
                  {% if step_image != blank %}<img width="900" height="1125" src="{{ step_image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}">{% endif %}
                </div></div>
              </div>
              <div class="txt">
                <div class="routine-step">{{ step_count }}</div>
                <p class="routine-label">{{ block.settings.label }}</p>
                <h3>{{ block.settings.title }}</h3>
                <p class="routine-tagline">{{ block.settings.tagline }}</p>
                <p class="routine-desc">{{ block.settings.description }}</p>
                <p class="routine-price">{{ block.settings.price }}{% if block.settings.old_price != blank %}<span class="old">{{ block.settings.old_price }}</span>{% endif %}</p>
                <a class="btn btn-outline" href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="routine-bundle">
        <p class="title">{{ section.settings.bundle_title }}</p>
        <p class="sub">{{ section.settings.bundle_subtitle }}</p>
        <a class="btn btn-primary" href="{{ section.settings.bundle_link }}">{{ section.settings.bundle_text }}</a>
      </div>
    </div>
  </div>

  <div class="section stats" id="stats">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">{{ section.settings.stats_eyebrow }}</span>
        <h2>{{ section.settings.stats_title }}</h2>
        <p>{{ section.settings.stats_subtitle }}</p>
      </div>
      <div class="stats-grid">
        {% for block in section.blocks %}{% if block.type == 'stat_card' %}
          <div class="stat-card {% if block.settings.featured %}featured{% endif %}" {{ block.shopify_attributes }}>
            <div class="stat-number">{{ block.settings.number }}</div><p class="stat-label">{{ block.settings.description }}</p>
          </div>
        {% endif %}{% endfor %}
      </div>
      <div class="stats-explainer">
        {% for block in section.blocks %}{% if block.type == 'explainer_item' %}
          <div {{ block.shopify_attributes }}><h4>{{ block.settings.title }}</h4><p>{{ block.settings.description }}</p></div>
        {% endif %}{% endfor %}
      </div>
    </div>
  </div>

  <div class="section" id="sellers">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">{{ section.settings.products_eyebrow }}</span>
        <h2>{{ section.settings.products_title }}</h2>
        <p>{{ section.settings.products_subtitle }}</p>
      </div>
      <div class="sellers-grid">
        {% for block in section.blocks %}
          {% if block.type == 'product_card' %}
            {% assign card_image = block.settings.image %}
            {% if block.settings.product and block.settings.product.featured_image %}
              {% assign card_image = block.settings.product.featured_image %}
            {% endif %}
            <article class="product-shell" {{ block.shopify_attributes }}>
              <div class="product-core">
                <div class="product-image">
                  {% if card_image != blank %}<img width="800" height="1067" src="{{ card_image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}">{% endif %}
                  <a class="product-quick-add" href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
                </div>
                <div class="product-details">
                  <p class="product-type">{{ block.settings.type }}</p>
                  <h3 class="product-name">{{ block.settings.title }}</h3>
                  <p class="routine-price">{{ block.settings.price }}{% if block.settings.old_price != blank %}<span class="old">{{ block.settings.old_price }}</span>{% endif %}</p>
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="section" id="ingredients">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">{{ section.settings.ingredients_eyebrow }}</span>
        <h2>{{ section.settings.ingredients_title }}</h2>
        <p>{{ section.settings.ingredients_subtitle }}</p>
      </div>
      <div class="ingredients-grid">
        {% for block in section.blocks %}{% if block.type == 'ingredient' %}
          <div class="ingredient-card" {{ block.shopify_attributes }}>
            <div class="ingredient-symbol">{{ block.settings.symbol }}</div>
            <div class="ingredient-info"><h4>{{ block.settings.title }}</h4><p>{{ block.settings.description }}</p></div>
          </div>
        {% endif %}{% endfor %}
      </div>
    </div>
  </div>

  <div class="section testimonial">
    <div class="container">
      <div class="testimonial-inner">
        <p class="testimonial-text" id="{{ section_id }}-quote"></p>
        <p class="testimonial-author" id="{{ section_id }}-author"></p>
        <p class="testimonial-location" id="{{ section_id }}-loc"></p>
      </div>
    </div>
  </div>

  <div class="newsletter" id="newsletter">
    <div class="container">
      <div class="newsletter-inner">
        <span class="eyebrow">{{ section.settings.news_eyebrow }}</span>
        <h2>{{ section.settings.news_title }}</h2>
        <p>{{ section.settings.news_subtitle }}</p>
        {%- form 'customer', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input class="newsletter-input" type="email" name="contact[email]" placeholder="{{ section.settings.news_placeholder }}" required>
          <button class="newsletter-submit" type="submit">{{ section.settings.news_button }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>

  <script>
    (function() {
      const reviews = [
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            { text: {{ block.settings.quote | json }}, author: {{ block.settings.author | json }}, location: {{ block.settings.location | json }} },
          {% endif %}
        {% endfor %}
      ].filter(Boolean);
      const quote = document.getElementById('{{ section_id }}-quote');
      const author = document.getElementById('{{ section_id }}-author');
      const loc = document.getElementById('{{ section_id }}-loc');
      if (!quote || reviews.length === 0) return;
      let i = 0;
      function paint(idx) {
        quote.textContent = reviews[idx].text || '';
        author.textContent = reviews[idx].author || '';
        loc.textContent = reviews[idx].location || '';
      }
      paint(i);
      if (reviews.length > 1) {
        setInterval(function() { i = (i + 1) % reviews.length; paint(i); }, 6000);
      }
    })();
  </script>
</section>
